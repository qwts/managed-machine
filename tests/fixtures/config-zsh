#!/usr/bin/env bash
# Apply starter zsh dotfiles from this config repo when missing.
set -euo pipefail

ROOT="${MANAGED_MACHINE_ROOT:?MANAGED_MACHINE_ROOT is required}"
# shellcheck source=/dev/null
source "$ROOT/lib/install.sh"
# shellcheck source=/dev/null
source "$ROOT/lib/bootstrap.sh"

CONFIG_REPO_ROOT="${CONFIG_REPO_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
DOTFILES_SRC="$CONFIG_REPO_ROOT/dotfiles/zsh"
MANIFEST="$(managed_machine_config_dir)/zsh.manifest"

files=(.zshenv .zprofile .zshrc)
for name in "${files[@]}"; do
    install_home_file \
        "$DOTFILES_SRC/$name" \
        "$HOME/$name" \
        "$MANIFEST" \
        "$name"
done

echo "Zsh dotfiles setup complete."
