#!/usr/bin/env bash
set -euo pipefail
ROOT="${MANAGED_MACHINE_ROOT:?MANAGED_MACHINE_ROOT is required}"
# shellcheck source=/dev/null
source "$ROOT/lib/install.sh"
# shellcheck source=/dev/null
source "$ROOT/lib/bootstrap.sh"

CONFIG_REPO_ROOT="${CONFIG_REPO_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
DOTFILES_SRC="$CONFIG_REPO_ROOT/dotfiles/codex"
MANIFEST="$(managed_machine_config_dir)/codex.manifest"
PROFILES_STATE="$(managed_machine_config_dir)/codex.profiles"

usage() {
    cat <<'EOF'
Usage: config/codex [--profile <name> ...] [--disable-profile <name> ...]

Applies the managed codex configuration to ~/.codex/config.toml:
dotfiles/codex/defaults.toml (the shared default setup) plus every enabled
dotfiles/codex/profiles/<name>.toml. Profiles persist per machine in
~/.config/managed-machine/codex.profiles; once enabled, run them with
`codex --profile <name>`.
EOF
}

# 1. Parse profile arguments into the persistent enabled set.
requested=()
disabled=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --profile)
            [[ $# -ge 2 ]] || { echo "Error: --profile requires a name" >&2; exit 1; }
            requested+=("$2"); shift 2
            ;;
        --disable-profile)
            [[ $# -ge 2 ]] || { echo "Error: --disable-profile requires a name" >&2; exit 1; }
            disabled+=("$2"); shift 2
            ;;
        --help|-h)
            usage; exit 0
            ;;
        *)
            echo "Error: unknown argument: $1" >&2; usage >&2; exit 1
            ;;
    esac
done

enabled_profiles() {
    # Sorted, deduped enabled set: state file plus this run's requests.
    { [[ -f "$PROFILES_STATE" ]] && cat "$PROFILES_STATE"; printf '%s\n' "${requested[@]:-}"; } \
        | sed '/^$/d' | LC_ALL=C sort -u
}

enabled_after_change() {
    enabled_profiles | while IFS= read -r p; do
        [[ -n "$p" ]] || continue
        skip=0
        for d in ${disabled[@]+"${disabled[@]}"}; do [[ "$p" == "$d" ]] && skip=1; done
        [[ "$skip" == "0" ]] && printf '%s\n' "$p"
    done
}

if [[ ${#requested[@]} -gt 0 || ${#disabled[@]} -gt 0 ]]; then
    for p in ${requested[@]+"${requested[@]}"}; do
        if [[ ! -f "$DOTFILES_SRC/profiles/$p.toml" ]]; then
            echo "Error: unknown codex profile '$p' — no $DOTFILES_SRC/profiles/$p.toml" >&2
            ls "$DOTFILES_SRC/profiles" 2>/dev/null | sed 's/\.toml$//' | sed 's/^/  available: /' >&2
            exit 1
        fi
    done
    mkdir -p "$(dirname "$PROFILES_STATE")"
    enabled_after_change >"$PROFILES_STATE"
fi

# 2. Install the model catalog bundled profiles reference (managed, only if
#    missing).
if [[ -f "$DOTFILES_SRC/meta-models.json" ]]; then
    install_home_file \
        "$DOTFILES_SRC/meta-models.json" \
        "$HOME/.codex/meta-models.json" \
        "$MANIFEST" \
        "codex meta-models.json"
fi

# 3. Compose the managed fragment: defaults.toml (root-level settings) first,
#    then each enabled profile. Order matters — TOML scopes assignments to the
#    most recent table header, so root keys must precede all profile tables.
FRAGMENT="$(mktemp)"
outside_tmp="$(mktemp)"
merged_tmp="$(mktemp)"
trap 'rm -f "$FRAGMENT" "$outside_tmp" "$merged_tmp"' EXIT
: >"$FRAGMENT"
if [[ -f "$DOTFILES_SRC/defaults.toml" ]]; then
    cat "$DOTFILES_SRC/defaults.toml" >>"$FRAGMENT"
    printf '\n' >>"$FRAGMENT"
fi
if [[ -d "$DOTFILES_SRC/profiles" ]]; then
    while IFS= read -r p; do
        [[ -n "$p" ]] || continue
        f="$DOTFILES_SRC/profiles/$p.toml"
        if [[ -f "$f" ]]; then
            cat "$f" >>"$FRAGMENT"
            printf '\n' >>"$FRAGMENT"
        else
            echo "warn: enabled profile '$p' has no $f — dropped from state" >&2
        fi
    done < <(enabled_profiles)
fi

fragment_has_content() {
    grep -qE '^[[:space:]]*[^#[:space:]]' "$FRAGMENT"
}

# 4. Merge into ~/.codex/config.toml. Never clobbers user configuration —
#    managed content lives in a managed block, or setup reports the required
#    manual merge and defers. Conflict detection runs before ANY write, so
#    the deferred path leaves the user's config byte-for-byte untouched.
CONFIG="$HOME/.codex/config.toml"
mkdir -p "$(dirname "$CONFIG")"
touch "$CONFIG"

CODEX_BLOCK_BEGIN="# BEGIN managed-machine codex"
CODEX_BLOCK_END="# END managed-machine codex"

# Config content outside the managed block: the user's own configuration,
# which this script must never rewrite.
config_outside_block() {
    # Trailing blank lines are trimmed so re-composing outside + block reaches
    # a byte-for-byte fixed point (the separator before the block would
    # otherwise accumulate one blank line per run).
    awk -v b="$CODEX_BLOCK_BEGIN" -v e="$CODEX_BLOCK_END" '
        $0 == b { skip = 1; next }
        $0 == e { skip = 0; next }
        !skip { lines[++n] = $0 }
        END {
            while (n > 0 && lines[n] == "") n--
            for (i = 1; i <= n; i++) print lines[i]
        }
    ' "$CONFIG"
}

# TOML scopes an assignment to the most recent table header, so only the
# region before the first header holds root-level settings. These helpers
# split any content into that root region and the rest.
toml_root_region() {
    awk '/^[[:space:]]*\[/ { exit } { lines[++n] = $0 }
        END {
            while (n > 0 && lines[n] == "") n--
            for (i = 1; i <= n; i++) print lines[i]
        }'
}

toml_table_region() {
    awk 'in_tables { print; next } /^[[:space:]]*\[/ { in_tables = 1; print }'
}

# Normalize `key = "value"` to `key=value` for comparison (whitespace-insensitive).
norm_assign() { sed -E 's/[[:space:]]//g'; }

# Root-level assignments and table headers the fragment defines. Assignments
# inside the fragment's own tables (e.g. base_url under [model_providers.meta])
# are scoped to those tables and never compared as global keys.
fragment_assignment_lines() {
    toml_root_region <"$FRAGMENT" \
        | sed -nE '/^[[:space:]]*[A-Za-z0-9_-]+[[:space:]]*=/p'
}

fragment_assignment_keys() {
    fragment_assignment_lines \
        | sed -nE 's/^[[:space:]]*([A-Za-z0-9_-]+)[[:space:]]*=.*/\1/p'
}

fragment_table_headers() {
    sed -nE 's/^[[:space:]]*(\[[^]]+\]).*/\1/p' "$FRAGMENT"
}

# A fragment root key the user already set to a DIFFERENT value is a conflict:
# merging would clobber or shadow their choice. The same key at the SAME value
# is converged — the user's line is absorbed (dropped from their region; the
# managed block supplies it). Table headers always conflict when duplicated —
# defining the same table twice is a TOML error.
conflicting_user_keys() {
    local outside_root outside key header fline
    outside="$(config_outside_block)"
    outside_root="$(toml_root_region <<<"$outside")"
    while IFS= read -r fline; do
        [[ -n "$fline" ]] || continue
        key="$(sed -nE 's/^[[:space:]]*([A-Za-z0-9_-]+)[[:space:]]*=.*/\1/p' <<<"$fline")"
        user_line="$(grep -E "^[[:space:]]*${key}[[:space:]]*=" <<<"$outside_root" | head -1 || true)"
        [[ -z "$user_line" ]] && continue
        if [[ "$(norm_assign <<<"$user_line")" != "$(norm_assign <<<"$fline")" ]]; then
            printf '%s\n' "$key"
        fi
    done < <(fragment_assignment_lines)
    while IFS= read -r header; do
        [[ -n "$header" ]] || continue
        if grep -qF "$header" <<<"$outside"; then
            printf '%s\n' "$header"
        fi
    done < <(fragment_table_headers)
}

if fragment_has_content; then
    CONFLICTS="$(conflicting_user_keys)"
    if [[ -n "$CONFLICTS" ]]; then
        echo "Codex configuration NOT applied — ~/.codex/config.toml already sets:" >&2
        printf '  %s\n' $CONFLICTS >&2
        echo "Review and merge manually. Managed sources:" >&2
        echo "  $DOTFILES_SRC/defaults.toml" >&2
        echo "  $DOTFILES_SRC/profiles/" >&2
        defer_setup \
            "codex managed configuration conflicts with existing ~/.codex/config.toml entries ($(echo $CONFLICTS | tr ' ' ','))" \
            "manually reconcile $CONFIG with $DOTFILES_SRC, then re-run: managed-machine setup codex"
    fi
fi

# Older versions wrote a root-level model_catalog_json pointing at the managed
# Meta catalog — that made Muse the effective default. The exact managed line
# is migrated out of the user's root region; any other value is theirs and
# stays. Same-value user duplicates of fragment root keys are absorbed for the
# same reason: the managed block supplies them.
absorb_managed_lines() {
    awk -v home="$HOME" -v frag="$FRAGMENT" '
        BEGIN {
            while ((getline l < frag) > 0) {
                if (l ~ /^[[:space:]]*[A-Za-z0-9_-]+[[:space:]]*=/) {
                    n = l; gsub(/[[:space:]]/, "", n)
                    froot[n] = 1
                }
                if (l ~ /^[[:space:]]*\[/) break
            }
        }
        {
            n = $0; gsub(/[[:space:]"]/, "", n)
            if ($0 ~ /^[[:space:]]*model_catalog_json[[:space:]]*=/ &&
                (n == "model_catalog_json=" home "/.codex/meta-models.json" ||
                 n == "model_catalog_json=~/.codex/meta-models.json")) next
            n2 = $0; gsub(/[[:space:]]/, "", n2)
            if (n2 in froot) next
            print
        }
    '
}

config_outside_block >"$outside_tmp"
{
    toml_root_region <"$outside_tmp" | absorb_managed_lines
    if fragment_has_content; then
        printf '\n%s\n' "$CODEX_BLOCK_BEGIN"
        cat "$FRAGMENT"
        printf '%s\n' "$CODEX_BLOCK_END"
    fi
    tables="$(toml_table_region <"$outside_tmp")"
    if [[ -n "$tables" ]]; then
        printf '\n%s\n' "$tables"
    fi
} >"$merged_tmp"

if cmp -s "$merged_tmp" "$CONFIG"; then
    echo "codex configuration already applied in $CONFIG"
else
    mv "$merged_tmp" "$CONFIG"
    echo "applied codex configuration to $CONFIG (managed block)"
fi

if ! fragment_has_content; then
    echo "no managed codex configuration bundled — codex configuration unchanged"
    echo "Codex dotfiles setup complete. No secrets were written - provider auth stays in Keychain (codex-meta-muse)."
    exit 0
fi

# 5. Verify the managed content landed where TOML keeps it effective: fragment
#    root keys in the file's root region (before the first table header), and
#    every fragment table header inside the managed block.
managed_block() {
    awk -v b="$CODEX_BLOCK_BEGIN" -v e="$CODEX_BLOCK_END" '
        $0 == b { inb = 1; next } $0 == e { inb = 0; next } inb
    ' "$CONFIG"
}

verify_failed=0
while IFS= read -r key; do
    [[ -n "$key" ]] || continue
    if ! toml_root_region <"$CONFIG" | grep -qE "^[[:space:]]*${key}[[:space:]]*="; then
        echo "Error: managed setting '$key' did not land at root level" >&2
        verify_failed=1
    fi
done < <(fragment_assignment_keys)
while IFS= read -r header; do
    [[ -n "$header" ]] || continue
    if ! managed_block | sed 's/^[[:space:]]*//' | grep -qxF "$header"; then
        echo "Error: managed table '$header' missing from managed block" >&2
        verify_failed=1
    fi
done < <(fragment_table_headers)
[[ "$verify_failed" == "0" ]] || exit 1

echo "Codex dotfiles setup complete. No secrets were written - provider auth stays in Keychain (codex-meta-muse)."
