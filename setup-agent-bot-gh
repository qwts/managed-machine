#!/usr/bin/env bash
# Explicitly install or restore agent-bot's Codex desktop Homebrew gh interposer.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=lib/install.sh
source "$REPO_ROOT/lib/install.sh"
# shellcheck source=lib/agent-bot-gh.sh
source "$REPO_ROOT/lib/agent-bot-gh.sh"

if [[ $# -gt 1 ]]; then
    echo "usage: setup-agent-bot-gh [--restore]" >&2
    exit 1
fi

case "${1:-}" in
    "") install_agent_bot_gh_interposer ;;
    --restore) restore_agent_bot_gh_interposer ;;
    *)
        echo "usage: setup-agent-bot-gh [--restore]" >&2
        exit 1
        ;;
esac
