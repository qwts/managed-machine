#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=lib/install.sh
source "$REPO_ROOT/lib/install.sh"
# shellcheck source=lib/agent-bot-gh.sh
source "$REPO_ROOT/lib/agent-bot-gh.sh"
# shellcheck source=lib/ssh-key.sh
source "$REPO_ROOT/lib/ssh-key.sh"
# shellcheck source=lib/github-ssh-keys.sh
source "$REPO_ROOT/lib/github-ssh-keys.sh"

CONFIG_REPO_ROOT="$(managed_machine_config_repo_dir)"
# shellcheck source=lib/fleet.sh
source "$REPO_ROOT/lib/fleet.sh"
FLEET_CHANGED=0

KEY_PATH="${HOME}/.ssh/id_rsa_github"
PUB_PATH="${KEY_PATH}.pub"
SSH_CONFIG="${HOME}/.ssh/config"

ensure_brew_on_path() {
    if command -v brew >/dev/null 2>&1; then
        return 0
    fi
    for brew in /opt/homebrew/bin/brew /usr/local/bin/brew; do
        if [[ -x "$brew" ]]; then
            eval "$("$brew" shellenv)"
            return 0
        fi
    done
    return 1
}

ensure_ssh_key() {
    ensure_github_ssh_key "$KEY_PATH" "$PUB_PATH"
}

ensure_ssh_config() {
    mkdir -p "${HOME}/.ssh"
    chmod 700 "${HOME}/.ssh"

    if [[ -f "$SSH_CONFIG" ]] && grep -Eq '^[[:space:]]*Host[[:space:]]+github\.com([[:space:]]|$)' "$SSH_CONFIG"; then
        echo "SSH config already has Host github.com — leaving unchanged"
        return 0
    fi

    if [[ ! -f "$SSH_CONFIG" ]]; then
        touch "$SSH_CONFIG"
        chmod 600 "$SSH_CONFIG"
    fi

    cat >>"$SSH_CONFIG" <<EOF

# Added by managed-machine/setup-gh
Host github.com
  HostName github.com
  User git
  IdentityFile ${KEY_PATH}
  IdentitiesOnly yes
  AddKeysToAgent yes
  UseKeychain yes
EOF
    echo "Configured SSH Host github.com → $KEY_PATH"
}

add_key_to_agent() {
    if [[ "$(uname -s)" == "Darwin" ]]; then
        ssh-add --apple-use-keychain "$KEY_PATH" 2>/dev/null || ssh-add "$KEY_PATH"
    else
        ssh-add "$KEY_PATH"
    fi
    echo "SSH key loaded into agent"
}

# Authentication preflight: an active account is required before this script
# mutates anything. Upload scopes are NOT demanded here (#86): a machine
# whose keys are already registered must not open a device flow on every
# --update just because its token lost them. They are requested by
# upload_ssh_key_as, only when a key actually needs uploading. A first login
# still asks for the complete set so no second flow follows.
ensure_gh_auth() {
    local active missing

    active="$(gh_active_account)"
    if [[ -n "$active" ]]; then
        echo "Active GitHub account: $active"
        missing="$(gh_missing_scopes)"
        if [[ -z "$missing" ]]; then
            echo "Token has the key-upload scopes ($GH_SSH_KEY_SCOPES)"
        else
            echo "Token lacks the key-upload scopes ($missing) — requested only if a key must be uploaded"
        fi
        return 0
    fi

    report_required_scopes
    echo "No active GitHub account — starting authentication (browser)..."
    gh auth login -h github.com -p ssh -w --skip-ssh-key -s "$GH_SSH_KEY_SCOPES"
    echo "Authenticated as: $(gh_active_account)"
}

# Private HTTPS URLs (formula resources, bundled seeds) authenticate through
# gh's git credential helper; keep it wired on every run.
ensure_gh_git_credentials() {
    gh auth setup-git -h github.com
    echo "Configured: gh as git credential helper (github.com HTTPS)"
}

upload_ssh_keys() {
    local title
    title="$(hostname -s)-$(date +%Y%m%d)"
    upload_ssh_key_as authentication "$title" "$PUB_PATH"
    upload_ssh_key_as signing "${title}-signing" "$PUB_PATH"
}

configure_git_identity() {
    local login user_id email
    login="$(gh api user --jq .login)"
    user_id="$(gh api user --jq .id)"
    if [[ -z "$login" || -z "$user_id" ]]; then
        echo "Error: could not read GitHub login/id for git identity" >&2
        exit 1
    fi

    # Login only (not profile display name) + private noreply email.
    email="${user_id}+${login}@users.noreply.github.com"

    git config --global user.name "$login"
    git config --global user.email "$email"

    echo "Configured Git identity (login + private GitHub noreply):"
    echo "  user.name=$(git config --global --get user.name)"
    echo "  user.email=$(git config --global --get user.email)"
}

configure_git_ssh_signing() {
    git config --global gpg.format ssh
    git config --global user.signingkey "$PUB_PATH"
    git config --global commit.gpgsign true
    git config --global tag.gpgSign true
    # Local verification (git log --show-signature) needs an allowed-signers
    # file; its fleet-derived content is synchronized after registration.
    git config --global gpg.ssh.allowedSignersFile "${HOME}/.ssh/allowed_signers"

    echo "Configured Git SSH commit/tag signing:"
    echo "  gpg.format=$(git config --global --get gpg.format)"
    echo "  user.signingkey=$(git config --global --get user.signingkey)"
    echo "  commit.gpgsign=$(git config --global --get commit.gpgsign)"
    echo "  tag.gpgSign=$(git config --global --get tag.gpgSign)"
    echo "  gpg.ssh.allowedSignersFile=$(git config --global --get gpg.ssh.allowedSignersFile)"
}

if ! ensure_brew_on_path; then
    echo "Error: brew required — run setup-brew first" >&2
    exit 1
fi

HOMEBREW_GH_PATH="$(agent_bot_homebrew_gh_path)"
if [[ -x "$HOMEBREW_GH_PATH" ]]; then
    echo "GitHub CLI already installed: $HOMEBREW_GH_PATH"
    "$HOMEBREW_GH_PATH" --version | head -1
else
    echo "Installing GitHub CLI..."
    brew_run install gh
    if [[ ! -x "$HOMEBREW_GH_PATH" ]]; then
        echo "Error: Homebrew gh is still missing after installation: $HOMEBREW_GH_PATH" >&2
        exit 1
    fi
    echo "GitHub CLI installed: $HOMEBREW_GH_PATH"
fi

# gh's own clone/remote operations keep SSH once this script has provisioned
# the machine key; repository URLs baked into the formula and installer are
# authenticated HTTPS and rely on gh's git credential helper instead.
gh config set git_protocol ssh -h github.com
echo "Configured: git_protocol=ssh (github.com)"

# Authentication preflight runs before any mutation; upload scopes are
# granted later, in a single flow, only when a key must be uploaded.
ensure_gh_auth
ensure_gh_git_credentials

ensure_ssh_key
ensure_ssh_config
add_key_to_agent
upload_ssh_keys
configure_git_identity
configure_git_ssh_signing

# The private config checkout is persistent user state. Import/register first,
# then synchronize the exact managed fleet paths in one retry-safe transaction.
import_legacy_fleet_entries
register_current_machine "$PUB_PATH"
generate_fleet_authorized_keys
sync_managed_machine_config_repo \
    "$CONFIG_REPO_ROOT" \
    "Register managed machine $(scutil --get LocalHostName 2>/dev/null || hostname -s)" \
    generate_fleet_authorized_keys
generate_fleet_authorized_keys
sync_local_authorized_keys
sync_local_allowed_signers "$(git config --global --get user.email)"
report_fleet_changes

# This is a no-op unless the owner explicitly opted this machine into direct
# Homebrew-path interposition. Re-running repairs Homebrew upgrades/relinks.
repair_agent_bot_gh_if_configured

echo "GitHub CLI setup complete."
