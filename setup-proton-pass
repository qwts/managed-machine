#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=lib/install.sh
source "$REPO_ROOT/lib/install.sh"

ensure_local_bin_in_zshrc "${HOME}/.zshrc"
export_local_bin_to_path

if command -v pass-cli >/dev/null 2>&1; then
    echo "Proton Pass CLI already installed: $(command -v pass-cli)"
    pass-cli --version
    exit 0
fi

echo "Installing Proton Pass CLI..."
curl -fsSL https://proton.me/download/pass-cli/install.sh | bash

if ! command -v pass-cli >/dev/null 2>&1; then
    echo "Install finished but pass-cli not found on PATH." >&2
    echo "Open a new shell or: export PATH=\"${HOME}/.local/bin:\$PATH\"" >&2
    exit 1
fi

echo "Proton Pass CLI installed: $(command -v pass-cli)"
pass-cli --version
