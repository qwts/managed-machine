#!/usr/bin/env bash
# Install gitleaks and, when this checkout is the managed-machine git
# toplevel, wire pre-commit scanning without replacing an existing hooksPath
# (for example a global agent-bot install).
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")" && pwd)"
HOOKS_DIR="git-hooks"
# shellcheck source=lib/bootstrap.sh
source "$REPO_ROOT/lib/bootstrap.sh"

canonical_dir() {
    (cd "$1" && pwd -P)
}

# Relative core.hooksPath=git-hooks on a parent repo that has no git-hooks/
# directory is the fingerprint of a previous walk-up write from this script.
repair_stray_relative_hooks_path() {
    local discovered="$1"
    local current
    current="$(git -C "$discovered" config --local --get core.hooksPath 2>/dev/null || true)"
    if [[ "$current" == "git-hooks" && ! -d "$discovered/git-hooks" ]]; then
        git -C "$discovered" config --local --unset-all core.hooksPath
        echo "Removed stray core.hooksPath=git-hooks from $discovered"
    fi
}

is_our_hooks_path() {
    local value="$1"
    local dispatcher="$2"
    [[ -n "$value" ]] || return 1
    [[ "$value" == "$HOOKS_DIR" || "$value" == "$REPO_ROOT/$HOOKS_DIR" || "$value" == "$dispatcher" ]]
}

write_chain_hook() {
    local dest="$1"
    local name="$2"
    cat >"$dest" <<EOF
#!/bin/sh
# Generated by managed-machine setup-git-hooks. Do not edit.
# Re-entry guard: agent-bot may chain back into this directory.
if [ -n "\$MANAGED_MACHINE_HOOK_DEPTH" ]; then
  exit 0
fi
export MANAGED_MACHINE_HOOK_DEPTH=1
prior=\$(git config --local --get managed-machine.priorHooksPath 2>/dev/null || true)
if [ -n "\$prior" ] && [ -x "\$prior/$name" ]; then
  exec "\$prior/$name" "\$@"
fi
exit 0
EOF
    chmod +x "$dest"
}

write_pre_commit_hook() {
    local dest="$1"
    local repo_precommit="$2"
    cat >"$dest" <<EOF
#!/bin/sh
# Generated by managed-machine setup-git-hooks. Do not edit.
set -e
if [ -n "\$MANAGED_MACHINE_HOOK_DEPTH" ]; then
  exit 0
fi
export MANAGED_MACHINE_HOOK_DEPTH=1
"$repo_precommit"
prior=\$(git config --local --get managed-machine.priorHooksPath 2>/dev/null || true)
if [ -n "\$prior" ] && [ -x "\$prior/pre-commit" ]; then
  exec "\$prior/pre-commit" "\$@"
fi
exit 0
EOF
    chmod +x "$dest"
}

install_composed_hooks() {
    local dispatcher="$1"
    local prior="$2"
    local name hook
    mkdir -p "$dispatcher"
    find "$dispatcher" -mindepth 1 -maxdepth 1 -exec rm -rf {} +
    write_pre_commit_hook "$dispatcher/pre-commit" "$REPO_ROOT/$HOOKS_DIR/pre-commit"
    if [[ -n "$prior" && -d "$prior" ]]; then
        # Git has no hooksPath chain: wrap every hook in the prior directory
        # so agent-bot (and anything else) keeps running alongside gitleaks.
        for hook in "$prior"/*; do
            [[ -e "$hook" ]] || continue
            [[ -x "$hook" && -f "$hook" ]] || continue
            name="$(basename "$hook")"
            [[ "$name" == "pre-commit" ]] && continue
            write_chain_hook "$dispatcher/$name" "$name"
        done
    fi
    git -C "$REPO_ROOT" config --local core.hooksPath "$dispatcher"
    if [[ -n "$prior" ]]; then
        git -C "$REPO_ROOT" config --local managed-machine.priorHooksPath "$prior"
    fi
}

"$REPO_ROOT/$HOOKS_DIR/setup-gitleaks"

for hook in pre-commit; do
    if [[ -f "$REPO_ROOT/$HOOKS_DIR/$hook" ]]; then
        chmod +x "$REPO_ROOT/$HOOKS_DIR/$hook"
    fi
done
chmod +x "$REPO_ROOT/$HOOKS_DIR/setup-gitleaks"

toplevel="$(git -C "$REPO_ROOT" rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "$toplevel" ]]; then
    skip_setup "$REPO_ROOT is not a git work tree — gitleaks is installed, hooks are not wired"
fi

if [[ "$(canonical_dir "$toplevel")" != "$(canonical_dir "$REPO_ROOT")" ]]; then
    repair_stray_relative_hooks_path "$toplevel"
    skip_setup "$REPO_ROOT is not the git toplevel (discovered $toplevel) — gitleaks is installed, hooks are not wired"
fi

cd "$REPO_ROOT"

git_dir="$(git rev-parse --path-format=absolute --git-common-dir)"
dispatcher="$git_dir/managed-machine-hooks"
saved_prior="$(git config --local --get managed-machine.priorHooksPath 2>/dev/null || true)"
effective_hooks="$(git config --get core.hooksPath 2>/dev/null || true)"
global_hooks="$(git config --global --get core.hooksPath 2>/dev/null || true)"

prior=""
if [[ -n "$saved_prior" ]] && ! is_our_hooks_path "$saved_prior" "$dispatcher"; then
    prior="$saved_prior"
elif [[ -n "$effective_hooks" ]] && ! is_our_hooks_path "$effective_hooks" "$dispatcher"; then
    prior="$effective_hooks"
elif [[ -n "$global_hooks" ]] && ! is_our_hooks_path "$global_hooks" "$dispatcher"; then
    # Local git-hooks from an older run hid a global agent-bot hooksPath.
    prior="$global_hooks"
fi

if [[ -n "$prior" ]]; then
    install_composed_hooks "$dispatcher" "$prior"
    echo "Git hooks enabled for $REPO_ROOT (core.hooksPath=$dispatcher, chaining $prior)"
else
    git config --local core.hooksPath "$HOOKS_DIR"
    git config --local --unset-all managed-machine.priorHooksPath 2>/dev/null || true
    echo "Git hooks enabled for $REPO_ROOT (core.hooksPath=$HOOKS_DIR)"
fi
