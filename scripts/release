#!/usr/bin/env bash
# Release a new managed-machine version.
#
# Bumps the formula tag/version pair and VERSION together (preventing version
# drift), commits, tags, and pushes in the order that keeps the tag
# self-consistent: the tagged commit contains the formula that points at that
# same tag. A version outside the skill's qwts-versions is refused before any
# change (ENG-0055): leaving the range needs a reviewed skill revalidation.
#
#   scripts/release vX.Y.Z
#
# Operates on the checkout containing the current working directory so a
# development clone releases itself.
set -euo pipefail

usage() {
    echo "Usage: scripts/release vX.Y.Z" >&2
}

version="${1:-}"
if [[ ! "$version" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    usage
    echo "Error: version must look like v1.2.3 (got '${version:-<missing>}')" >&2
    exit 1
fi
bare="${version#v}"

root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
formula="$root/Formula/managed-machine.rb"
skill="$root/skills/managed-machine/SKILL.md"
version_file="$root/VERSION"
if [[ -z "$root" || ! -f "$formula" || ! -f "$skill" || ! -f "$version_file" ]]; then
    echo "Error: run from inside a managed-machine checkout" >&2
    exit 1
fi
cd "$root"

if [[ -n "$(git status --porcelain)" ]]; then
    echo "Error: working tree must be clean to release" >&2
    exit 1
fi

# ENG-0055 release gate, local half (CI runs the shared cli-skill-gate). This
# repository keeps qwts-versions in the bounded form ">=A.B.C <D.E.F" so the
# check needs no SemVer library.
semver_cmp() {
    local a b i
    IFS=. read -r -a a <<<"$1"
    IFS=. read -r -a b <<<"$2"
    for i in 0 1 2; do
        (( a[i] < b[i] )) && { echo -1; return; }
        (( a[i] > b[i] )) && { echo 1; return; }
    done
    echo 0
}
range="$(sed -nE 's/^[[:space:]]*qwts-versions:[[:space:]]*"([^"]*)"[[:space:]]*$/\1/p' "$skill" | head -1)"
if [[ ! "$range" =~ ^\>=([0-9]+\.[0-9]+\.[0-9]+)\ \<([0-9]+\.[0-9]+\.[0-9]+)$ ]]; then
    echo "Error: $skill must declare qwts-versions as \">=A.B.C <D.E.F\" (got '${range:-<missing>}')" >&2
    exit 1
fi
if [[ "$(semver_cmp "$bare" "${BASH_REMATCH[1]}")" == -1 || "$(semver_cmp "$bare" "${BASH_REMATCH[2]}")" != -1 ]]; then
    echo "Error: $version is outside the skill's qwts-versions ($range) — revalidate skills/managed-machine in a reviewed PR first (ENG-0055)" >&2
    exit 1
fi

# The formula pins its managed-machine-config seed to tag+revision on that
# repo, so a release also carries a catalog/dotfiles version: the sibling
# checkout gets tagged at the release version before the formula revision
# names the commit.
config_repo="${MANAGED_MACHINE_CONFIG_DIR:-$root/../managed-machine-config}"

# The remote URL to consult for published config tags: the checkout's own
# origin when present, else the default.
config_remote_url() {
    git -C "$config_repo" remote get-url origin 2>/dev/null \
        || printf '%s\n' "https://github.com/qwts/managed-machine-config.git"
}

# Print the commit the published config tag names (peeled for annotated
# tags), or nothing when the tag does not exist on the remote.
remote_config_tag_sha() {
    git ls-remote --tags "$(config_remote_url)" "refs/tags/$version^{}" "refs/tags/$version" \
        | tail -1 | awk '{print $1}'
}

# Ensure origin carries config tag $version naming the commit the formula
# pins. A published tag naming any other commit is an immutable release and
# aborts; a missing tag is created on the sibling checkout, which must be
# clean main at origin/main so the tagged content is published work.
ensure_config_tag() {
    local target="$1" remote_sha
    remote_sha="$(remote_config_tag_sha || true)"
    if [[ -n "$remote_sha" ]]; then
        if [[ "$remote_sha" != "$target" ]]; then
            echo "Error: managed-machine-config tag $version on origin points at ${remote_sha:0:7}, expected ${target:0:7} — choose a new version" >&2
            return 1
        fi
        return 0
    fi
    if [[ ! -d "$config_repo/.git" ]]; then
        echo "Error: managed-machine-config checkout not found at $config_repo — set MANAGED_MACHINE_CONFIG_DIR" >&2
        return 1
    fi
    if [[ -n "$(git -C "$config_repo" status --porcelain)" ]]; then
        echo "Error: managed-machine-config working tree must be clean to release" >&2
        return 1
    fi
    if [[ "$(git -C "$config_repo" rev-parse --abbrev-ref HEAD)" != "main" ]]; then
        echo "Error: managed-machine-config must be on main to release" >&2
        return 1
    fi
    git -C "$config_repo" fetch --quiet origin main || return 1
    if ! git -C "$config_repo" merge-base --is-ancestor "$target" origin/main 2>/dev/null; then
        echo "Error: managed-machine-config release commit ${target:0:7} is not on origin/main — push it first" >&2
        return 1
    fi
    # A tag created by an attempt whose push failed is reused when it names
    # the same commit; one pointing anywhere else is a conflict to resolve.
    if git -C "$config_repo" rev-parse --verify --quiet "refs/tags/$version" >/dev/null; then
        if [[ "$(git -C "$config_repo" rev-parse "refs/tags/${version}^{commit}")" != "$target" ]]; then
            echo "Error: local managed-machine-config tag $version points at another commit — resolve it or choose a new version" >&2
            return 1
        fi
    else
        git -C "$config_repo" tag -m "Release $version" "$version" "$target" || return 1
    fi
    git -C "$config_repo" push --quiet origin "refs/tags/$version" || return 1
    echo "Tagged managed-machine-config $version (${target:0:7})."
}

# A failed push must be retryable: when the local tag from a previous attempt
# points at HEAD and the release commit is already made, resume by pushing
# again instead of demanding manual git surgery. A tag already on the remote
# is a published release and stays immutable.
if git rev-parse --verify --quiet "refs/tags/$version" >/dev/null; then
    if git ls-remote --exit-code --tags origin "refs/tags/$version" >/dev/null 2>&1; then
        echo "Error: tag $version already exists on origin — already released" >&2
        exit 1
    fi
    if [[ "$(git rev-parse "refs/tags/${version}^{commit}")" == "$(git rev-parse HEAD)" ]] \
        && [[ "$(git log -1 --format=%s)" == "Release $version" ]]; then
        echo "Resuming unpublished release $version (previous push failed)..."
        # The committed formula already pins the config revision; make sure
        # the tag it names is published before the release tag goes out.
        config_sha="$(sed -nE 's|^[[:space:]]*revision:[[:space:]]*"([0-9a-f]{40})".*|\1|p' "$formula" | head -1)"
        if [[ -z "$config_sha" ]]; then
            echo "Error: formula does not pin a managed-machine-config revision" >&2
            exit 1
        fi
        ensure_config_tag "$config_sha" || exit 1
        git push origin HEAD "$version"
        echo "Released $version — formula and VERSION synchronized, tag pushed."
        exit 0
    fi
    echo "Error: local tag $version exists but does not match an unpublished release commit at HEAD" >&2
    exit 1
fi

# A release is main as published: the formula's tag must be reachable from
# main, or `brew upgrade` never sees it and the merged work stays unshipped
# (v0.5.4 was once cut from a feature branch and contained none of the
# merged fixes). Refuse any other branch, and a main that is behind or
# ahead of origin, before touching a file.
branch="$(git rev-parse --abbrev-ref HEAD)"
if [[ "$branch" != "main" ]]; then
    echo "Error: releases are cut from main; this checkout is on '$branch' — git checkout main && git pull --ff-only, then rerun" >&2
    exit 1
fi
git fetch --quiet origin main
if [[ "$(git rev-parse HEAD)" != "$(git rev-parse origin/main)" ]]; then
    echo "Error: main is not at origin/main (local $(git rev-parse --short HEAD), origin $(git rev-parse --short origin/main)) — git pull --ff-only (or push what is unpublished), then rerun" >&2
    exit 1
fi

# The config seed is pinned to tag+revision; tag the sibling checkout at the
# release version (published main only) so the formula can name its commit.
if [[ ! -d "$config_repo/.git" ]]; then
    echo "Error: managed-machine-config checkout not found at $config_repo — set MANAGED_MACHINE_CONFIG_DIR" >&2
    exit 1
fi
if [[ -n "$(git -C "$config_repo" status --porcelain)" ]]; then
    echo "Error: managed-machine-config working tree must be clean to release" >&2
    exit 1
fi
if [[ "$(git -C "$config_repo" rev-parse --abbrev-ref HEAD)" != "main" ]]; then
    echo "Error: managed-machine-config must be on main to release" >&2
    exit 1
fi
git -C "$config_repo" fetch --quiet origin main
if [[ "$(git -C "$config_repo" rev-parse HEAD)" != "$(git -C "$config_repo" rev-parse origin/main)" ]]; then
    echo "Error: managed-machine-config main is not at origin/main — git -C $config_repo pull --ff-only, then rerun" >&2
    exit 1
fi
config_sha="$(git -C "$config_repo" rev-parse HEAD)"
ensure_config_tag "$config_sha" || exit 1

sed -i '' -E "s|^([[:space:]]*tag:[[:space:]]*\")v[0-9]+\.[0-9]+\.[0-9]+(\")|\1${version}\2|" "$formula"
sed -i '' -E "s|^([[:space:]]*version \")[0-9]+\.[0-9]+\.[0-9]+(\")|\1${bare}\2|" "$formula"
printf '%s\n' "$bare" >"$version_file"
# The config resource's revision names the tagged commit; scope the rewrite
# to that resource block so no other revision pin can be clobbered.
sed -i '' -E "/resource \"managed-machine-config\"/,/^  end/ s|^([[:space:]]*revision:[[:space:]]*\")[0-9a-f]{40}(\")|\1${config_sha}\2|" "$formula"

# Every substitution must have landed; a formula or skill format change must
# fail the release rather than ship a partial bump.
verify_bump() {
    [[ "$(grep -cE "^[[:space:]]*tag:[[:space:]]*\"$version\"" "$formula")" == 2 ]] \
        && grep -qE "^[[:space:]]*version \"$bare\"" "$formula" \
        && [[ "$(tr -d '[:space:]' <"$version_file")" == "$bare" ]] \
        && grep -qE "^[[:space:]]*revision:[[:space:]]*\"$config_sha\"" "$formula"
}
if ! verify_bump; then
    git checkout -- "$formula" "$version_file"
    echo "Error: version fields not found where expected — formula/VERSION format changed; release aborted, files restored" >&2
    exit 1
fi

git add "$formula" "$version_file"
git commit -m "Release $version"
# Annotated, not lightweight: ssh enroll --signing sets tag.gpgSign, which
# makes git create a signed tag and demand a message. A bare `git tag` then
# aborts with "no tag message?" and opens an editor where there is none.
git tag -m "Release $version" "$version"
git push origin HEAD "$version"

echo "Released $version — formula and VERSION synchronized, tag pushed."
