#!/usr/bin/env bash
# Prepare a managed-machine release branch/PR or push the release tag (S6 R05, D11).
#
#   scripts/release prepare vX.Y.Z
#   scripts/release tag vX.Y.Z
#
# `prepare` runs from clean main at origin/main, validates qwts-versions
# (ENG-0055), tags the sibling managed-machine-config checkout at vX.Y.Z,
# builds the five deterministic archives and SHA256SUMS via cmd/mm-release into
# a temporary dist/, dispatches .github/workflows/sign.yml at origin/main (the
# owner approves the `release` environment deployment) or reuses its draft
# release vX.Y.Z, proves the signed dist is that build plus Developer ID
# signatures with `mm-release verify-signed`, creates branch release/vX.Y.Z,
# updates VERSION and Formula/managed-machine.rb (tag, version, arm64/sequoia
# constraints, managed-machine-config tag+revision, the signed
# AgentBotMachine.app install block, and core resource URL + signed sha256),
# commits "Release vX.Y.Z", pushes the branch only, and prints the
# `gh pr create` command.
#
# `tag` runs after the release PR is merged and the owner has explicitly
# confirmed: it checks out main, verifies HEAD == origin/main, VERSION == X.Y.Z,
# Formula/managed-machine.rb fields, the core pin against the signed draft
# (verify-signed against a fresh deterministic build), the managed-machine-config
# tag on origin at the pinned revision, and no existing tag, then creates the
# annotated tag vX.Y.Z at HEAD and pushes refs/tags/vX.Y.Z only. The tag push
# makes release.yml publish the draft.
set -euo pipefail

usage() {
    echo "Usage: scripts/release <prepare|tag> vX.Y.Z" >&2
}

subcmd="${1:-}"
if [[ "$subcmd" != "prepare" && "$subcmd" != "tag" ]]; then
    usage
    echo "Error: expected subcommand 'prepare' or 'tag' (got '${subcmd:-<missing>}')" >&2
    exit 1
fi

if [[ $# -ne 2 ]]; then
    usage
    echo "Error: version must look like v1.2.3 (got '${2:-<missing>}')" >&2
    exit 1
fi

raw_version="${2:-}"
if [[ ! "$raw_version" =~ ^v?[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    usage
    echo "Error: version must look like v1.2.3 (got '${raw_version:-<missing>}')" >&2
    exit 1
fi
bare="${raw_version#v}"
version="v${bare}"

script_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
formula="$root/Formula/managed-machine.rb"
skill="$root/skills/managed-machine/SKILL.md"
version_file="$root/VERSION"
if [[ -z "$root" || ! -f "$formula" || ! -f "$skill" || ! -f "$version_file" ]]; then
    echo "Error: run from inside a managed-machine checkout" >&2
    exit 1
fi
cd "$root"

go_root="$root"
if [[ ! -f "$go_root/go.mod" && -f "$script_root/go.mod" ]]; then
    go_root="$script_root"
fi

if [[ -n "$(git status --porcelain)" ]]; then
    echo "Error: working tree must be clean to release" >&2
    exit 1
fi

# ENG-0055 release gate, local half (CI runs the shared cli-skill-gate). This
# repository keeps qwts-versions in the bounded form ">=A.B.C <D.E.F" so the
# check needs no SemVer library.
semver_cmp() {
    local a b i
    IFS=. read -r -a a <<<"$1"
    IFS=. read -r -a b <<<"$2"
    for i in 0 1 2; do
        (( a[i] < b[i] )) && { echo -1; return 0; }
        (( a[i] > b[i] )) && { echo 1; return 0; }
    done
    echo 0
}
range="$(sed -nE 's/^[[:space:]]*qwts-versions:[[:space:]]*"([^"]*)"[[:space:]]*$/\1/p' "$skill" | head -1)"
if [[ ! "$range" =~ ^\>=([0-9]+\.[0-9]+\.[0-9]+)\ \<([0-9]+\.[0-9]+\.[0-9]+)$ ]]; then
    echo "Error: $skill must declare qwts-versions as \">=A.B.C <D.E.F\" (got '${range:-<missing>}')" >&2
    exit 1
fi
if [[ "$(semver_cmp "$bare" "${BASH_REMATCH[1]}")" == -1 || "$(semver_cmp "$bare" "${BASH_REMATCH[2]}")" != -1 ]]; then
    echo "Error: $version is outside the skill's qwts-versions ($range) — revalidate skills/managed-machine in a reviewed PR first (ENG-0055)" >&2
    exit 1
fi

# The formula pins its managed-machine-config seed to tag+revision on that
# repo, so a release also carries a catalog/dotfiles version: the sibling
# checkout gets tagged at the release version before the formula revision
# names the commit.
config_repo="${MANAGED_MACHINE_CONFIG_DIR:-$root/../managed-machine-config}"

config_remote_url() {
    git -C "$config_repo" remote get-url origin 2>/dev/null \
        || printf '%s\n' "https://github.com/qwts/managed-machine-config.git"
}

remote_config_tag_sha() {
    git ls-remote --tags "$(config_remote_url)" "refs/tags/$version^{}" "refs/tags/$version" \
        | tail -1 | awk '{print $1}'
}

ensure_config_tag() {
    local target="$1" remote_sha
    remote_sha="$(remote_config_tag_sha || true)"
    if [[ -n "$remote_sha" ]]; then
        if [[ "$remote_sha" != "$target" ]]; then
            echo "Error: managed-machine-config tag $version on origin points at ${remote_sha:0:7}, expected ${target:0:7} — choose a new version" >&2
            return 1
        fi
        return 0
    fi
    if [[ ! -d "$config_repo/.git" ]]; then
        echo "Error: managed-machine-config checkout not found at $config_repo — set MANAGED_MACHINE_CONFIG_DIR" >&2
        return 1
    fi
    if [[ -n "$(git -C "$config_repo" status --porcelain)" ]]; then
        echo "Error: managed-machine-config working tree must be clean to release" >&2
        return 1
    fi
    if [[ "$(git -C "$config_repo" rev-parse --abbrev-ref HEAD)" != "main" ]]; then
        echo "Error: managed-machine-config must be on main to release" >&2
        return 1
    fi
    git -C "$config_repo" fetch --quiet origin main || return 1
    if ! git -C "$config_repo" merge-base --is-ancestor "$target" origin/main 2>/dev/null; then
        echo "Error: managed-machine-config release commit ${target:0:7} is not on origin/main — push it first" >&2
        return 1
    fi
    if git -C "$config_repo" rev-parse --verify --quiet "refs/tags/$version" >/dev/null; then
        if [[ "$(git -C "$config_repo" rev-parse "refs/tags/${version}^{commit}")" != "$target" ]]; then
            echo "Error: local managed-machine-config tag $version points at another commit — resolve it or choose a new version" >&2
            return 1
        fi
    else
        git -C "$config_repo" tag -m "Release $version" "$version" "$target" || return 1
    fi
    git -C "$config_repo" push --quiet origin "refs/tags/$version" || return 1
    echo "Tagged managed-machine-config $version (${target:0:7})."
}

# The darwin archive is pinned only after the sign workflow has signed and
# notarized it (docs/plans/macos-signing.md). Its draft release vX.Y.Z holds
# the signed dist; `mm-release verify-signed` proves it is the local
# deterministic build plus Developer ID signatures before anything trusts it.
release_repo="${MANAGED_MACHINE_RELEASE_REPO:-true-line/agent-bot-machine}"
team_id="Z5DM34QS5U"

draft_state() {
    gh release view "$version" --repo "$release_repo" --json isDraft --jq .isDraft 2>/dev/null || echo missing
}

download_signed_dist() {
    local dir="$1"
    rm -rf "$dir" && mkdir -p "$dir"
    gh release download "$version" --repo "$release_repo" --dir "$dir" \
        --pattern 'managed-machine_*' --pattern SHA256SUMS
}

verify_signed_dist() {
    local unsigned="$1" signed="$2"
    shift 2
    (cd "$go_root" && GOTOOLCHAIN=local go run ./cmd/mm-release verify-signed \
        -unsigned "$unsigned" -signed "$signed" -team "$team_id" "$@")
}

dispatch_sign() {
    local head_sha="$1" before run_id="" _
    before="$(gh run list --repo "$release_repo" --workflow sign.yml --event workflow_dispatch --limit 50 \
        --json databaseId --jq '.[].databaseId' || true)"
    gh workflow run sign.yml --repo "$release_repo" --ref main -f version="$bare" >&2
    for _ in $(seq 1 60); do
        while read -r id sha; do
            if [[ "$sha" == "$head_sha" ]] && ! grep -qxF "$id" <<<"$before"; then
                run_id="$id"
                break
            fi
        done < <(gh run list --repo "$release_repo" --workflow sign.yml --event workflow_dispatch --limit 50 \
            --json databaseId,headSha --jq '.[] | "\(.databaseId) \(.headSha)"' || true)
        [[ -n "$run_id" ]] && break
        sleep "${MANAGED_MACHINE_RELEASE_POLL_SECONDS:-5}"
    done
    if [[ -z "$run_id" ]]; then
        echo "Error: the sign workflow run for ${head_sha:0:7} did not appear" >&2
        return 1
    fi
    echo "Approve the release deployment to sign $version: https://github.com/$release_repo/actions/runs/$run_id" >&2
    if ! gh run watch "$run_id" --repo "$release_repo" --exit-status >&2; then
        echo "Error: sign workflow run $run_id failed" >&2
        return 1
    fi
}

# Prints the signed darwin digest. Reuses an existing draft when it verifies
# against the local build; otherwise dispatches the sign workflow at
# origin/main and verifies its draft.
ensure_signed_dist() {
    local unsigned="$1" signed="$2" head_sha="$3" state
    state="$(draft_state)"
    if [[ "$state" == "false" ]]; then
        echo "Error: release $version is already published" >&2
        return 1
    fi
    if [[ "$state" == "true" ]] && download_signed_dist "$signed" >&2 \
        && verify_signed_dist "$unsigned" "$signed" 2>/dev/null; then
        return 0
    fi
    dispatch_sign "$head_sha" || return 1
    download_signed_dist "$signed" >&2 || return 1
    verify_signed_dist "$unsigned" "$signed"
}

write_formula() {
    local formula_path="$1" ver="$2" bare_ver="$3" cfg_sha="$4" core_sha="$5"
    python3 - "$formula_path" "$ver" "$bare_ver" "$cfg_sha" "$core_sha" <<'PY' || return 1
import re
import sys

formula_path, version, bare, config_sha, core_sha = sys.argv[1:6]
with open(formula_path, encoding="utf-8") as fh:
    text = fh.read()

core_url = f"https://github.com/qwts/managed-machine/releases/download/{version}/managed-machine_{bare}_darwin_arm64.tar.gz"

first_res = text.find('  resource "')
if first_res < 0:
    sys.exit(1)
head, rest = text[:first_res], text[first_res:]

head, n_tag = re.subn(
    r'^(\s*tag:\s*)"v[0-9]+\.[0-9]+\.[0-9]+"',
    rf'\1"{version}"',
    head,
    count=1,
    flags=re.MULTILINE,
)
head, n_ver = re.subn(
    r'^(\s*version\s+)"[0-9]+\.[0-9]+\.[0-9]+"',
    rf'\1"{bare}"',
    head,
    count=1,
    flags=re.MULTILINE,
)
if n_tag != 1 or n_ver != 1:
    sys.exit(1)

if not re.search(r"^\s*depends_on\s+arch:\s*:arm64\s*$", head, re.MULTILINE):
    head, n_lic = re.subn(
        r'^(\s*license\s+"MIT"\n)',
        r"\1\n  depends_on arch: :arm64\n  depends_on macos: :sequoia\n",
        head,
        count=1,
        flags=re.MULTILINE,
    )
    if n_lic != 1:
        sys.exit(1)

text = head + rest

def update_config_res(m: re.Match) -> str:
    block = m.group(0)
    block, n1 = re.subn(
        r'^(\s*tag:\s*)"v[0-9]+\.[0-9]+\.[0-9]+"',
        rf'\1"{version}"',
        block,
        count=1,
        flags=re.MULTILINE,
    )
    block, n2 = re.subn(
        r'^(\s*revision:\s*)"[0-9a-f]{40}"',
        rf'\1"{config_sha}"',
        block,
        count=1,
        flags=re.MULTILINE,
    )
    if n1 != 1 or n2 != 1:
        sys.exit(1)
    return block

text, n_cfg = re.subn(
    r'^\s*resource\s+"managed-machine-config"\s+do\b.*?^\s*end\s*$',
    update_config_res,
    text,
    count=1,
    flags=re.MULTILINE | re.DOTALL,
)
if n_cfg != 1:
    sys.exit(1)

core_resource_block = (
    '  # Prebuilt portable Go core binary for darwin/arm64 (S6 R04, S8 D3).\n'
    '  # Installed as bin/managed-machine; legacy Bash tree staged under libexec/legacy.\n'
    '  resource "core" do\n'
    f'    url "{core_url}"\n'
    f'    sha256 "{core_sha}"\n'
    '  end'
)
old_core_comment = (
    '  # Prebuilt portable Go core binary for darwin/arm64 (S6 R04, decisions D3/D4).\n'
    '  # Staged to libexec/core/managed-machine beside the Bash dispatcher.\n'
)
new_core_comment = (
    '  # Prebuilt portable Go core binary for darwin/arm64 (S6 R04, S8 D3).\n'
    '  # Installed as bin/managed-machine; legacy Bash tree staged under libexec/legacy.\n'
)
if old_core_comment in text:
    text = text.replace(old_core_comment, new_core_comment, 1)

if re.search(r'^\s*resource\s+"core"\s+do\s*$', text, re.MULTILINE):
    def update_core_res(m: re.Match) -> str:
        block = m.group(0)
        block, n1 = re.subn(
            r'^(\s*url\s+)"[^"]+"',
            rf'\1"{core_url}"',
            block,
            count=1,
            flags=re.MULTILINE,
        )
        block, n2 = re.subn(
            r'^(\s*sha256\s+)"[0-9a-f]{64}"',
            rf'\1"{core_sha}"',
            block,
            count=1,
            flags=re.MULTILINE,
        )
        if n1 != 1 or n2 != 1:
            sys.exit(1)
        return block

    text, n_core = re.subn(
        r'^\s*resource\s+"core"\s+do\b.*?^\s*end\s*$',
        update_core_res,
        text,
        count=1,
        flags=re.MULTILINE | re.DOTALL,
    )
    if n_core != 1:
        sys.exit(1)
else:
    placeholder = "  # No depends_on — setup scripts handle their own deps (brew, gh, etc.)"
    if placeholder in text:
        text = text.replace(placeholder, core_resource_block, 1)
    else:
        sys.exit(1)

d3_install_block = """  def install
    libexec.mkpath
    legacy = libexec / "legacy"
    legacy.mkpath

    # Install legacy macOS Bash orchestration files into libexec/legacy.
    (legacy / "bin").install "legacy/bin/managed-machine"
    legacy.install Dir["legacy/setup-*"]
    legacy.install "legacy/lib"
    (legacy / "scripts").install Dir["legacy/scripts/*"]
    (legacy / "git-hooks").install Dir["legacy/git-hooks/*"]

    # Bundle a managed-machine-config seed and the local-bin working repo under libexec/legacy.
    (legacy / "managed-machine-config").mkpath
    resource("managed-machine-config").stage(legacy / "managed-machine-config")

    (legacy / "local-bin").mkpath
    resource("local-bin").stage(legacy / "local-bin")

    # Transitional --update re-exec shim across the v0.10.x -> v0.11.0 layout
    # inversion (S8 D3(e)); removed in v0.12.0.
    (libexec / "scripts").mkpath
    (libexec / "scripts/update").write <<~SH
      #!/usr/bin/env bash
      exec "$(dirname "$0")/../legacy/scripts/update" "$@"
    SH
    chmod 0755, libexec / "scripts/update"

    # Install the signed AgentBotMachine.app bundle and link bin/managed-machine
    # into it: the daemon can use its keychain access group only when it runs
    # from the bundle that holds the provisioning profile. agent-machine is the
    # command alias.
    bin.mkpath
    resource("core").stage do
      prefix.install "AgentBotMachine.app"
    end
    bin.install_symlink prefix / "AgentBotMachine.app/Contents/MacOS/managed-machine"
    bin.install_symlink "managed-machine" => "agent-machine"

    # ENG-0055 skill bundle: `managed-machine --version` and `skill path`
    # resolve VERSION, skills/managed-machine and RELEASE_COMMIT from libexec.
    if File.exist?("VERSION")
      cp "VERSION", legacy / "VERSION"
      libexec.install "VERSION"
      (libexec / "skills").install "skills/managed-machine"
      commit = Utils.safe_popen_read("git", "-C", buildpath, "rev-parse", "HEAD").strip
      (libexec / "RELEASE_COMMIT").write "#{commit.match?(/\\A\\h{40}\\z/) ? commit : "unknown"}\\n"
    end
  end

  test do"""

if d3_install_block not in text:
    text, n_inst = re.subn(
        r"^[ \t]*def install[ \t]*\n.*?^[ \t]*test do[ \t]*$",
        lambda _m: d3_install_block,
        text,
        count=1,
        flags=re.MULTILINE | re.DOTALL,
    )
    if n_inst != 1:
        sys.exit(1)

d3_test_block = """  test do
    help_output = shell_output("#{bin}/managed-machine --help")
    assert_match "managed-machine", help_output
    assert_match "status", help_output
    assert_match "[legacy] adopt", help_output
    assert_predicate libexec/"legacy/setup-hostname", :executable?
    assert_predicate libexec/"scripts/update", :executable?

    # The failure path resolves libexec/legacy through the core exec seam and
    # must name the bad input.
    invalid = shell_output("#{bin}/managed-machine setup no-such-setup 2>&1", 1)
    assert_match "unknown setup name", invalid

    assert_equal version.to_s, shell_output("#{bin}/managed-machine --version").strip
    assert_equal version.to_s, shell_output("#{bin}/agent-machine --version").strip
    shell_output("#{bin}/managed-machine version")
    assert_predicate prefix/"AgentBotMachine.app/Contents/embedded.provisionprofile", :exist?
  end
end"""

if d3_test_block not in text:
    text, n_test = re.subn(
        r"^[ \t]*test do[ \t]*\n.*?^[ \t]*end[ \t]*\nend[ \t]*\n?\Z",
        lambda _m: d3_test_block + "\n",
        text,
        count=1,
        flags=re.MULTILINE | re.DOTALL,
    )
    if n_test != 1:
        sys.exit(1)

with open(formula_path, "w", encoding="utf-8") as fh:
    fh.write(text)
PY
}

# Validate that VERSION and Formula/managed-machine.rb match $version ($bare)
# and carry the S6 D4 / S8 D3 constraints, resources, install block, shim and
# test assertions. Prints the pinned managed-machine-config revision SHA on
# stdout when valid.
verify_formula_state() {
    local formula_path="$1" ver_file="$2" ver="$3" bare_ver="$4" want_cfg_sha="${5:-}" want_core_sha="${6:-}"
    python3 - "$formula_path" "$ver_file" "$ver" "$bare_ver" "$want_cfg_sha" "$want_core_sha" <<'PY' || return 1
import re
import sys

formula_path, ver_file, version, bare, want_cfg_sha, want_core_sha = sys.argv[1:7]
with open(ver_file, encoding="utf-8") as fh:
    got_ver_file = fh.read().strip()
if got_ver_file != bare:
    sys.exit(1)

with open(formula_path, encoding="utf-8") as fh:
    text = fh.read()
lines = text.splitlines()

if not re.search(r"^\s*depends_on\s+arch:\s*:arm64\s*$", text, re.MULTILINE):
    sys.exit(1)
if not re.search(r"^\s*depends_on\s+macos:\s*:sequoia\s*$", text, re.MULTILINE):
    sys.exit(1)

first_res = text.find('  resource "')
if first_res < 0:
    sys.exit(1)
head = text[:first_res]
if not re.search(rf'^\s*tag:\s*"{re.escape(version)}"\s*$', head, re.MULTILINE):
    sys.exit(1)
if not re.search(rf'^\s*version\s+"{re.escape(bare)}"\s*$', head, re.MULTILINE):
    sys.exit(1)

resources = {}
cur_name = None
cur_lines = []
for line in lines:
    m = re.match(r'^\s*resource\s+"([^"]+)"\s+do\s*$', line)
    if m:
        cur_name = m.group(1)
        cur_lines = []
        continue
    if cur_name is not None:
        if re.match(r"^\s*end\s*$", line):
            resources[cur_name] = "\n".join(cur_lines)
            cur_name = None
            continue
        cur_lines.append(line)

for req in ("managed-machine-config", "local-bin", "core"):
    if req not in resources:
        sys.exit(1)

cfg_block = resources["managed-machine-config"]
if not re.search(rf'^\s*tag:\s*"{re.escape(version)}"', cfg_block, re.MULTILINE):
    sys.exit(1)
rev_m = re.search(r'^\s*revision:\s*"([0-9a-f]{40})"', cfg_block, re.MULTILINE)
if not rev_m:
    sys.exit(1)
cfg_sha = rev_m.group(1)
if want_cfg_sha and cfg_sha != want_cfg_sha:
    sys.exit(1)

core_block = resources["core"]
want_url = f"https://github.com/qwts/managed-machine/releases/download/{version}/managed-machine_{bare}_darwin_arm64.tar.gz"
url_m = re.search(r'^\s*url\s+"([^"]+)"\s*$', core_block, re.MULTILINE)
if not url_m or url_m.group(1) != want_url:
    sys.exit(1)
sha_m = re.search(r'^\s*sha256\s+"([0-9a-f]{64})"\s*$', core_block, re.MULTILINE)
if not sha_m or sha_m.group(1) == "0" * 64:
    sys.exit(1)
if want_core_sha and sha_m.group(1) != want_core_sha:
    sys.exit(1)

for snippet in (
    'legacy = libexec / "legacy"',
    '(legacy / "bin").install "legacy/bin/managed-machine"',
    'legacy.install Dir["legacy/setup-*"]',
    'legacy.install "legacy/lib"',
    '(legacy / "scripts").install Dir["legacy/scripts/*"]',
    '(legacy / "git-hooks").install Dir["legacy/git-hooks/*"]',
    'resource("managed-machine-config").stage(legacy / "managed-machine-config")',
    'resource("local-bin").stage(legacy / "local-bin")',
    '(libexec / "scripts/update").write',
    'exec "$(dirname "$0")/../legacy/scripts/update" "$@"',
    'chmod 0755, libexec / "scripts/update"',
    'resource("core").stage',
    'prefix.install "AgentBotMachine.app"',
    'bin.install_symlink prefix / "AgentBotMachine.app/Contents/MacOS/managed-machine"',
    'bin.install_symlink "managed-machine" => "agent-machine"',
    'assert_predicate prefix/"AgentBotMachine.app/Contents/embedded.provisionprofile", :exist?',
    'cp "VERSION", legacy / "VERSION"',
    'assert_match "[legacy] adopt", help_output',
    'assert_predicate libexec/"legacy/setup-hostname", :executable?',
    'assert_predicate libexec/"scripts/update", :executable?',
    'assert_equal version.to_s, shell_output("#{bin}/managed-machine --version").strip',
    'assert_equal version.to_s, shell_output("#{bin}/agent-machine --version").strip',
    'shell_output("#{bin}/managed-machine version")',
):
    if snippet not in text:
        sys.exit(1)

for forbidden in (
    '(libexec / "core")',
    '#{libexec}/core/managed-machine --version',
    'bin.install "bin/managed-machine"',
    'bin.install "managed-machine"',
    'chmod 0755, bin / "managed-machine"',
    'if File.exist?("legacy/bin/managed-machine")',
    'if (libexec / "legacy").exist?',
):
    if forbidden in text:
        sys.exit(1)

print(cfg_sha)
PY
}

print_pr_command() {
    local rel_branch="$1"
    echo "Prepared $version on branch $rel_branch."
    echo "gh pr create --base main --head $rel_branch --title \"Release $version\" --body \"Release $version\""
}

if [[ "$subcmd" == "prepare" ]]; then
    if git ls-remote --exit-code --tags origin "refs/tags/$version" >/dev/null 2>&1; then
        echo "Error: tag $version already exists on origin — already released" >&2
        exit 1
    fi
    if git rev-parse --verify --quiet "refs/tags/$version" >/dev/null; then
        echo "Error: local tag $version already exists — remove it or choose a new version" >&2
        exit 1
    fi

    release_branch="release/$version"
    branch="$(git rev-parse --abbrev-ref HEAD)"
    if [[ "$branch" != "main" && "$branch" != "$release_branch" ]]; then
        echo "Error: releases are cut from main; this checkout is on '$branch' — git checkout main && git pull --ff-only, then rerun" >&2
        exit 1
    fi
    git fetch --quiet origin main
    origin_main_sha="$(git rev-parse origin/main)"

    if [[ "$branch" == "main" ]]; then
        if [[ "$(git rev-parse HEAD)" != "$origin_main_sha" ]]; then
            echo "Error: main is not at origin/main (local $(git rev-parse --short HEAD), origin $(git rev-parse --short origin/main)) — git pull --ff-only (or push what is unpublished), then rerun" >&2
            exit 1
        fi
        if git rev-parse --verify --quiet "refs/heads/$release_branch" >/dev/null; then
            if [[ "$(git rev-parse "refs/heads/$release_branch~1" 2>/dev/null || true)" == "$origin_main_sha" ]] \
                && [[ "$(git log -1 --format=%s "refs/heads/$release_branch")" == "Release $version" ]]; then
                git checkout --quiet "$release_branch"
                branch="$release_branch"
            fi
        fi
    fi

    tmp_dir="$(mktemp -d "${TMPDIR:-/tmp}/mm-release.XXXXXX")"
    trap 'rm -rf "$tmp_dir"' EXIT
    dist_dir="$tmp_dir/dist"
    signed_dir="$tmp_dir/signed"

    if [[ "$branch" == "$release_branch" ]]; then
        head_sha="$(git rev-parse HEAD)"
        parent_sha="$(git rev-parse HEAD~1 2>/dev/null || true)"
        if [[ "$parent_sha" == "$origin_main_sha" && "$(git log -1 --format=%s)" == "Release $version" ]]; then
            config_sha="$(verify_formula_state "$formula" "$version_file" "$version" "$bare" || true)"
            if [[ -z "$config_sha" ]]; then
                echo "Error: existing $release_branch commit has inconsistent formula or VERSION" >&2
                exit 1
            fi
            ensure_config_tag "$config_sha" || exit 1
            (cd "$go_root" && GOTOOLCHAIN=local go run ./cmd/mm-release build -version "$bare" -out "$dist_dir")
            if [[ "$(draft_state)" != "true" ]] || ! download_signed_dist "$signed_dir" \
                || ! verify_signed_dist "$dist_dir" "$signed_dir" -formula "$formula" -require-pin >/dev/null; then
                echo "Error: the signed draft $version does not match $release_branch — delete the branch and rerun prepare" >&2
                exit 1
            fi
            git push --quiet -u origin "$release_branch"
            print_pr_command "$release_branch"
            exit 0
        elif [[ "$head_sha" != "$origin_main_sha" ]]; then
            echo "Error: $release_branch is not based on origin/main (local $(git rev-parse --short HEAD), origin $(git rev-parse --short origin/main))" >&2
            exit 1
        fi
    fi

    # Validate and tag the sibling managed-machine-config checkout at $version.
    if [[ ! -d "$config_repo/.git" ]]; then
        echo "Error: managed-machine-config checkout not found at $config_repo — set MANAGED_MACHINE_CONFIG_DIR" >&2
        exit 1
    fi
    if [[ -n "$(git -C "$config_repo" status --porcelain)" ]]; then
        echo "Error: managed-machine-config working tree must be clean to release" >&2
        exit 1
    fi
    if [[ "$(git -C "$config_repo" rev-parse --abbrev-ref HEAD)" != "main" ]]; then
        echo "Error: managed-machine-config must be on main to release" >&2
        exit 1
    fi
    git -C "$config_repo" fetch --quiet origin main
    if [[ "$(git -C "$config_repo" rev-parse HEAD)" != "$(git -C "$config_repo" rev-parse origin/main)" ]]; then
        echo "Error: managed-machine-config main is not at origin/main — git -C $config_repo pull --ff-only, then rerun" >&2
        exit 1
    fi
    config_sha="$(git -C "$config_repo" rev-parse HEAD)"
    ensure_config_tag "$config_sha" || exit 1

    # Build the five deterministic archives, have the sign workflow sign and
    # notarize the darwin archive, and take the digest of the signed archive.
    (cd "$go_root" && GOTOOLCHAIN=local go run ./cmd/mm-release build -version "$bare" -out "$dist_dir")
    if ! darwin_sha="$(ensure_signed_dist "$dist_dir" "$signed_dir" "$origin_main_sha")" \
        || [[ ! "$darwin_sha" =~ ^[0-9a-f]{64}$ ]]; then
        echo "Error: no verified signed darwin archive for $version; release aborted" >&2
        exit 1
    fi

    printf '%s\n' "$bare" >"$version_file"
    if ! write_formula "$formula" "$version" "$bare" "$config_sha" "$darwin_sha" \
        || ! verify_formula_state "$formula" "$version_file" "$version" "$bare" "$config_sha" "$darwin_sha" >/dev/null; then
        git checkout -- "$formula" "$version_file"
        echo "Error: version fields not found where expected — formula/VERSION format changed; release aborted, files restored" >&2
        exit 1
    fi
    if ! verify_signed_dist "$dist_dir" "$signed_dir" -formula "$formula" -require-pin >/dev/null; then
        git checkout -- "$formula" "$version_file"
        echo "Error: mm-release verify-signed -require-pin failed; release aborted, files restored" >&2
        exit 1
    fi

    git checkout --quiet -B "$release_branch"
    git add "$formula" "$version_file"
    git commit -m "Release $version"
    git push --quiet -u origin "$release_branch"
    print_pr_command "$release_branch"
    exit 0
fi

# Subcommand: tag
git fetch --quiet origin main
origin_main_sha="$(git rev-parse origin/main)"
head_sha="$(git rev-parse HEAD)"
branch="$(git rev-parse --abbrev-ref HEAD)"

if [[ "$head_sha" != "$origin_main_sha" ]]; then
    if [[ "$branch" != "main" ]]; then
        echo "Error: releases are cut from main; this checkout is on '$branch' and HEAD (${head_sha:0:7}) is not at origin/main (${origin_main_sha:0:7}) — git checkout main && git pull --ff-only, then rerun" >&2
    else
        echo "Error: main is not at origin/main (local ${head_sha:0:7}, origin ${origin_main_sha:0:7}) — git pull --ff-only (or push what is unpublished), then rerun" >&2
    fi
    exit 1
fi
if [[ "$branch" == "release/$version" ]]; then
    git checkout --quiet -B main origin/main
    branch="main"
fi
if [[ "$branch" != "main" ]]; then
    echo "Error: releases are cut from main; this checkout is on '$branch' — git checkout main && git pull --ff-only, then rerun" >&2
    exit 1
fi

if git ls-remote --exit-code --tags origin "refs/tags/$version" >/dev/null 2>&1; then
    echo "Error: tag $version already exists on origin — already released" >&2
    exit 1
fi
if git rev-parse --verify --quiet "refs/tags/$version" >/dev/null; then
    echo "Error: local tag $version already exists" >&2
    exit 1
fi

got_version_file="$(tr -d '[:space:]' <"$version_file")"
if [[ "$got_version_file" != "$bare" ]]; then
    echo "Error: VERSION is '$got_version_file', expected '$bare'" >&2
    exit 1
fi

config_sha="$(verify_formula_state "$formula" "$version_file" "$version" "$bare" || true)"
if [[ -z "$config_sha" ]]; then
    echo "Error: Formula/managed-machine.rb disagrees with $version" >&2
    exit 1
fi

remote_sha="$(remote_config_tag_sha || true)"
if [[ -z "$remote_sha" ]]; then
    echo "Error: managed-machine-config tag $version was not found on origin (expected $config_sha)" >&2
    exit 1
fi
if [[ "$remote_sha" != "$config_sha" ]]; then
    echo "Error: managed-machine-config tag $version on origin points at ${remote_sha:0:7}, expected ${config_sha:0:7}" >&2
    exit 1
fi

tmp_dir="$(mktemp -d "${TMPDIR:-/tmp}/mm-release.XXXXXX")"
trap 'rm -rf "$tmp_dir"' EXIT
dist_dir="$tmp_dir/dist"
signed_dir="$tmp_dir/signed"
(cd "$go_root" && GOTOOLCHAIN=local go run ./cmd/mm-release build -version "$bare" -out "$dist_dir")
if [[ "$(draft_state)" != "true" ]]; then
    echo "Error: no signed draft release $version — run scripts/release prepare $version" >&2
    exit 1
fi
download_signed_dist "$signed_dir"
if ! verify_signed_dist "$dist_dir" "$signed_dir" -formula "$formula" -require-pin >/dev/null; then
    echo "Error: Formula/managed-machine.rb core pin disagrees with the signed draft for $version" >&2
    exit 1
fi

# Annotated, not lightweight: ssh enroll --signing sets tag.gpgSign, which
# makes git create a signed tag and demand a message. A bare `git tag` then
# aborts with "no tag message?" and opens an editor where there is none.
git tag -a -m "Release $version" "$version"
git push origin "refs/tags/$version"

echo "Released $version — annotated tag pushed."
