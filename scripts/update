#!/usr/bin/env bash
# Update managed-machine: brew update/upgrade + re-run safe setup steps.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
REPO_ROOT="$ROOT"
# shellcheck source=lib/install.sh
source "$ROOT/lib/install.sh"
# shellcheck source=lib/agent-bot-gh.sh
source "$ROOT/lib/agent-bot-gh.sh"

# An update authenticates to GitHub as the human throughout: brew fetches
# the private fleet taps with the invoking user's gh token, and setup-gh
# checks and refreshes that account. Inside an agent harness the gh shim
# refuses stock human gh outside bot territory, so none of that can work;
# the run would spend the brew dialogs on an unauthenticated fetch and then
# abort at setup-gh. Refuse up front, before any dialog, with the remedy.
if managed_machine_agent_session && [[ -z "${MANAGED_MACHINE_UPDATE_REEXECED:-}" ]]; then
    echo "Skipped: managed-machine --update does not run from an agent session — the gh shim refuses the human's GitHub auth outside bot territory, so brew's private taps and setup-gh cannot authenticate. Run it from a human Terminal." >&2
    exit "${MANAGED_MACHINE_SKIPPED_EXIT:-76}"
fi

# 1. Brew update + upgrade (formula-managed packages). The writable private
# config checkout lives outside Homebrew, so replacing the bundled seed cannot
# discard fleet state.
#
# ROOT resolves through $prefix/opt/managed-machine/libexec, the symlink brew
# repoints during the upgrade. Sourcing on both sides of that swap would leave
# this process holding libraries from two versions at once — the pre-upgrade
# ones already read, the rest read after — so any release that changes a
# contract between two such libraries breaks the upgrading run, and only that
# run. Re-exec instead, so everything past the upgrade is one version.
if [[ -z "${MANAGED_MACHINE_UPDATE_REEXECED:-}" ]]; then
    if command -v brew >/dev/null 2>&1; then
        echo "==> brew update"
        brew_run update
        echo "==> brew upgrade managed-machine"
        brew_run upgrade managed-machine 2>/dev/null || echo "managed-machine already up to date"
    else
        echo "skip: brew not found" >&2
    fi
    # Re-exec by path, not $0: the upgrade may have replaced this very script.
    export MANAGED_MACHINE_UPDATE_REEXECED=1
    exec "$ROOT/scripts/update" "$@"
fi

# shellcheck source=lib/bootstrap.sh
source "$ROOT/lib/bootstrap.sh"
# shellcheck source=lib/migrate.sh
source "$ROOT/lib/migrate.sh"
# shellcheck source=lib/apps.sh
source "$ROOT/lib/apps.sh"
# shellcheck source=lib/hostname.sh
source "$ROOT/lib/hostname.sh"

CONFIG_REPO_ROOT="$(managed_machine_config_repo_dir)"
export CONFIG_REPO_ROOT

# Every step's outcome is recorded in update.manifest, the same shape as
# bootstrap.manifest, so `managed-machine status` shows what the last
# update did and a failed step is visible after the fact instead of taking
# the rest of the run with it silently.
status_file="$(managed_machine_config_dir)/update.manifest"
status_dir="$(dirname "$status_file")"
mkdir -p "$status_dir"
chmod 700 "$status_dir"
status_tmp="$(mktemp "${status_file}.XXXXXX")"
trap 'rm -f "$status_tmp"' EXIT
chmod 600 "$status_tmp"
{
    echo 'schema_version=1'
    printf 'version=%s\n' "$(brew list --versions managed-machine 2>/dev/null | awk 'NR==1{print $2}')"
    printf 'started_at=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
} >"$status_tmp"

failed_names=()
skipped_names=()

record_status() {
    printf '%s\t%s\t%s\n' "$1" "$2" "$3" >>"$status_tmp"
    case "$1" in
        failed) failed_names+=("$2") ;;
        skipped) skipped_names+=("$2") ;;
    esac
}

# run_one <name> <command...>: run a step, record its outcome, keep going.
# A deferred or skipped exit is a skip, anything else nonzero is a failure
# reported at the end; later steps still run, since they do not depend on
# an earlier one having succeeded.
run_one() {
    local name="$1" result=0
    shift
    echo "==> $name"
    if "$@"; then
        record_status complete "$name" ""
    else
        result=$?
        if [[ "$result" -eq "$MANAGED_MACHINE_DEFERRED_EXIT" || "$result" -eq "$MANAGED_MACHINE_SKIPPED_EXIT" ]]; then
            record_status skipped "$name" "exit status $result"
        else
            echo "failed: $name exited with status $result" >&2
            record_status failed "$name" "exit status $result"
        fi
    fi
}

run_one migrations run_managed_machine_migrations

# 2. Re-run safe, idempotent setup steps. setup-gh synchronizes the persistent
# config checkout first, so setup-zsh and setup-bin read current templates
# and the local-bin pin. setup-zsh backs up stale PATH profiles and is a
# no-op on already-guarded files.
SAFE_STEPS=(
    setup-gh
    setup-zsh
    setup-bin
)

for name in "${SAFE_STEPS[@]}"; do
    script="$ROOT/$name"
    if [[ ! -x "$script" ]]; then
        echo "skip: $name not found or not executable" >&2
        record_status skipped "$name" "script missing or not executable"
        continue
    fi
    run_one "$name" "$script"
done

while IFS= read -r app_name; do
    [[ -n "$app_name" ]] || continue
    run_one "setup-$app_name" install_catalog_app "$app_name"
done < <(catalog_auto_app_names 2>/dev/null || true)

# setup-zsh can replace PATH startup files after setup-gh has converged the
# explicit interposer. Re-run the opt-in action last so both shell shims and
# direct Codex desktop coverage survive managed-machine and runtime upgrades.
if agent_bot_gh_is_configured; then
    run_one setup-agent-bot-gh repair_agent_bot_gh_if_configured
fi

printf 'finished_at=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >>"$status_tmp"
mv "$status_tmp" "$status_file"
trap - EXIT

if [[ ${#skipped_names[@]} -gt 0 ]]; then
    echo "Skipped: ${skipped_names[*]}"
fi
if [[ ${#failed_names[@]} -gt 0 ]]; then
    echo "Update finished with failures: ${failed_names[*]} — see the output above; 'managed-machine status' keeps this outcome" >&2
    exit 1
fi
echo "Update complete."
