#!/usr/bin/env bash
# Update managed-machine: brew update/upgrade + re-run safe setup steps.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
REPO_ROOT="$ROOT"
# shellcheck source=lib/install.sh
source "$ROOT/lib/install.sh"

# 1. If managed-machine-config is a working git repo with uncommitted changes,
#    warn and stop. A brew upgrade will replace the bundled clone and any
#    uncommitted dotfile/authorized_keys edits will be lost.
if [[ -d "$ROOT/managed-machine-config" ]]; then
    CONFIG_REPO_ROOT="$(managed_machine_config_repo_dir)"
    if [[ -d "$CONFIG_REPO_ROOT/.git" ]]; then
        dirty="$(git -C "$CONFIG_REPO_ROOT" status --short)"
        if [[ -n "$dirty" ]]; then
            cat >&2 <<EOF
Error: $CONFIG_REPO_ROOT has uncommitted changes.
brew upgrade will replace this bundled clone and the uncommitted work will be lost.
Commit and push the changes, then re-run:

  cd $CONFIG_REPO_ROOT
  git add -A
  git commit -m "..."
  git push
  managed-machine --update

EOF
            exit 1
        fi
    fi
fi

# 2. Brew update + upgrade (formula-managed packages).
if command -v brew >/dev/null 2>&1; then
    echo "==> brew update"
    brew update
    echo "==> brew upgrade managed-machine"
    brew upgrade managed-machine 2>/dev/null || echo "managed-machine already up to date"
else
    echo "skip: brew not found" >&2
fi

# 3. Pull the bundled managed-machine-config clone so fleet authorized_keys
#    changes from other machines are visible before setup-gh re-syncs.
CONFIG_REPO_ROOT="$(managed_machine_config_repo_dir)"
if [[ -d "$CONFIG_REPO_ROOT/.git" ]]; then
    echo "==> pulling managed-machine-config"
    git -C "$CONFIG_REPO_ROOT" pull --ff-only --quiet
fi

# 4. Re-run safe, idempotent setup steps.
# setup-bin: pulls new local-bin pin and re-links tools.
# setup-gh: refreshes auth and syncs authorized_keys.
# Destructive/interactive steps (setup-zsh, setup-codex) are skipped —
# they only install when missing and never overwrite existing files.
SAFE_STEPS=(
    setup-bin
    setup-gh
)

for name in "${SAFE_STEPS[@]}"; do
    script="$ROOT/$name"
    if [[ ! -x "$script" ]]; then
        echo "skip: $name not found or not executable" >&2
        continue
    fi
    echo "==> $name"
    "$script"
done

echo "Update complete."
