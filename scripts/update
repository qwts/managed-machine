#!/usr/bin/env bash
# Update managed-machine: brew update/upgrade + re-run safe setup steps.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
REPO_ROOT="$ROOT"
# shellcheck source=lib/install.sh
source "$ROOT/lib/install.sh"

# An update authenticates to GitHub as the human throughout: brew fetches
# the private fleet taps with the invoking user's gh token, and setup-gh
# checks and refreshes that account. An agent session has no such token,
# and an agent account (ENG-0339) signs into nothing as the human. None of that
# can work; the run would spend the brew dialogs on an unauthenticated
# fetch and then abort at setup-gh. Refuse up front, before any dialog,
# with the remedy.
if managed_machine_agent_session && [[ -z "${MANAGED_MACHINE_UPDATE_REEXECED:-}" ]]; then
    echo "Skipped: managed-machine --update does not run from an agent session — the human's GitHub auth is not available to a harness or to an agent account, so brew's private taps and setup-gh cannot authenticate. Run it from a human Terminal in the owner's account." >&2
    exit "${MANAGED_MACHINE_SKIPPED_EXIT:-76}"
fi

# 1. Brew update + upgrade (formula-managed packages). The writable private
# config checkout lives outside Homebrew, so replacing the bundled seed cannot
# discard fleet state.
#
# ROOT resolves through $prefix/opt/managed-machine/libexec, the symlink brew
# repoints during the upgrade. Sourcing on both sides of that swap would leave
# this process holding libraries from two versions at once — the pre-upgrade
# ones already read, the rest read after — so any release that changes a
# contract between two such libraries breaks the upgrading run, and only that
# run. Re-exec instead, so everything past the upgrade is one version.
#
# One approval (#174): brew update and the managed-machine upgrade share one
# authorization, and a declined dialog anywhere in the run is remembered in
# MANAGED_MACHINE_ELEVATION_DECLINED_FILE (inherited across the re-exec and
# by every setup step), so no later step asks again.
if [[ -z "${MANAGED_MACHINE_UPDATE_REEXECED:-}" ]]; then
    MANAGED_MACHINE_ELEVATION_DECLINED_FILE="$(mktemp -d)/declined"
    export MANAGED_MACHINE_ELEVATION_DECLINED_FILE
    if command -v brew >/dev/null 2>&1; then
        brew_bin="$(command -v brew)"
        echo "==> brew update && brew upgrade managed-machine"
        brew_run_script "$(printf '%q update && { %q upgrade managed-machine 2>/dev/null || echo "managed-machine already up to date"; }' "$brew_bin" "$brew_bin")" \
            || echo "warn: brew update/upgrade did not complete" >&2
    else
        echo "skip: brew not found" >&2
    fi
    # Re-exec by path, not $0: the upgrade may have replaced this very script.
    export MANAGED_MACHINE_UPDATE_REEXECED=1
    exec "$ROOT/scripts/update" "$@"
fi

# shellcheck source=lib/bootstrap.sh
source "$ROOT/lib/bootstrap.sh"
# shellcheck source=lib/migrate.sh
source "$ROOT/lib/migrate.sh"
# shellcheck source=lib/apps.sh
source "$ROOT/lib/apps.sh"
# shellcheck source=lib/hostname.sh
source "$ROOT/lib/hostname.sh"

CONFIG_REPO_ROOT="$(managed_machine_config_repo_dir)"
export CONFIG_REPO_ROOT REPO_ROOT

# Every step's outcome is recorded in update.manifest, the same shape as
# bootstrap.manifest, so `managed-machine status` shows what the last
# update did and a failed step is visible after the fact instead of taking
# the rest of the run with it silently.
status_file="$(managed_machine_config_dir)/update.manifest"
status_dir="$(dirname "$status_file")"
mkdir -p "$status_dir"
chmod 700 "$status_dir"
status_tmp="$(mktemp "${status_file}.XXXXXX")"
plan_session_dir=""
cleanup_update() {
    rm -f "$status_tmp"
    [[ -z "$plan_session_dir" ]] || rm -rf "$plan_session_dir"
    if [[ "${MANAGED_MACHINE_ELEVATION_DECLINED_FILE:-}" == */declined ]]; then
        rm -rf "$(dirname "$MANAGED_MACHINE_ELEVATION_DECLINED_FILE")"
    fi
}
trap cleanup_update EXIT
chmod 600 "$status_tmp"
{
    echo 'schema_version=1'
    printf 'version=%s\n' "$(brew list --versions managed-machine 2>/dev/null | awk 'NR==1{print $2}')"
    printf 'started_at=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
} >"$status_tmp"

failed_names=()
skipped_names=()
plan_id=""

record_status() {
    printf '%s\t%s\t%s\n' "$1" "$2" "$3" >>"$status_tmp"
    case "$1" in
        failed) failed_names+=("$2") ;;
        skipped) skipped_names+=("$2") ;;
    esac
}

complete_detail_for() {
    local name="$1"
    if [[ -n "$plan_id" && -n "$plan_session_dir" ]] && declare -F bootstrap_plan_summary_for_step >/dev/null; then
        bootstrap_plan_summary_for_step "$plan_id" "$plan_session_dir" "$name" 2>/dev/null && return 0
    fi
    printf '\n'
}

# run_one <name> <command...>: run a step, record its outcome, keep going.
# A deferred or skipped exit is a skip, anything else nonzero is a failure
# reported at the end; later steps still run, since they do not depend on
# an earlier one having succeeded.
run_one() {
    local name="$1" result=0
    shift
    echo "==> $name"
    if MANAGED_MACHINE_CURRENT_STEP="$name" MANAGED_MACHINE_IN_BATCH_RUN=1 "$@"; then
        record_status complete "$name" "$(complete_detail_for "$name")"
    else
        result=$?
        if [[ "$result" -eq "$MANAGED_MACHINE_DEFERRED_EXIT" || "$result" -eq "$MANAGED_MACHINE_SKIPPED_EXIT" ]]; then
            record_status skipped "$name" "not part of this install"
        else
            echo "failed: $name exited with status $result" >&2
            record_status failed "$name" "exit status $result"
        fi
    fi
}

# 2. Re-run safe, idempotent setup steps. setup-gh refreshes the persistent
# config checkout first, so setup-zsh, setup-bin, and setup-zsh-functions read
# current templates and pins. setup-zsh
# backs up stale PATH profiles and is a no-op on already-guarded files.
SAFE_STEPS=(
    setup-gh
    setup-zsh
    setup-bin
    setup-zsh-functions
)

auto_app_names=()
while IFS= read -r app_name; do
    [[ -n "$app_name" ]] || continue
    auto_app_names+=("$app_name")
done < <(catalog_auto_app_names 2>/dev/null || true)

if declare -F bootstrap_build_plan >/dev/null; then
    plan_session_dir="$(mktemp -d "${TMPDIR:-/tmp}/mm-update-plan.XXXXXX")"
    chmod 700 "$plan_session_dir"
    plan_id="$(bootstrap_new_plan_id update)"
    if [[ -z "${MANAGED_MACHINE_ELEVATION_DECLINED_FILE:-}" ]]; then
        MANAGED_MACHINE_ELEVATION_DECLINED_FILE="$plan_session_dir/declined"
        export MANAGED_MACHINE_ELEVATION_DECLINED_FILE
    fi

    update_plan_steps=(migrations "${SAFE_STEPS[@]}")
    if [[ ${#auto_app_names[@]} -gt 0 ]]; then
        for app_name in "${auto_app_names[@]}"; do
            update_plan_steps+=("setup-$app_name")
        done
    fi
    bootstrap_build_plan "$plan_session_dir" "${update_plan_steps[@]}"
    bootstrap_print_plan "update" "$plan_id" "$plan_session_dir"

    if [[ -e "$MANAGED_MACHINE_ELEVATION_DECLINED_FILE" ]]; then
        # The owner already cancelled the pre-re-exec brew dialog; do not
        # prompt again for privileged work in this run (#174).
        bootstrap_record_declined_plan_apps "$plan_session_dir" "authorization declined"
    else
        if ! bootstrap_confirm_plan "$plan_id" "$plan_session_dir"; then
            : >"$MANAGED_MACHINE_ELEVATION_DECLINED_FILE" 2>/dev/null || true
            bootstrap_record_declined_plan_apps "$plan_session_dir" "plan declined"
            exit 1
        fi
        if bootstrap_plan_has_privileged_actions "$plan_session_dir"; then
            if ! bootstrap_stage_and_authorize_plan "$plan_id" "$plan_session_dir" "apply approved update plan $plan_id"; then
                if [[ -e "$MANAGED_MACHINE_ELEVATION_DECLINED_FILE" ]]; then
                    bootstrap_record_declined_plan_apps "$plan_session_dir" "authorization declined"
                fi
            fi
        fi
    fi

    bootstrap_record_plan_manifest_lines "$plan_id" "$plan_session_dir" "$status_tmp"
    MANAGED_MACHINE_APPROVED_PLAN_FILE="$plan_session_dir/actions.tsv"
    MANAGED_MACHINE_PLAN_SESSION_DIR="$plan_session_dir"
    MANAGED_MACHINE_PLAN_ID="$plan_id"
    export MANAGED_MACHINE_APPROVED_PLAN_FILE MANAGED_MACHINE_PLAN_SESSION_DIR MANAGED_MACHINE_PLAN_ID
fi

run_one migrations run_managed_machine_migrations

for name in "${SAFE_STEPS[@]}"; do
    script="$ROOT/$name"
    if [[ ! -x "$script" ]]; then
        echo "skip: $name not found or not executable" >&2
        record_status skipped "$name" "script missing or not executable"
        continue
    fi
    run_one "$name" "$script"
done

if [[ ${#auto_app_names[@]} -gt 0 ]]; then
    for app_name in "${auto_app_names[@]}"; do
        run_one "setup-$app_name" install_catalog_app "$app_name"
    done
fi

printf 'finished_at=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >>"$status_tmp"
mv "$status_tmp" "$status_file"
cleanup_update
trap - EXIT

if [[ ${#skipped_names[@]} -gt 0 ]]; then
    echo "Skipped: ${skipped_names[*]}"
fi
if [[ ${#failed_names[@]} -gt 0 ]]; then
    echo "Update finished with failures: ${failed_names[*]} — see the output above; 'managed-machine status' keeps this outcome" >&2
    exit 1
fi
echo "Update complete."
