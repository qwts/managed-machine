#!/usr/bin/env bash
# Read-only inventory of managed-machine pins and installed tool versions.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
REPO_ROOT="$ROOT"
# shellcheck source=lib/install.sh
source "$ROOT/lib/install.sh"
# shellcheck source=lib/cask-app.sh
source "$ROOT/lib/cask-app.sh"
# shellcheck source=lib/vendor-dmg.sh
source "$ROOT/lib/vendor-dmg.sh"
# shellcheck source=lib/agent-account.sh
source "$ROOT/lib/agent-account.sh"

STATUS_JSON=0
STATUS_RECORDS=""
STATUS_CURRENT_SECTION=""

usage() {
    cat <<'EOF'
Usage: managed-machine status [--json] [--section <name>...]

Print installed versions, pins, and last bootstrap outcomes. Read-only:
does not upgrade, set up, or mutate fleet state. Missing tools are reported
as missing; the command still exits 0.

Options:
  --json            emit structured JSON output and error envelopes
  --section <name>  filter to one or more sections (managed-machine, machine,
                    ssh, bootstrap, update, agent-accounts, local-bin,
                    zsh-functions, pins, toolchain, homebrew, gh, nvm, node,
                    hostname, rustup, rustc, cargo, catalog)
EOF
}

# Peek at the persistent/sibling checkout without materializing or syncing it.
status_config_checkout() {
    local sibling
    if [[ -n "${CONFIG_REPO_ROOT:-}" ]]; then
        printf '%s\n' "$CONFIG_REPO_ROOT"
        return 0
    fi
    sibling="$REPO_ROOT/../managed-machine-config"
    if [[ -f "$sibling/local-bin.ref" ]]; then
        printf '%s\n' "$sibling"
        return 0
    fi
    printf '%s\n' "$(managed_machine_config_checkout_dir)"
}

toml_field() {
    local file="$1"
    local key="$2"
    [[ -f "$file" ]] || return 0
    sed -n "s/^${key} = \"\(.*\)\"$/\1/p" "$file" | head -1
}

manifest_field() {
    local file="$1"
    local key="$2"
    [[ -f "$file" ]] || return 0
    sed -n "s/^${key}=//p" "$file" | head -1
}

sanitize_version() {
    local s="${1-}"
    s="$(printf '%s' "$s" | tr '\r\n' '  ' | sed 's/[[:space:]]\{1,\}/ /g; s/^[[:space:]]*//; s/[[:space:]]*$//')"
    if [[ ${#s} -gt 200 ]]; then
        s="${s:0:200}"
    fi
    printf '%s\n' "$s"
}

emit() {
    if [[ "$STATUS_JSON" == 1 && -n "$STATUS_RECORDS" ]]; then
        printf 'row\t%s\t%s\t%s\n' "$STATUS_CURRENT_SECTION" "$1" "$2" >>"$STATUS_RECORDS"
    else
        printf '%-18s %s\n' "$1" "$2"
    fi
}

first_line_version() {
    local out=""
    out="$("$@" 2>/dev/null | head -1 || true)"
    sanitize_version "$out"
    return 0
}

cmd_version() {
    local cmd="$1"
    shift
    if ! command -v "$cmd" >/dev/null 2>&1; then
        printf 'missing\n'
        return 0
    fi
    local out
    out="$(first_line_version "$cmd" "$@")"
    if [[ -z "$out" ]]; then
        printf 'installed (version unknown)\n'
        return 0
    fi
    printf '%s\n' "$out"
}

pin_annotation() {
    local ref="$1"
    case "$ref" in
        main|master|develop|HEAD|*/*)
            printf '%s (moving branch)\n' "$ref"
            ;;
        *)
            printf '%s\n' "$ref"
            ;;
    esac
}

ensure_status_path() {
    export_local_bin_to_path
    export_cargo_bin_to_path
    local prefix brew_rustup
    if ! command -v brew >/dev/null 2>&1; then
        for prefix in /opt/homebrew /usr/local; do
            if [[ -x "$prefix/bin/brew" ]]; then
                PATH="$prefix/bin:$PATH"
                export PATH
                break
            fi
        done
    fi
    if command -v rustup >/dev/null 2>&1; then
        return 0
    fi
    for prefix in "${HOMEBREW_PREFIX:-}" /opt/homebrew /usr/local; do
        [[ -n "$prefix" && -x "$prefix/opt/rustup/bin/rustup" ]] || continue
        brew_rustup="$prefix/opt/rustup/bin"
        PATH="$brew_rustup:$PATH"
        export PATH
        break
    done
}

# npm global binaries live in $(npm prefix -g)/bin, which is not on the PATH of
# a status invocation. Resolve it once and prepend so npm-kind rows can be
# reported like any other command-based app.
prepend_npm_bin_dir() {
    if command -v npm >/dev/null 2>&1; then
        local npm_prefix
        if npm_prefix="$(npm prefix -g 2>/dev/null)"; then
            PATH="$npm_prefix/bin:$PATH"
            export PATH
        fi
    fi
}

managed_machine_version() {
    local brew_ver="" file_ver=""
    if command -v brew >/dev/null 2>&1; then
        brew_ver="$(brew list --versions managed-machine 2>/dev/null | awk 'NR == 1 { print $2 }' || true)"
        brew_ver="$(sanitize_version "$brew_ver")"
    fi
    if [[ -f "$ROOT/Formula/managed-machine.rb" ]]; then
        file_ver="$(sed -nE 's/^[[:space:]]*version "([0-9.]+)"$/\1/p' "$ROOT/Formula/managed-machine.rb" | head -1)"
        file_ver="$(sanitize_version "$file_ver")"
    fi
    if [[ -n "$brew_ver" ]]; then
        emit "managed-machine" "$brew_ver"
        if [[ -n "$file_ver" && "$file_ver" != "$brew_ver" ]]; then
            emit "  checkout" "$file_ver"
        fi
        return 0
    fi
    if [[ -n "$file_ver" ]]; then
        emit "managed-machine" "$file_ver (checkout)"
        return 0
    fi
    emit "managed-machine" "missing"
}

# Read-only SSH enrollment probe built from local state only — never lists
# GitHub keys, never touches ssh-agent. "not enrolled" after a default setup
# is expected, not a failure: SSH enrollment is the explicit human-only
# `managed-machine ssh enroll` action (#120).
#
# GitHub SSH (key/signing) and fleet SSH (machine-to-machine) are reported
# separately in an agent context: agent accounts are refused GitHub SSH
# enrollment by policy (ssh_enroll_validate_account), but fleet/machine-to-
# machine SSH is not the same eligibility question, so folding both into one
# "not enrolled" line would misstate the agent account as ineligible for
# something it was never asked about.
ssh_enrollment_status() {
    local key_path="${HOME}/.ssh/id_rsa_github"
    local state machine_id
    local -a enrolled=()

    state="$(managed_machine_config_dir)/machine.toml"
    machine_id=""
    [[ -f "$state" ]] && machine_id="$(toml_field "$state" machine_id)"

    if agent_current_context 2>/dev/null; then
        if [[ -f "$key_path" || -f "${key_path}.pub" ]]; then
            emit "ssh" "github: not eligible (agent account — GitHub SSH is human-only); warn: key material present at $key_path"
        else
            emit "ssh" "github: not eligible (agent account — GitHub SSH is human-only)"
        fi
        if [[ -n "$machine_id" ]]; then
            emit "  fleet" "enrolled ($machine_id) — machine-to-machine SSH, separate from GitHub SSH"
        elif agent_provisioned_account 2>/dev/null; then
            # A provisioned agent account has its own $HOME, so absence here
            # says nothing about the human account's actual fleet state.
            emit "  fleet" "indeterminate as agent (fleet enrollment is recorded in the human account, not here)"
        else
            # Session markers only (e.g. a harness running in the human
            # owner's own account): this $HOME IS where enrollment would be
            # recorded, so absence here is authoritative.
            emit "  fleet" "not registered (managed-machine ssh enroll --fleet) — machine-to-machine SSH, separate from GitHub SSH"
        fi
        return 0
    fi

    [[ -f "$key_path" && -f "${key_path}.pub" ]] && enrolled+=('key')
    if [[ "$(git config --global --get gpg.format 2>/dev/null || true)" == "ssh" \
        && -n "$(git config --global --get user.signingkey 2>/dev/null || true)" ]]; then
        enrolled+=('signing')
    fi
    [[ -n "$machine_id" ]] && enrolled+=('fleet')
    if [[ ${#enrolled[@]} -eq 0 ]]; then
        emit "ssh" "not enrolled (explicit opt-in: managed-machine ssh enroll)"
    else
        emit "ssh" "enrolled: ${enrolled[*]}"
    fi
}

# machine.toml lives under this account's own config dir — for a human
# account that is where fleet enrollment was recorded, but a provisioned
# agent account has its own separate $HOME and never enrolls the machine
# itself (#120), so an absent file there proves nothing about whether the
# machine (enrolled under the human account) is actually registered. Report
# that honestly instead of "missing", which reads as never enrolled.
#
# This must key off agent_provisioned_account, not agent_current_context: a
# harness running with session markers inside the human owner's own account
# has a $HOME that IS the account this machine enrolls under, so an absent
# file there genuinely means "missing", not "recorded elsewhere".
machine_status() {
    local state hostname machine_id
    state="$(managed_machine_config_dir)/machine.toml"
    if [[ ! -f "$state" ]]; then
        if agent_provisioned_account 2>/dev/null; then
            printf 'indeterminate as agent (fleet enrollment is recorded in the human account, not here)\n'
        else
            printf 'missing\n'
        fi
        return 0
    fi
    machine_id="$(toml_field "$state" machine_id)"
    hostname="$(toml_field "$state" hostname)"
    if [[ -z "$machine_id" ]]; then
        if agent_provisioned_account 2>/dev/null; then
            printf 'indeterminate as agent (fleet enrollment is recorded in the human account, not here)\n'
        else
            printf 'missing\n'
        fi
        return 0
    fi
    if [[ -n "$hostname" ]]; then
        printf '%s (%s)\n' "$machine_id" "$hostname"
    else
        printf '%s\n' "$machine_id"
    fi
}

bootstrap_status() {
    local file mode finished complete deferred skipped failed status name
    file="$(managed_machine_config_dir)/bootstrap.manifest"
    if [[ ! -f "$file" ]]; then
        emit "bootstrap" "missing"
        return 0
    fi
    mode="$(manifest_field "$file" mode)"
    finished="$(manifest_field "$file" finished_at)"
    complete=""
    deferred=""
    skipped=""
    failed=""
    while IFS=$'\t' read -r status name _; do
        case "$status" in
            complete) complete="${complete:+$complete, }$name" ;;
            deferred) deferred="${deferred:+$deferred, }$name" ;;
            skipped) skipped="${skipped:+$skipped, }$name" ;;
            failed) failed="${failed:+$failed, }$name" ;;
        esac
    done <"$file"
    if [[ -n "$mode" && -n "$finished" ]]; then
        emit "bootstrap" "$mode  $finished"
    elif [[ -n "$mode" ]]; then
        emit "bootstrap" "$mode"
    else
        emit "bootstrap" "present"
    fi
    [[ -n "$complete" ]] && emit "  complete" "$complete"
    [[ -n "$deferred" ]] && emit "  deferred" "$deferred"
    [[ -n "$skipped" ]] && emit "  skipped" "$skipped"
    [[ -n "$failed" ]] && emit "  failed" "$failed"
    return 0
}

# The last --update run, from update.manifest (same shape as the bootstrap
# manifest). Absent on machines that have never run --update since it
# started recording.
update_status() {
    local file version finished complete skipped failed status name
    file="$(managed_machine_config_dir)/update.manifest"
    if [[ ! -f "$file" ]]; then
        emit "update" "never recorded"
        return 0
    fi
    version="$(manifest_field "$file" version)"
    finished="$(manifest_field "$file" finished_at)"
    complete=""
    skipped=""
    failed=""
    while IFS=$'\t' read -r status name _; do
        case "$status" in
            complete) complete="${complete:+$complete, }$name" ;;
            skipped) skipped="${skipped:+$skipped, }$name" ;;
            failed) failed="${failed:+$failed, }$name" ;;
        esac
    done <"$file"
    if [[ -n "$finished" ]]; then
        emit "update" "${version:-unknown}  $finished${failed:+  (failures)}"
    else
        emit "update" "${version:-unknown}  interrupted"
    fi
    [[ -n "$complete" ]] && emit "  complete" "$complete"
    [[ -n "$skipped" ]] && emit "  skipped" "$skipped"
    [[ -n "$failed" ]] && emit "  failed" "$failed"
    return 0
}

local_bin_status() {
    local checkout pin_file manifest installed_ref configured_ref commit annotated
    checkout="$(status_config_checkout)"
    pin_file="$checkout/local-bin.ref"
    manifest="$(managed_machine_config_dir)/local-bin.manifest"
    installed_ref="$(manifest_field "$manifest" ref)"
    configured_ref=""
    if [[ -f "$pin_file" ]]; then
        configured_ref="$(grep -vE '^[[:space:]]*(#|$)' "$pin_file" | head -1 | tr -d '[:space:]')"
    fi
    commit="$(manifest_field "$manifest" commit)"
    if [[ -n "$commit" ]]; then
        emit "local-bin" "$commit"
    else
        emit "local-bin" "missing"
    fi
    # The pin next to the commit is what setup-bin recorded, including
    # LOCAL_BIN_REF / HOME_BIN_REF one-off overrides.
    if [[ -n "$installed_ref" ]]; then
        annotated="$(pin_annotation "$installed_ref")"
        emit "  pin" "$annotated"
    elif [[ -n "$configured_ref" ]]; then
        annotated="$(pin_annotation "$configured_ref")"
        emit "  pin" "$annotated"
    else
        emit "  pin" "missing"
    fi
    if [[ -n "$installed_ref" && -n "$configured_ref" && "$configured_ref" != "$installed_ref" ]]; then
        annotated="$(pin_annotation "$configured_ref")"
        emit "  configured" "$annotated"
    fi
}

zsh_functions_status() {
    local checkout pin_file manifest installed_ref configured_ref commit annotated
    checkout="$(status_config_checkout)"
    pin_file="$checkout/zsh-functions.ref"
    manifest="$(managed_machine_config_dir)/zsh-functions.manifest"
    installed_ref="$(manifest_field "$manifest" ref)"
    configured_ref=""
    if [[ -f "$pin_file" ]]; then
        configured_ref="$(grep -vE '^[[:space:]]*(#|$)' "$pin_file" | head -1 | tr -d '[:space:]')"
    fi
    commit="$(manifest_field "$manifest" commit)"
    if [[ -n "$commit" ]]; then
        emit "zsh-functions" "$commit"
    else
        emit "zsh-functions" "missing"
    fi
    # The pin next to the commit is what setup-zsh-functions recorded,
    # including ZSH_FUNCTIONS_REF one-off overrides.
    if [[ -n "$installed_ref" ]]; then
        annotated="$(pin_annotation "$installed_ref")"
        emit "  pin" "$annotated"
    elif [[ -n "$configured_ref" ]]; then
        annotated="$(pin_annotation "$configured_ref")"
        emit "  pin" "$annotated"
    else
        emit "  pin" "missing"
    fi
    if [[ -n "$installed_ref" && -n "$configured_ref" && "$configured_ref" != "$installed_ref" ]]; then
        annotated="$(pin_annotation "$configured_ref")"
        emit "  configured" "$annotated"
    fi
}

# One line per roster account (ENG-0339, #93): the doctor verdict the
# elevated add-agent phase recorded plus anything the compliance report would
# flag, from the directory and the world-readable markers only — never the
# agent home, never a dialog. Active slugs with no account show as not
# provisioned; a retired slug is listed only while an account lingers.
agent_accounts_status() {
    local rows slug roster_status summary active=0 ready=0 lines=""
    if ! rows="$(agent_roster_rows 2>/dev/null)"; then
        emit "agent-accounts" "no roster (provide MANAGED_MACHINE_ORG_PROFILE)"
        return 0
    fi
    while IFS=$'\t' read -r slug roster_status; do
        [[ -n "$slug" ]] || continue
        if [[ "$roster_status" == "retired" ]]; then
            agent_account_exists "$slug" || continue
            summary="retired, account lingers (remove-agent: qwts/managed-machine#80)"
        else
            active=$((active + 1))
            summary="$(agent_account_summary "$slug")"
            [[ "$summary" == "account ready snapshot" ]] && ready=$((ready + 1))
        fi
        if [[ "$STATUS_JSON" == 1 && -n "$STATUS_RECORDS" ]]; then
            printf 'account\t%s\t%s\t%s\n' "$slug" "$roster_status" "$summary" >>"$STATUS_RECORDS"
        else
            lines+="$(printf '  %-24s %s' "$slug" "$summary")"$'\n'
        fi
    done <<<"$rows"
    emit "agent-accounts" "$ready of $active active roster accounts have ready snapshots (run account doctor for live readiness)"
    if [[ "$STATUS_JSON" == 0 ]]; then
        printf '%s' "$lines"
    fi
}

lmstudio_status() {
    local system_appdir user_appdir app_name dir path brew_ver
    system_appdir="${MANAGED_MACHINE_SYSTEM_APPDIR:-/Applications}"
    user_appdir="${HOME}/Applications"
    app_name="LM Studio.app"
    path=""
    for dir in "${MANAGED_MACHINE_LMSTUDIO_APPDIR:-}" "$system_appdir" "$user_appdir"; do
        [[ -n "$dir" && -d "$dir/$app_name" ]] || continue
        path="$dir/$app_name"
        break
    done
    brew_ver=""
    if command -v brew >/dev/null 2>&1; then
        brew_ver="$(brew list --cask --versions lm-studio 2>/dev/null | awk 'NR == 1 { print $2 }' || true)"
        brew_ver="$(sanitize_version "$brew_ver")"
    fi
    if [[ -n "$brew_ver" && -n "$path" ]]; then
        printf '%s (%s)\n' "$brew_ver" "$path"
        return 0
    fi
    if [[ -n "$brew_ver" ]]; then
        printf '%s\n' "$brew_ver"
        return 0
    fi
    if [[ -n "$path" ]]; then
        printf 'installed (%s)\n' "$path"
        return 0
    fi
    printf 'missing\n'
}

nvm_status() {
    local dir out
    dir="$(nvm_dir)"
    if [[ ! -s "$dir/nvm.sh" ]]; then
        printf 'missing\n'
        return 0
    fi
    out="$(
        NVM_DIR="$dir" bash -c 'set +e
            # shellcheck disable=SC1091
            . "$NVM_DIR/nvm.sh" >/dev/null 2>&1
            nvm --version 2>/dev/null
        ' | tail -1
    )" || true
    out="$(sanitize_version "$out")"
    if [[ -z "$out" ]]; then
        printf 'installed (version unknown)\n'
        return 0
    fi
    printf '%s\n' "$out"
}

node_status() {
    local dir out
    dir="$(nvm_dir)"
    if [[ -s "$dir/nvm.sh" ]]; then
        out="$(
            NVM_DIR="$dir" bash -c 'set +e
                # shellcheck disable=SC1091
                . "$NVM_DIR/nvm.sh" >/dev/null 2>&1
                node --version 2>/dev/null
            ' | tail -1
        )" || true
        out="$(sanitize_version "$out")"
        if [[ -n "$out" ]]; then
            printf '%s\n' "$out"
            return 0
        fi
    fi
    cmd_version node --version
}

status_catalog_rows() {
    local name kind token app_name command formula brew_ver
    prepend_npm_bin_dir
    while IFS= read -r name; do
        [[ -n "$name" ]] || continue
        kind="$(catalog_app_kind "$name" 2>/dev/null || true)"
        case "$kind" in
            signed-cask|cask)
                token="$(catalog_app_field "$name" token)" || continue
                app_name="$(catalog_app_field "$name" app_name)" || continue
                emit "$name" "$(cask_app_status "$token" "$app_name" "$(cask_appdir_override_for_token "$token")")"
                ;;
            brew-formula)
                formula="$(catalog_app_field "$name" formula)" || continue
                brew_ver=""
                if command -v brew >/dev/null 2>&1; then
                    brew_ver="$(brew list --versions "$formula" 2>/dev/null | awk 'NR == 1 { print $2 }' || true)"
                    brew_ver="$(sanitize_version "$brew_ver")"
                fi
                if [[ -n "$brew_ver" ]]; then
                    emit "$name" "$brew_ver"
                else
                    command="$(catalog_app_field "$name" command 2>/dev/null || true)"
                    [[ -n "$command" ]] || command="$name"
                    local cmd_ver
                    cmd_ver="$(cmd_version "$command" --version)"
                    if [[ "$cmd_ver" == "missing" && "$formula" != "$command" ]]; then
                        cmd_ver="$(cmd_version "$formula" --version)"
                    fi
                    if [[ "$cmd_ver" == "missing" ]]; then
                        local aliases_csv alias_cmd
                        aliases_csv="$(catalog_app_field "$name" aliases 2>/dev/null || true)"
                        if [[ -n "$aliases_csv" ]]; then
                            local -a alias_list=()
                            IFS=',' read -r -a alias_list <<<"$aliases_csv"
                            for alias_cmd in "${alias_list[@]}"; do
                                [[ -n "$alias_cmd" && "$alias_cmd" != "$command" && "$alias_cmd" != "$formula" ]] || continue
                                cmd_ver="$(cmd_version "$alias_cmd" --version)"
                                [[ "$cmd_ver" != "missing" ]] && break
                            done
                        fi
                    fi
                    if [[ "$cmd_ver" != "missing" ]]; then
                        emit "$name" "$cmd_ver"
                    else
                        local pfx=""
                        if command -v brew >/dev/null 2>&1; then
                            pfx="$(brew --prefix 2>/dev/null || true)"
                        fi
                        if [[ -n "$pfx" && -d "$pfx/Cellar/$formula" && ( ! -r "$pfx/Cellar/$formula" || ! -x "$pfx/Cellar/$formula" ) ]]; then
                            emit "$name" "installed ($pfx/Cellar/$formula)"
                        else
                            emit "$name" "missing"
                        fi
                    fi
                fi
                ;;
            vendor-dmg)
                emit "$name" "$(vendor_dmg_status "$name")"
                ;;
            official-cli|opencode|devin|npm|uv-tool)
                command="$(catalog_app_field "$name" command 2>/dev/null || true)"
                if [[ -z "$command" && "$kind" == "uv-tool" ]]; then
                    command="$(catalog_app_field "$name" package 2>/dev/null || true)"
                fi
                [[ -n "$command" ]] || command="$name"
                if [[ "$name" == "devin" ]]; then
                    command="devin"
                elif [[ "$name" == "opencode" ]]; then
                    command="opencode"
                fi
                emit "$name" "$(cmd_version "$command" --version)"
                ;;
        esac
    done < <(catalog_app_names 2>/dev/null || true)
}

STATUS_SECTIONS=()

status_valid_section() {
    case "$1" in
        managed-machine|machine|ssh|bootstrap|update|agent-accounts|local-bin|zsh-functions|pins|toolchain|homebrew|gh|nvm|node|hostname|rustup|rustc|cargo|catalog)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

status_want_section() {
    local target="$1" s
    if [[ ${#STATUS_SECTIONS[@]} -eq 0 ]]; then
        return 0
    fi
    for s in "${STATUS_SECTIONS[@]}"; do
        if [[ "$s" == "$target" ]]; then
            return 0
        fi
        if [[ "$s" == "pins" && ( "$target" == "local-bin" || "$target" == "zsh-functions" ) ]]; then
            return 0
        fi
        if [[ "$s" == "toolchain" ]]; then
            case "$target" in
                homebrew|gh|nvm|node|hostname|rustup|rustc|cargo) return 0 ;;
            esac
        fi
    done
    return 1
}

render_status_json() {
    local records_file="$1"
    python3 - "$records_file" <<'PY'
import json, os, re, sys

records_file = sys.argv[1]
sections = {}
accounts = []

with open(records_file, encoding="utf-8", errors="replace") as handle:
    for raw in handle:
        line = raw.rstrip("\r\n")
        if not line:
            continue
        parts = line.split("\t")
        kind = parts[0]
        if kind == "account" and len(parts) >= 4:
            accounts.append({
                "slug": parts[1],
                "roster_status": parts[2],
                "summary": parts[3],
            })
            continue
        if kind != "row" or len(parts) < 4:
            continue
        sec, key, val = parts[1], parts[2], parts[3]
        if sec == "managed-machine":
            obj = sections.setdefault("managed-machine", {"summary": None, "checkout": None})
            if key == "managed-machine":
                obj["summary"] = val
            elif key.strip() == "checkout":
                obj["checkout"] = val
        elif sec == "machine":
            m = re.match(r"^(sha256-[A-Za-z0-9_-]+)(?: \((.+)\))?$", val)
            sections["machine"] = {
                "summary": val,
                "machine_id": m.group(1) if m else None,
                "hostname": m.group(2) if (m and m.group(2)) else None,
            }
        elif sec == "ssh":
            obj = sections.setdefault("ssh", {"summary": None, "fleet": None})
            if key == "ssh":
                obj["summary"] = val
            elif key.strip() == "fleet":
                obj["fleet"] = val
        elif sec == "bootstrap":
            obj = sections.setdefault("bootstrap", {
                "summary": None,
                "complete": [],
                "deferred": [],
                "skipped": [],
                "failed": [],
            })
            if key == "bootstrap":
                obj["summary"] = val
            else:
                sub = key.strip()
                if sub in ("complete", "deferred", "skipped", "failed"):
                    obj[sub] = [x.strip() for x in val.split(",") if x.strip()]
        elif sec == "update":
            obj = sections.setdefault("update", {
                "summary": None,
                "complete": [],
                "skipped": [],
                "failed": [],
            })
            if key == "update":
                obj["summary"] = val
            else:
                sub = key.strip()
                if sub in ("complete", "skipped", "failed"):
                    obj[sub] = [x.strip() for x in val.split(",") if x.strip()]
        elif sec == "agent-accounts":
            sections["agent-accounts"] = {
                "summary": val,
                "accounts": accounts,
            }
        elif sec in ("local-bin", "zsh-functions"):
            obj = sections.setdefault(sec, {"summary": None, "pin": None, "configured": None})
            if key == sec:
                obj["summary"] = val
            elif key.strip() == "pin":
                obj["pin"] = val
            elif key.strip() == "configured":
                obj["configured"] = val
        elif sec == "toolchain":
            obj = sections.setdefault("toolchain", {})
            obj[key] = val
        elif sec == "catalog":
            obj = sections.setdefault("catalog", {})
            obj[key] = val

report = {
    "schema_version": 1,
    "command": "status",
    "ready": True,
    "status": "ready",
    "sections": sections,
}
try:
    print(json.dumps(report, indent=2))
    sys.stdout.flush()
except BrokenPipeError:
    devnull = os.open(os.devnull, os.O_WRONLY)
    os.dup2(devnull, sys.stdout.fileno())
    sys.exit(0)
PY
}

print_status() {
    trap 'exit 0' PIPE
    ensure_status_path
    local checkout
    checkout="$(status_config_checkout)"
    CONFIG_REPO_ROOT="$checkout"
    export CONFIG_REPO_ROOT
    if [[ "$STATUS_JSON" == 1 ]]; then
        STATUS_RECORDS="$(mktemp)"
        # shellcheck disable=SC2064
        trap "rm -f '$STATUS_RECORDS'" EXIT
    fi
    if status_want_section "managed-machine"; then
        STATUS_CURRENT_SECTION="managed-machine"
        managed_machine_version
    fi
    if status_want_section "machine"; then
        STATUS_CURRENT_SECTION="machine"
        emit "machine" "$(machine_status)"
    fi
    if status_want_section "ssh"; then
        STATUS_CURRENT_SECTION="ssh"
        ssh_enrollment_status
    fi
    if status_want_section "bootstrap"; then
        STATUS_CURRENT_SECTION="bootstrap"
        bootstrap_status
    fi
    if status_want_section "update"; then
        STATUS_CURRENT_SECTION="update"
        update_status
    fi
    if status_want_section "agent-accounts"; then
        STATUS_CURRENT_SECTION="agent-accounts"
        agent_accounts_status
    fi
    if status_want_section "local-bin"; then
        STATUS_CURRENT_SECTION="local-bin"
        local_bin_status
    fi
    if status_want_section "zsh-functions"; then
        STATUS_CURRENT_SECTION="zsh-functions"
        zsh_functions_status
    fi
    STATUS_CURRENT_SECTION="toolchain"
    if status_want_section "homebrew"; then emit "homebrew" "$(cmd_version brew --version)"; fi
    if status_want_section "gh"; then emit "gh" "$(cmd_version gh --version)"; fi
    if status_want_section "nvm"; then emit "nvm" "$(nvm_status)"; fi
    if status_want_section "node"; then emit "node" "$(node_status)"; fi
    if status_want_section "hostname"; then emit "hostname" "$(scutil --get LocalHostName 2>/dev/null || hostname -s 2>/dev/null || printf 'missing\n')"; fi
    if status_want_section "rustup"; then emit "rustup" "$(cmd_version rustup --version)"; fi
    if status_want_section "rustc"; then emit "rustc" "$(cmd_version rustc --version)"; fi
    if status_want_section "cargo"; then emit "cargo" "$(cmd_version cargo --version)"; fi
    if status_want_section "catalog"; then
        STATUS_CURRENT_SECTION="catalog"
        status_catalog_rows
    fi
    if [[ "$STATUS_JSON" == 1 ]]; then
        render_status_json "$STATUS_RECORDS"
    fi
    return 0
}

status_add_sections() {
    local raw="$1" item
    local -a items=()
    if [[ -z "$raw" ]]; then
        if [[ "$STATUS_JSON" == 1 ]]; then
            managed_machine_json_failure "status" "status-invalid-arguments" \
                "Error: --section requires a section name" \
                "Run: managed-machine status [--json] [--section <name>...]"
        fi
        echo "Error: --section requires a section name" >&2
        usage >&2
        exit 1
    fi
    IFS=',' read -r -a items <<<"$raw"
    for item in "${items[@]}"; do
        if [[ -z "$item" ]] || ! status_valid_section "$item"; then
            if [[ "$STATUS_JSON" == 1 ]]; then
                managed_machine_json_failure "status" "status-invalid-section" \
                    "Error: unknown status section: $item" \
                    "Valid sections: managed-machine, machine, ssh, bootstrap, update, agent-accounts, local-bin, zsh-functions, pins, toolchain, homebrew, gh, nvm, node, hostname, rustup, rustc, cargo, catalog" \
                    failed "$(python3 -c 'import json,sys; print(json.dumps({"section": sys.argv[1]}))' "$item")"
            fi
            echo "Error: unknown status section: $item" >&2
            usage >&2
            exit 1
        fi
        STATUS_SECTIONS+=("$item")
    done
}

if managed_machine_has_json_flag "$@"; then
    STATUS_JSON=1
fi

while [[ $# -gt 0 ]]; do
    case "$1" in
        --help|-h)
            usage
            exit 0
            ;;
        --json)
            STATUS_JSON=1
            ;;
        --section)
            if [[ $# -lt 2 || -z "${2:-}" || "${2:-}" == --* ]]; then
                if [[ "$STATUS_JSON" == 1 ]]; then
                    managed_machine_json_failure "status" "status-invalid-arguments" \
                        "Error: --section requires a section name" \
                        "Run: managed-machine status [--json] [--section <name>...]"
                fi
                echo "Error: --section requires a section name" >&2
                usage >&2
                exit 1
            fi
            status_add_sections "$2"
            shift
            ;;
        --section=*)
            status_add_sections "${1#--section=}"
            ;;
        *)
            if [[ "$STATUS_JSON" == 1 ]]; then
                managed_machine_json_failure "status" "status-invalid-arguments" \
                    "Error: unknown status option: $1" \
                    "Run: managed-machine status [--json] [--section <name>...]"
            fi
            echo "Error: unknown status option: $1" >&2
            usage >&2
            exit 1
            ;;
    esac
    shift
done

print_status

