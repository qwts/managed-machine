#!/usr/bin/env bash
# Provision one per-harness macOS agent account (ENG-0339): standard account,
# short name = the harness-level roster slug, full name = the persona.
# Idempotent — rerunning verifies and repairs, never duplicates. Identity
# runtime installation, credentials, and wiring are outside this tool's scope.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=lib/install.sh
source "$REPO_ROOT/lib/install.sh"
# shellcheck source=lib/agent-account.sh
source "$REPO_ROOT/lib/agent-account.sh"
AGENT_ORG_PROFILE_URL="https://raw.githubusercontent.com/qwts/qwts-agent-org/main/governance/organization-profile.json"

usage() {
    cat <<'EOF'
Usage:
  managed-machine add-agent <slug> [--full-name <persona>] [--with-harness]
  managed-machine add-agent --all [--with-harness]

Provisions the standard macOS account for one rostered agent identity:
short name = <slug> (e.g. qwts-goose-agent), full name = the persona.
The account joins the `agents` group. Existing external identity installations and credentials are left untouched. The slug must be an active identity in the organization
roster; unknown and retired slugs fail closed.

With --with-harness the elevated phase runs full account setup headlessly:
`managed-machine account setup <slug> --json` as the target account. This
prepares its configuration, shell, local tools, and harness.
Every requested rerun performs live checks and repairs missing artifacts.
The nonsecret account report is recorded under /Library/Application
Support/managed-machine/agents. These reports and legacy harness markers
are historical snapshots, not live readiness; use account doctor for live
checks. Pending attended work is recorded for follow-up. Without the flag,
full account setup remains opt-in and missing checks are unverified.

managed-machine does not install or bootstrap an identity runtime, seed App
credentials, or claim identity readiness. Configure identity separately if
needed; account doctor reports only managed-machine account and harness checks.

The account is created with a random throwaway password that is never
shown or stored: set a real one afterward in System Settings > Users &
Groups (or sysadminctl -resetPasswordFor) before logging the account in.

Options:
  --full-name <persona>  account full name (default: harness key, capitalized)
  --with-harness         run full account setup and live checks as the account
  --all                  provision every active roster identity in roster
                         order instead of one slug: each account keeps its own
                         administrator prompt, failures are collected, and the
                         run exits nonzero naming every slug that failed.
                         Takes no slug and no --full-name.

Environment:
  MANAGED_MACHINE_ORG_PROFILE  roster source override (organization profile,
                               existing agent-bot config.json, or playbook agents.json)
EOF
}

SLUG=""
FULL_NAME=""
WITH_HARNESS=false
ALL=false
while [[ $# -gt 0 ]]; do
    case "$1" in
        --help|-h)
            usage
            exit 0
            ;;
        --full-name)
            [[ $# -ge 2 ]] || { echo "Error: --full-name requires a value" >&2; exit 1; }
            FULL_NAME="$2"
            shift 2
            ;;
        --with-harness)
            WITH_HARNESS=true
            shift
            ;;
        --all)
            ALL=true
            shift
            ;;
        -*)
            echo "Error: unknown option: $1" >&2
            usage >&2
            exit 1
            ;;
        *)
            if [[ -n "$SLUG" ]]; then
                echo "Error: add-agent takes exactly one slug" >&2
                exit 1
            fi
            SLUG="$1"
            shift
            ;;
    esac
done

# --all reuses the single-slug flow below once per active roster identity, in
# roster order, so fleet Macs never need a hand-written per-account loop. The
# child runs carry their own administrator prompts and verdicts; this loop
# only enumerates, delegates, and summarizes. A slug the child rejects is a
# collected failure, never a silent skip.
provision_all_agents() {
    local rows slug status child_rc ok=0
    local -a slugs=() failed=()
    if ! rows="$(agent_roster_rows 2>/dev/null)"; then
        echo "Error: no roster source found — provide MANAGED_MACHINE_ORG_PROFILE" >&2
        return 1
    fi
    while IFS=$'\t' read -r slug status; do
        [[ "$status" == active ]] || continue
        slugs+=("$slug")
    done <<<"$rows"
    if ((${#slugs[@]} == 0)); then
        echo "Error: the roster names no active agent identities" >&2
        return 1
    fi
    echo "==> provisioning ${#slugs[@]} agent accounts: ${slugs[*]}"
    echo "each account approves its own administrator prompt"
    if [[ "$WITH_HARNESS" == true ]]; then
        child_args+=(--with-harness)
    fi
    for slug in "${slugs[@]}"; do
        echo "==> add-agent $slug"
        # Empty-array expansion trips set -u on the system bash, so only
        # pass the flag when --with-harness asked for it.
        if [[ "$WITH_HARNESS" == true ]]; then
            child_rc=0
            "$REPO_ROOT/scripts/add-agent" "$slug" --with-harness || child_rc=$?
        else
            child_rc=0
            "$REPO_ROOT/scripts/add-agent" "$slug" || child_rc=$?
        fi
        if [[ "$child_rc" -eq 0 ]]; then
            ok=$((ok + 1))
        else
            echo "add-agent $slug failed with status $child_rc" >&2
            failed+=("$slug")
        fi
    done
    if ((${#failed[@]} > 0)); then
        echo "add-agent --all: $ok provisioned, ${#failed[@]} failed: ${failed[*]}" >&2
        return 1
    fi
    echo "add-agent --all: $ok provisioned, 0 failed"
    return 0
}

if [[ "$ALL" == true ]]; then
    if [[ -n "$SLUG" ]]; then
        echo "Error: --all takes no slug" >&2
        exit 1
    fi
    if [[ -n "$FULL_NAME" ]]; then
        echo "Error: --full-name takes no effect with --all" >&2
        exit 1
    fi
    provision_all_agents
    exit $?
fi

if [[ -z "$SLUG" ]]; then
    echo "Error: add-agent requires a roster slug" >&2
    usage >&2
    exit 1
fi
if [[ ! "$SLUG" =~ $AGENT_ACCOUNT_SLUG_RE ]]; then
    echo "Error: invalid slug: $SLUG" >&2
    exit 1
fi

# Fail closed on anything the roster does not vouch for as active: a typo'd
# account would otherwise become a plausible-looking identity with no App
# behind it, and a retired identity must not regain a foothold by account.
ROSTER_STATUS="$(agent_roster_query status "$SLUG")"
case "$ROSTER_STATUS" in
    active) ;;
    retired)
        echo "Error: $SLUG is retired in the roster — reactivate it in governance before provisioning an account" >&2
        exit 1
        ;;
    *)
        echo "Error: $SLUG is not in the active roster (status: $ROSTER_STATUS)" >&2
        exit 1
        ;;
esac

HARNESS="$(agent_roster_query harness "$SLUG")"
if [[ -z "$FULL_NAME" ]]; then
    FULL_NAME="$(agent_persona_name "${HARNESS:-$SLUG}")"
fi

# The harness install target (ENG-0339: each agent account needs its own
# harness). The roster's harness key names the setup; without one there is
# nothing to install and --with-harness fails closed before any dialog. The
# report always names the expected install so a missing one is visible even
# when this run was not asked to perform it.
HARNESS_SETUP=""
if [[ -n "$HARNESS" ]]; then
    HARNESS_SETUP="$(agent_harness_setup_name "$REPO_ROOT" "$HARNESS")"
fi
HARNESS_INSTALL=""
if [[ "$WITH_HARNESS" == true ]]; then
    if [[ -z "$HARNESS_SETUP" ]]; then
        echo "Error: the roster names no harness for $SLUG — nothing to install with --with-harness" >&2
        exit 1
    fi
    HARNESS_INSTALL="$HARNESS_SETUP"
fi

# The App avatar is staged unprivileged in a private temp dir and installed
# by the elevated phase. It is presentation, not identity: when it cannot be
# resolved the account is still provisioned and the report says so.
STAGE_DIR="$(mktemp -d)"
trap 'rm -rf "$STAGE_DIR"' EXIT
AVATAR_FILE=""
if agent_fetch_avatar "$SLUG" "$STAGE_DIR/avatar"; then
    AVATAR_FILE="$STAGE_DIR/avatar"
else
    echo "warn: no avatar resolved for $SLUG — the account picture is left as is"
fi

# The public organization roster is retained as a non-secret account
# targeting source; no App key material is fetched or copied.
PROFILE_FILE=""
if [[ "$WITH_HARNESS" == true ]]; then
    if curl -fsSL --max-time 20 -o "$STAGE_DIR/profile.json" "$AGENT_ORG_PROFILE_URL" 2>/dev/null \
        && [[ -s "$STAGE_DIR/profile.json" ]]; then
        PROFILE_FILE="$STAGE_DIR/profile.json"
    else
        echo "warn: could not fetch the organization roster — harness account setup can still be run later"
    fi
fi

# The elevated phases below share one convergence tail: membership in the
# agents group, the avatar installed under /Library/User Pictures with the
# directory record pointing at it, and, when asked, the harness installed as the account with its verdict
# recorded. Positional parameters keep the slug, name, and file paths out
# of shell interpolation; $3 and $4 are empty when no avatar or roster profile is available; $6 is
# empty unless harness setup was requested. The
# tool paths, group name, and system directories are hardcoded on purpose:
# anything the unprivileged environment could choose here would run as root
# behind a generic authorization prompt. The harness install itself runs as
# the agent, not as root.
CONVERGE_TAIL='
PIC="/Library/User Pictures/agents/$1.png"
MARK="/Library/Application Support/managed-machine/agents"
/usr/sbin/dseditgroup -o read agents >/dev/null 2>&1 || /usr/sbin/dseditgroup -o create -r "Agent accounts (ENG-0339)" agents
/usr/sbin/dseditgroup -o edit -a "$1" -t user agents
if [ -n "$3" ]; then
    /bin/mkdir -p "/Library/User Pictures/agents"
    /bin/cp "$3" "$PIC" && /bin/chmod 0644 "$PIC"
    /usr/bin/dscl . -create "/Users/$1" Picture "$PIC"
fi
H="$(/usr/bin/dscl . -read "/Users/$1" NFSHomeDirectory | /usr/bin/sed -n "s/^NFSHomeDirectory: //p")"
if [ -z "$H" ]; then
    echo "add-agent: the $1 directory record has no home directory" >&2
    exit 1
fi
[ -d "$H" ] || /usr/sbin/createhomedir -c -u "$1" >/dev/null
if [ ! -d "$H" ]; then
    echo "add-agent: home directory $H for $1 is missing and could not be created" >&2
    exit 1
fi
/bin/mkdir -p "$MARK"
if [ -n "$4" ]; then
    /bin/cp "$4" "$MARK/$1.profile.json"
    /bin/chmod 0644 "$MARK/$1.profile.json"
fi
if [ -n "$6" ]; then
    MM=/opt/homebrew/bin/managed-machine
    [ -x "$MM" ] || MM=/usr/local/bin/managed-machine
    RC=0
    /usr/bin/sudo -u "$1" -H /usr/bin/env PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin MANAGED_MACHINE_BOOTSTRAP_MODE=noninteractive GIT_TERMINAL_PROMPT=0 "$MM" account setup "$1" --json >"$MARK/$1.account.json" 2>/dev/null </dev/null || RC=$?
    if [ "$RC" -eq 0 ]; then
        printf "ok %s\n" "$6" >"$MARK/$1.harness"
        : >"$MARK/$1.harness.err"
    elif [ "$RC" -eq 75 ]; then
        printf "pending %s 75\n" "$6" >"$MARK/$1.harness"
        printf "Account setup requires attended follow-up; saved outcomes: %s; run managed-machine account doctor %s.\n" "$MARK/$1.account.json" "$1" >"$MARK/$1.harness.err"
    else
        printf "failed %s %s\n" "$6" "$RC" >"$MARK/$1.harness"
        printf "Account setup failed; saved outcomes: %s; run managed-machine account doctor %s for current checks.\n" "$MARK/$1.account.json" "$1" >"$MARK/$1.harness.err"
    fi
fi
if [ -n "$6" ]; then
    /bin/chmod 0644 "$MARK/$1".*
fi
'

if agent_account_exists "$SLUG"; then
    echo "==> account $SLUG already exists — verifying"
    NEEDS_HARNESS=false
    if [[ -n "$HARNESS_INSTALL" ]]; then
        NEEDS_HARNESS=true
    fi
    if ! agent_account_in_group "$SLUG" "$AGENT_ACCOUNT_GROUP" \
        || { [[ -n "$AVATAR_FILE" ]] && ! agent_account_picture_converged "$SLUG" "$AVATAR_FILE"; } \
        || [[ ! -d "$(agent_account_home "$SLUG")" || "$NEEDS_HARNESS" == true ]]; then
        echo "==> converging the $SLUG agent account (group, picture${HARNESS_INSTALL:+, harness $HARNESS_INSTALL})"
        elevate_run "converge the $SLUG agent account" /bin/sh -c \
            "set -e$CONVERGE_TAIL" \
            add-agent "$SLUG" "$FULL_NAME" "$AVATAR_FILE" "$PROFILE_FILE" "" "$HARNESS_INSTALL"
    fi
else
    echo "==> creating standard account $SLUG (\"$FULL_NAME\")"
    # One elevated phase. The password is generated inside the elevated
    # shell and never leaves it: agent accounts authenticate to nothing
    # (ENG-0339 §6), and the operator sets a real login password out of
    # band. The picture is installed before sysadminctl so -picture can
    # reference its final path. The uid is the OS's to assign: macOS
    # refuses to change or delete a local record afterwards even for root
    # reached through the authorization dialog, so nothing here depends on
    # a particular number.
    elevate_run "create the $SLUG agent account" /bin/sh -c \
        'set -e
PIC="/Library/User Pictures/agents/$1.png"
if [ -n "$3" ]; then
    /bin/mkdir -p "/Library/User Pictures/agents"
    /bin/cp "$3" "$PIC" && /bin/chmod 0644 "$PIC"
    /usr/sbin/sysadminctl -addUser "$1" -fullName "$2" -password "$(/usr/bin/openssl rand -base64 24)" -picture "$PIC"
else
    /usr/sbin/sysadminctl -addUser "$1" -fullName "$2" -password "$(/usr/bin/openssl rand -base64 24)"
fi
/usr/sbin/createhomedir -c -u "$1" >/dev/null'"$CONVERGE_TAIL" \
        add-agent "$SLUG" "$FULL_NAME" "$AVATAR_FILE" "$PROFILE_FILE" "" "$HARNESS_INSTALL"
fi

ensure_agent_shared_space

echo "==> compliance report for $SLUG"
agent_compliance_report "$SLUG" "$FULL_NAME" "$HARNESS_SETUP"
