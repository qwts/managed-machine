#!/usr/bin/env bash
# Run core setup, migrations, then catalog apps. Idempotent.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
REPO_ROOT="$ROOT"
# shellcheck source=lib/install.sh
source "$ROOT/lib/install.sh"
# shellcheck source=lib/bootstrap.sh
source "$ROOT/lib/bootstrap.sh"
# shellcheck source=lib/hostname.sh
source "$ROOT/lib/hostname.sh"
# shellcheck source=lib/migrate.sh
source "$ROOT/lib/migrate.sh"
# shellcheck source=lib/apps.sh
source "$ROOT/lib/apps.sh"

# Ordered core setup. App installs come from the config-repo catalog.
SETUP_SCRIPTS=(
    setup-brew
    setup-hostname
    setup-zsh
    setup-nvm
    setup-git-hooks
    setup-gh
    setup-agent-bot
    setup-bin
    setup-zsh-functions
    setup-rust
)

usage() {
    cat <<'EOF'
Usage: managed-machine --bootstrap [--interactive|--non-interactive]

With no mode flag, bootstrap uses interactive mode when a controlling terminal
is available and otherwise uses noninteractive mode.
EOF
}

requested_mode="auto"
case "${1:-}" in
    "") ;;
    --interactive) requested_mode="interactive" ;;
    --non-interactive) requested_mode="noninteractive" ;;
    --help|-h)
        usage
        exit 0
        ;;
    *)
        echo "Error: unknown bootstrap option: $1" >&2
        usage >&2
        exit 1
        ;;
esac
if [[ $# -gt 1 ]]; then
    echo "Error: bootstrap accepts at most one mode flag" >&2
    usage >&2
    exit 1
fi

mode="$(bootstrap_resolve_mode "$requested_mode")" || exit 1
status_file="$(bootstrap_status_file)"
status_dir="$(dirname "$status_file")"
mkdir -p "$status_dir"
chmod 700 "$status_dir"
status_tmp="$(mktemp "${status_file}.XXXXXX")"
trap 'rm -f "$status_tmp"' EXIT
chmod 600 "$status_tmp"

started_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
{
    echo 'schema_version=1'
    printf 'mode=%s\n' "$mode"
    printf 'started_at=%s\n' "$started_at"
} >"$status_tmp"

completed_count=0
deferred_count=0
skipped_count=0
failed_count=0
deferred_names=()
skipped_names=()
failed_names=()

record_status() {
    local status="$1"
    local name="$2"
    local detail="$3"
    printf '%s\t%s\t%s\n' "$status" "$name" "$detail" >>"$status_tmp"
    case "$status" in
        complete) completed_count=$((completed_count + 1)) ;;
        deferred)
            deferred_count=$((deferred_count + 1))
            deferred_names+=("$name")
            ;;
        skipped)
            skipped_count=$((skipped_count + 1))
            skipped_names+=("$name")
            ;;
        failed)
            failed_count=$((failed_count + 1))
            failed_names+=("$name")
            ;;
    esac
}

run_one() {
    local name="$1"
    shift
    local result=0
    echo "==> $name"
    if [[ "$mode" == "noninteractive" ]]; then
        if MANAGED_MACHINE_BOOTSTRAP_MODE="$mode" GIT_TERMINAL_PROMPT=0 "$@" </dev/null; then
            result=0
        else
            result=$?
        fi
    elif MANAGED_MACHINE_BOOTSTRAP_MODE="$mode" "$@"; then
        result=0
    else
        result=$?
    fi
    if [[ "$result" -eq 0 ]]; then
        record_status complete "$name" ""
    elif [[ "$result" -eq "$MANAGED_MACHINE_DEFERRED_EXIT" || "$result" -eq "$MANAGED_MACHINE_SKIPPED_EXIT" ]]; then
        record_status skipped "$name" "not part of this install"
    else
        echo "failed: $name exited with status $result" >&2
        record_status failed "$name" "exit status $result"
    fi
}

preflight_names=()
preflight_reasons=()
if [[ "$mode" == "noninteractive" ]]; then
    for name in "${SETUP_SCRIPTS[@]}"; do
        if reason="$(bootstrap_noninteractive_skip_reason "$name")"; then
            preflight_names+=("$name")
            preflight_reasons+=("$reason")
        fi
    done
fi

echo "Bootstrap mode: $mode"
if [[ "$mode" == "noninteractive" ]]; then
    echo "Install preflight:"
    if [[ ${#preflight_names[@]} -eq 0 ]]; then
        echo "  no steps skipped"
    else
        for ((i = 0; i < ${#preflight_names[@]}; i++)); do
            printf '  skip: %s (%s)\n' "${preflight_names[$i]}" "${preflight_reasons[$i]}"
        done
    fi
fi

preflight_reason_for() {
    local name="$1"
    local i
    for ((i = 0; i < ${#preflight_names[@]}; i++)); do
        if [[ "${preflight_names[$i]}" == "$name" ]]; then
            printf '%s\n' "${preflight_reasons[$i]}"
            return 0
        fi
    done
    return 1
}

CONFIG_REPO_ROOT="$(managed_machine_config_repo_dir)" || {
    echo "Error: could not resolve managed-machine-config" >&2
    exit 1
}
export CONFIG_REPO_ROOT REPO_ROOT

echo "==> migrations"
migrations_status=0
if MANAGED_MACHINE_BOOTSTRAP_MODE="$mode" run_managed_machine_migrations; then
    record_status complete migrations ""
else
    migrations_status=$?
    if [[ "$migrations_status" -eq "$MANAGED_MACHINE_DEFERRED_EXIT" || "$migrations_status" -eq "$MANAGED_MACHINE_SKIPPED_EXIT" ]]; then
        record_status skipped migrations "not part of this install"
    else
        record_status failed migrations "exit status $migrations_status"
    fi
fi

for name in "${SETUP_SCRIPTS[@]}"; do
    script="$ROOT/$name"
    if [[ ! -x "$script" ]]; then
        echo "failed: $name not found or not executable" >&2
        record_status failed "$name" "script missing or not executable"
        continue
    fi
    if reason="$(preflight_reason_for "$name")"; then
        echo "==> $name (skipped: $reason)"
        record_status skipped "$name" "$reason"
        continue
    fi
    run_one "$name" "$script"
done

while IFS= read -r app_name; do
    [[ -n "$app_name" ]] || continue
    run_one "setup-$app_name" install_catalog_app "$app_name"
done < <(catalog_auto_app_names 2>/dev/null || true)

printf 'finished_at=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >>"$status_tmp"
mv "$status_tmp" "$status_file"
trap - EXIT

echo
echo "Bootstrap summary ($mode):"
echo "  complete: $completed_count"
echo "  deferred: $deferred_count"
if [[ "$deferred_count" -gt 0 ]]; then
    printf '    %s\n' "${deferred_names[@]}"
fi
echo "  skipped: $skipped_count"
if [[ "$skipped_count" -gt 0 ]]; then
    printf '    %s\n' "${skipped_names[@]}"
fi
echo "  failed: $failed_count"
if [[ "$failed_count" -gt 0 ]]; then
    printf '    %s\n' "${failed_names[@]}"
fi
echo "  status: $status_file"

if [[ "$failed_count" -gt 0 ]]; then
    echo "Bootstrap finished with failed steps." >&2
    exit 1
fi
if [[ "$deferred_count" -gt 0 ]]; then
    echo "Bootstrap finished with deferred steps."
else
    echo "Bootstrap complete."
fi
