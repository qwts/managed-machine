#!/usr/bin/env bash
# Ensure zsh-functions is cloned at the pinned ref and installed.
#
# managed-machine consumes zsh-functions as a package: it keeps the repo in the
# managed-machine libexec directory (or a sibling repo in development), checks
# out the ref recorded in zsh-functions.ref, then runs zsh-functions's own
# install script to link functions, zsh-profile, and the managed loader block.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=lib/install.sh
source "$REPO_ROOT/lib/install.sh"

CONFIG_REPO_ROOT="$(managed_machine_config_repo_dir)"

# In a Homebrew install zsh-functions lives next to the setup scripts under
# libexec/zsh-functions. In a git clone it lives as a sibling repo. Override with
# ZSH_FUNCTIONS_DIR if needed.
if [[ -z "${ZSH_FUNCTIONS_DIR:-}" ]]; then
    if [[ -d "$REPO_ROOT/managed-machine-config" ]]; then
        ZSH_FUNCTIONS_DIR="$REPO_ROOT/zsh-functions"
    else
        ZSH_FUNCTIONS_DIR="$REPO_ROOT/../zsh-functions"
    fi
fi

ZSH_FUNCTIONS_REPO="${ZSH_FUNCTIONS_REPO:-https://github.com/qwts/zsh-functions.git}"
ZSH_FUNCTIONS_DIR="${ZSH_FUNCTIONS_DIR:-}"

# A checkout directory must always resolve; there is no legacy default.
if [[ -z "$ZSH_FUNCTIONS_DIR" ]]; then
    echo "Error: could not determine ZSH_FUNCTIONS_DIR" >&2
    exit 1
fi

REF_FILE="$CONFIG_REPO_ROOT/zsh-functions.ref"

if [[ ! -f "$REF_FILE" ]]; then
    echo "Error: missing pin file $REF_FILE" >&2
    exit 1
fi

# ZSH_FUNCTIONS_REF overrides the pin; otherwise read the first non-comment line.
if [[ -n "${ZSH_FUNCTIONS_REF:-}" ]]; then
    ref="$ZSH_FUNCTIONS_REF"
else
    ref="$(grep -vE '^[[:space:]]*#' "$REF_FILE" | grep -vE '^[[:space:]]*$' | head -1 | tr -d '[:space:]')"
    if [[ -z "$ref" ]]; then
        echo "Error: no ref found in $REF_FILE" >&2
        exit 1
    fi
fi

echo "zsh-functions pin: $ref"

ref_is_sha() {
    [[ "$1" =~ ^[0-9a-f]{7,40}$ ]]
}

# Machine setup must be reproducible: the pin has to name an immutable ref (a
# tag or commit SHA). A moving branch makes every bootstrap fetch whatever
# that branch points at today and is rejected unless explicitly overridden.
reject_branch_pin() {
    if [[ "${MANAGED_MACHINE_ALLOW_BRANCH_PIN:-}" == "1" ]]; then
        echo "warning: '$ref' is a moving branch — this machine's zsh-functions is not reproducible (MANAGED_MACHINE_ALLOW_BRANCH_PIN=1)" >&2
        return 0
    fi
    cat >&2 <<EOF
Error: zsh-functions pin '$ref' is a moving branch, not an immutable ref.
Pin a tag or commit SHA in $REF_FILE (e.g. v0.1.0), or override once with:

  MANAGED_MACHINE_ALLOW_BRANCH_PIN=1 managed-machine setup zsh-functions
EOF
    exit 1
}

# Record the pin and the exact commit it resolved to, so every bootstrap has
# a machine-readable record of what actually ran. Never committed.
record_zsh_functions_pin() {
    local resolved="$1"
    local state_dir manifest tmp
    state_dir="$(managed_machine_config_dir)"
    manifest="$state_dir/zsh-functions.manifest"
    mkdir -p "$state_dir"
    chmod 700 "$state_dir"
    tmp="$(mktemp "${manifest}.XXXXXX")"
    chmod 600 "$tmp"
    {
        echo 'schema_version=1'
        printf 'ref=%s\n' "$ref"
        printf 'commit=%s\n' "$resolved"
        printf 'checkout=%s\n' "$ZSH_FUNCTIONS_DIR"
        printf 'recorded_at=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    } >"$tmp"
    mv "$tmp" "$manifest"
    echo "zsh-functions pin recorded: $manifest (commit ${resolved:-unknown})"
}

resolve_target_owner() {
    local target="$1" owner="" prefix
    prefix="$(brew_prefix_path 2>/dev/null || true)"

    # Only prefix-resident checkouts escalate to the prefix owner.
    # User-space checkouts (sibling development repos, custom paths)
    # run unprivileged as the invoking user.
    if [[ -n "$prefix" ]]; then
        local real_target
        real_target="$(cd "$target" 2>/dev/null && pwd -P || true)"
        if [[ -z "$real_target" ]]; then
            real_target="$target"
        fi
        if [[ "$real_target" == "$prefix"/* ]]; then
            owner="$(brew_prefix_owner 2>/dev/null || true)"
            owner="$(resolve_brew_owner_name "$owner")"
            if [[ -z "$owner" || "$owner" == "root" || "$owner" == "0" ]]; then
                owner="$(preferred_brew_owner 2>/dev/null || true)"
            fi
        fi
    fi

    # Fall back to inspecting target ownership if prefix check did not match
    # (e.g. test fixtures), but strictly constrain to non-root admin accounts.
    if [[ -z "$owner" && -e "$target" ]]; then
        local raw_owner
        raw_owner="$(config_repo_owner "$target" 2>/dev/null || true)"
        raw_owner="$(resolve_brew_owner_name "$raw_owner")"
        if [[ -n "$raw_owner" && "$raw_owner" != "root" && "$raw_owner" != "0" ]] && user_in_admin_group "$raw_owner"; then
            owner="$raw_owner"
        fi
    fi

    # Root is never an acceptable target owner for Homebrew/zsh-functions
    if [[ "$owner" == "root" || "$owner" == "0" ]]; then
        owner=""
    fi

    printf '%s\n' "${owner:-$(id -un)}"
}

clone_zsh_functions_repo() {
    local parent="$1" repo="$2" target="$3"
    mkdir -p "$parent"
    git clone "$repo" "$target"
}

update_zsh_functions_repo() {
    local dir="$1"
    local target_ref="$2"
    local allow_branch="${3:-0}"
    local pin_file="$4"

    cd "$dir"
    local git_c=(git -c "safe.directory=$dir" -c "safe.directory=$dir/.git")

    "${git_c[@]}" fetch --tags --quiet

    # SHA pins resolve as commit objects only. A tag whose name collides
    # with the pinned hex string must not shadow it (refs/tags wins raw-SHA
    # lookup), so the checkout is verified against the pin and aborts on
    # mismatch instead of running foreign code.
    if ref_is_sha "$target_ref"; then
        if ! "${git_c[@]}" rev-parse --verify --quiet "${target_ref}^{commit}" >/dev/null; then
            echo "Error: zsh-functions pin '$target_ref' does not resolve to a tag, commit, or branch" >&2
            exit 1
        fi
        "${git_c[@]}" checkout --quiet "$target_ref"
        if [[ "$("${git_c[@]}" rev-parse HEAD)" != "$target_ref"* ]]; then
            cat >&2 <<EOF
Error: zsh-functions pin '$target_ref' checked out a different commit — a tag shadows this SHA.
Delete the tag (or re-clone) and retry; refusing to install unpinned code.
EOF
            exit 1
        fi
    elif "${git_c[@]}" rev-parse --verify --quiet "refs/tags/$target_ref" >/dev/null; then
        "${git_c[@]}" checkout --quiet "refs/tags/$target_ref"
    elif "${git_c[@]}" rev-parse --verify --quiet "refs/remotes/origin/$target_ref" >/dev/null \
        || "${git_c[@]}" rev-parse --verify --quiet "refs/heads/$target_ref" >/dev/null; then
        if [[ "$allow_branch" != "1" ]]; then
            cat >&2 <<EOF
Error: zsh-functions pin '$target_ref' is a moving branch, not an immutable ref.
Pin a tag or commit SHA in $pin_file (e.g. v0.1.0), or override once with:

  MANAGED_MACHINE_ALLOW_BRANCH_PIN=1 managed-machine setup zsh-functions
EOF
            exit 1
        fi
        echo "warning: '$target_ref' is a moving branch — this machine's zsh-functions is not reproducible (MANAGED_MACHINE_ALLOW_BRANCH_PIN=1)" >&2
        "${git_c[@]}" checkout --quiet "$target_ref"
        if "${git_c[@]}" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' >/dev/null 2>&1; then
            "${git_c[@]}" pull --ff-only --quiet
        fi
    else
        echo "Error: zsh-functions pin '$target_ref' does not resolve to a tag, commit, or branch" >&2
        exit 1
    fi
}

# Clone only if the repo is missing. If the formula already installed it as a
# bundled git repo, or if the directory exists but is not a git repo (e.g. a
# resource archive), we use it as-is and only run git operations when .git
# exists.
if [[ ! -d "$ZSH_FUNCTIONS_DIR" ]]; then
    echo "Cloning zsh-functions into $ZSH_FUNCTIONS_DIR..."
    parent_dir="$(dirname "$ZSH_FUNCTIONS_DIR")"
    parent_owner="$(resolve_target_owner "$ZSH_FUNCTIONS_DIR")"
    if [[ "$parent_owner" == "$(id -un)" && -w "$parent_dir" ]]; then
        clone_zsh_functions_repo "$parent_dir" "$ZSH_FUNCTIONS_REPO" "$ZSH_FUNCTIONS_DIR"
    elif [[ "$parent_owner" != "$(id -un)" ]] && user_in_admin_group "$parent_owner"; then
        if ! elevate_as_user_with_github_auth "clone zsh-functions" "$parent_owner" \
            /bin/bash -c "$(declare -f clone_zsh_functions_repo); clone_zsh_functions_repo \"\$@\"" \
            bash "$parent_dir" "$ZSH_FUNCTIONS_REPO" "$ZSH_FUNCTIONS_DIR"; then
            if [[ "${ELEVATE_RUN_DETAIL:-}" == *"could not read Username for 'https://github.com'"* ]]; then
                echo "Error: GitHub authentication for zsh-functions failed while running as $parent_owner." >&2
                echo "Run 'gh auth login' as the invoking user, then retry." >&2
            fi
            exit 1
        fi
    else
        mkdir -p "$parent_dir"
        git clone "$ZSH_FUNCTIONS_REPO" "$ZSH_FUNCTIONS_DIR"
    fi
fi

if [[ ! -d "$ZSH_FUNCTIONS_DIR" ]]; then
    echo "Error: zsh-functions directory not found at $ZSH_FUNCTIONS_DIR" >&2
    exit 1
fi

cd "$ZSH_FUNCTIONS_DIR"
ZSH_FUNCTIONS_DIR="$(pwd -P)"
repo_owner="$(resolve_target_owner "$ZSH_FUNCTIONS_DIR")"

# Homebrew libexec/zsh-functions is prefix-owned. Git 2.35+ refuses that from a
# non-owner; trust the path for these commands only (same as the config seed).
zsh_functions_git() {
    config_repo_git "$ZSH_FUNCTIONS_DIR" "$@"
}

if [[ -e ".git" ]]; then
    head="$(zsh_functions_git rev-parse HEAD 2>/dev/null || true)"

    # Skip the network round-trip when the immutable pin is already checked
    # out. SHA pins compare by prefix without touching tag refs, so a
    # hex-named tag can never mark a foreign commit satisfied; tags compare
    # by dereference and never apply to SHA-shaped refs.
    satisfied=""
    if ref_is_sha "$ref" && [[ "$head" == "$ref"* ]]; then
        satisfied=1
    elif ! ref_is_sha "$ref" \
        && zsh_functions_git rev-parse --verify --quiet "refs/tags/$ref" >/dev/null \
        && [[ "$(zsh_functions_git rev-parse --verify "refs/tags/${ref}^{commit}")" == "$head" ]]; then
        satisfied=1
    fi

    if [[ -n "$satisfied" ]]; then
        echo "zsh-functions already at pin $ref — skipping fetch"
    else
        # If the ref is already known locally to be a moving branch and branch
        # pins are disallowed, fail fast before prompting for authorization.
        if ! zsh_functions_git rev-parse --verify --quiet "refs/tags/$ref" >/dev/null && ! ref_is_sha "$ref"; then
            if zsh_functions_git rev-parse --verify --quiet "refs/remotes/origin/$ref" >/dev/null \
                || zsh_functions_git rev-parse --verify --quiet "refs/heads/$ref" >/dev/null; then
                reject_branch_pin
            fi
        fi

        echo "Fetching zsh-functions..."
        if [[ "$repo_owner" == "$(id -un)" && -w "$ZSH_FUNCTIONS_DIR" && -w "$ZSH_FUNCTIONS_DIR/.git" ]]; then
            update_zsh_functions_repo "$ZSH_FUNCTIONS_DIR" "$ref" "${MANAGED_MACHINE_ALLOW_BRANCH_PIN:-0}" "$REF_FILE"
        else
            if ! elevate_as_user_with_github_auth "update zsh-functions" "$repo_owner" \
                /bin/bash -c "$(declare -f update_zsh_functions_repo); update_zsh_functions_repo \"\$@\"" \
                bash "$ZSH_FUNCTIONS_DIR" "$ref" "${MANAGED_MACHINE_ALLOW_BRANCH_PIN:-0}" "$REF_FILE"; then
                if [[ "${ELEVATE_RUN_DETAIL:-}" == *"could not read Username for 'https://github.com'"* ]]; then
                    echo "Error: GitHub authentication for zsh-functions failed while running as $repo_owner." >&2
                    echo "Run 'gh auth login' as the invoking user, then retry." >&2
                fi
                exit 1
            fi
        fi
    fi

    resolved_commit="$(zsh_functions_git rev-parse HEAD)"
    echo "Checked out: $(zsh_functions_git describe --tags --always 2>/dev/null || zsh_functions_git rev-parse --short HEAD) ($resolved_commit)"
    record_zsh_functions_pin "$resolved_commit"
else
    # Resource archives have no git metadata; record the pin without a commit.
    record_zsh_functions_pin ""
fi

# Run zsh-functions's own installer to link functions, zsh-profile, and the
# managed .zshenv loader block.
if [[ ! -x "$ZSH_FUNCTIONS_DIR/install" ]]; then
    echo "Error: $ZSH_FUNCTIONS_DIR/install not found or not executable" >&2
    exit 1
fi

exec "$ZSH_FUNCTIONS_DIR/install"
