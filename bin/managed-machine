    "$ROOT/scripts/ssh" "$@"
}

# Source commit of this tree: git in a checkout, else the RELEASE_COMMIT the
# formula writes into libexec.
release_commit() {
    local sha=""
    if [[ -e "$ROOT/.git" ]]; then
        sha="$(git -C "$ROOT" rev-parse HEAD 2>/dev/null || true)"
    fi
    if [[ ! "$sha" =~ ^[0-9a-f]{40}$ && -f "$ROOT/RELEASE_COMMIT" ]]; then
        sha="$(tr -d '[:space:]' <"$ROOT/RELEASE_COMMIT")"
    fi
    [[ "$sha" =~ ^[0-9a-f]{40}$ ]] && printf '%s\n' "$sha" || printf 'unknown\n'
}

# ENG-0055: --version and skill path read only this tree. They are matched
# before any path that sources lib/ or refreshes the config checkout.
cmd_version() {
    if [[ $# -ne 0 ]]; then
        if cli_has_json_flag "$@"; then
            cli_json_failure "version" "version-invalid-arguments" \
                "Error: --version does not accept arguments" \
                "Run: managed-machine --version"
        fi
        echo "Error: --version does not accept arguments" >&2
        exit 1
    fi
    [[ -f "$ROOT/VERSION" ]] || { echo "Error: no VERSION in $ROOT" >&2; exit 1; }
    tr -d '[:space:]' <"$ROOT/VERSION"
    printf '\n'
}

cmd_skill() {
    local json=0 sub="${1:-}"
    if cli_has_json_flag "$@"; then json=1; fi
    if [[ "$sub" != "path" ]]; then
        if [[ "$json" == 1 ]]; then
            cli_json_failure "skill-path" "skill-invalid-arguments" \
                "Error: usage: managed-machine skill path [--json]" \
                "Run: managed-machine skill path [--json]"
        fi
        echo "Error: usage: managed-machine skill path" >&2
        exit 1
    fi
    shift
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --json) json=1 ;;
            *)
                if [[ "$json" == 1 ]]; then
                    cli_json_failure "skill-path" "skill-invalid-arguments" \
                        "Error: usage: managed-machine skill path [--json]" \
                        "Run: managed-machine skill path [--json]"
                fi
                echo "Error: usage: managed-machine skill path" >&2
                exit 1
                ;;
        esac
        shift
    done
    if [[ ! -f "$ROOT/skills/managed-machine/SKILL.md" ]]; then
        if [[ "$json" == 1 ]]; then
            cli_json_failure "skill-path" "skill-bundle-missing" \
                "Error: no skill bundle at $ROOT/skills/managed-machine" \
                "Reinstall managed-machine so the bundled skill is present."
        fi
        echo "Error: no skill bundle at $ROOT/skills/managed-machine" >&2
        exit 1
    fi
    trap 'exit 0' PIPE
    local commit_sha
    commit_sha="$(release_commit)"
    if [[ "$json" == 1 ]]; then
        python3 - "$ROOT/skills/managed-machine" "$ROOT/skills/managed-machine/SKILL.md" "$commit_sha" <<'PY'
import json, os, sys
skill_dir, skill_file, commit_sha = sys.argv[1:]
report = {
    "schema_version": 1,
    "command": "skill-path",
    "ready": True,
    "status": "ready",
    "name": "managed-machine",
    "path": skill_dir,
    "skill_file": skill_file,
    "commit": commit_sha,
}
try:
    print(json.dumps(report, indent=2))
    sys.stdout.flush()
except BrokenPipeError:
    devnull = os.open(os.devnull, os.O_WRONLY)
    os.dup2(devnull, sys.stdout.fileno())
    sys.exit(0)
PY
    else
        printf '%s\ncommit %s\n' "$ROOT/skills/managed-machine" "$commit_sha"
    fi
}

is_new_core_status_route() {
    local count=0 section=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --section)
                if [[ $# -lt 2 || "$2" == -* ]]; then
                    return 1
                fi
                count=$((count + 1))
                section="$2"
                shift 2
                ;;
            --section=*)
                count=$((count + 1))
                section="${1#--section=}"
                shift
                ;;
            *)
                shift
                ;;
        esac
    done
    [[ "$count" -eq 1 ]] || return 1
    case "$section" in
        software|config|flavor|fleet) return 0 ;;
        *) return 1 ;;
    esac
}

# D5: inspect only the argument vector to decide whether the invocation
# belongs to the packaged Go core or to the legacy Bash implementation.
is_new_core_route() {
    case "${1:-}" in
        software|config|platform|version)
            return 0
            ;;
        skill)
            [[ "${2:-}" == "path" ]] && return 1
            return 0
            ;;
        status)
            shift
            is_new_core_status_route "$@"
            return $?
            ;;
        fleet)
            case "${2:-}" in
                ""|list|remove)
                    return 1
                    ;;
                --*)
                    return 0
                    ;;
                -*)
                    return 1
                    ;;
                *)
                    return 0
                    ;;
            esac
            ;;
        *)
            return 1
            ;;
    esac
}

exec_new_core() {
    local core="${MANAGED_MACHINE_CORE:-$ROOT/core/managed-machine}"
    if [[ ! -f "$core" || ! -x "$core" ]]; then
        if cli_has_json_flag "$@"; then
            cli_json_failure "${1:-managed-machine}" "core-missing" \
                "Error: the managed-machine core is missing at $core; run brew reinstall managed-machine" \
                "Run: brew reinstall managed-machine" \
                failed "$(python3 -c 'import json,sys; print(json.dumps({"path": sys.argv[1]}))' "$core")"
        fi
        echo "Error: the managed-machine core is missing at $core; run brew reinstall managed-machine" >&2
        exit 1
    fi
    if [[ -z "${MANAGED_MACHINE_POLICY_DIR:-}" ]]; then
        local policy_dir="${CONFIG_REPO_ROOT:-${XDG_DATA_HOME:-$HOME/.local/share}/managed-machine/managed-machine-config}"
        if [[ -d "$policy_dir" ]]; then
            export MANAGED_MACHINE_POLICY_DIR="$policy_dir"
        fi
    fi
    exec "$core" "$@"
}

emit_legacy_deprecation() {
    local route="$1" replacement="$2"
    [[ -t 2 ]] || return 0
    printf "managed-machine: '%s' is a legacy route kept for compatibility until v0.11.0; use '%s' (see docs/plans/f01-caller-characterization.md)\n" \
        "$route" "$replacement" >&2
}

is_legacy_status_section() {
    case "$1" in
        managed-machine|machine|ssh|bootstrap|update|agent-accounts|local-bin|zsh-functions|pins|toolchain|homebrew|gh|nvm|node|hostname|rustup|rustc|cargo|catalog)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

maybe_deprecate_legacy_status() {
    [[ -t 2 ]] || return 0
    local has_section=0 sec=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                return 0
                ;;
            --section)
                has_section=1
                if [[ $# -ge 2 ]]; then
                    sec="$2"
                    shift 2
                else
                    return 0
                fi
                ;;
            --section=*)
                has_section=1
                sec="${1#--section=}"
                shift
                ;;
            --json)
                shift
                ;;
            *)
                return 0
                ;;
        esac
    done
    if [[ "$has_section" -eq 0 ]]; then
        emit_legacy_deprecation "status" "managed-machine status --section software|config|flavor|fleet"
    elif is_legacy_status_section "$sec"; then
        emit_legacy_deprecation "status --section $sec" "managed-machine status --section software|config|flavor|fleet"
    fi
}

main() {
    if is_new_core_route "$@"; then
        exec_new_core "$@"
    fi
    case "${1:-}" in
        --version)
            shift
            cmd_version "$@"
            ;;
        skill)
            shift
            if [[ "${1:-}" == "path" ]]; then
                emit_legacy_deprecation "skill path" "managed-machine skill"
            fi
            cmd_skill "$@"
            ;;
        --bootstrap)
            shift
            cmd_bootstrap "$@"
            ;;
        --update)
            if [[ $# -gt 1 ]]; then
                if cli_has_json_flag "$@"; then
                    cli_json_failure "update" "update-invalid-arguments" \
                        "Error: --update does not accept arguments" \
                        "Run: managed-machine --update"
                fi
                echo "Error: --update does not accept arguments" >&2
                exit 1
            fi
            cmd_update
            ;;
        status)
            shift
            maybe_deprecate_legacy_status "$@"
            cmd_status "$@"
            ;;
        setup)
            if [[ $# -eq 2 && ( "$2" == "--help" || "$2" == "-h" ) ]]; then
                setup_usage
            elif [[ $# -ge 2 && ( "$2" == "--list" || "$2" == "--json" ) ]]; then
                shift
                cmd_setup_list "$@"
            elif [[ $# -lt 2 ]]; then
                echo "Error: setup requires a script name" >&2
                print_setup_names refresh >&2
                exit 1
            else
                shift
                cmd_setup "$@"
            fi
            ;;
        catalog)
            shift
            cmd_catalog "$@"
            ;;
        fleet)
            shift
            if [[ "${1:-}" == "list" ]]; then
                emit_legacy_deprecation "fleet list" "managed-machine fleet --keys"
            fi
            cmd_fleet "$@"
            ;;
        adopt)
            shift
            cmd_adopt "$@"
            ;;
        add-agent)
            shift
            cmd_add_agent "$@"
            ;;
        account)
            shift
            cmd_account "$@"
            ;;
        ssh)
            shift
            cmd_ssh "$@"
            ;;
        # A bootstrap starts only from the explicit --bootstrap. The bare
        # command and help print usage; an unknown command fails with it.
        ""|--help|-h|help)
            if [[ $# -gt 1 ]]; then
                if cli_has_json_flag "$@"; then
                    cli_json_failure "help" "help-invalid-arguments" \
                        "Error: $1 does not accept arguments" \
                        "Run: managed-machine --help"
                fi
                echo "Error: $1 does not accept arguments" >&2
                usage >&2
                exit 1
            fi
            usage
            ;;
        *)
            if cli_has_json_flag "$@"; then
                cli_json_failure "managed-machine" "unknown-command" \
                    "Error: unknown command: $1" \
                    "Run: managed-machine --help" \
                    failed "$(python3 -c 'import json,sys; print(json.dumps({"command": sys.argv[1]}))' "$1")"
            fi
            echo "Error: unknown command: $1" >&2
            usage >&2
            exit 1
            ;;
    esac
}

main "$@"

