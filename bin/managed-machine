#!/usr/bin/env bash
# managed-machine CLI entry point.
# Resolves libexec whether installed by Homebrew or run from a git clone.
set -euo pipefail

# Resolve the managed-machine root: Homebrew libexec or repo root.
resolve_root() {
    local script_dir prefix
    script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

    # 1. Run from git clone: bin/ is one level under repo root. Prefer the
    # invoked checkout so development commands do not resolve an older brew
    # installation.
    if [[ -f "$script_dir/../lib/install.sh" ]]; then
        printf '%s\n' "$(cd "$script_dir/.." && pwd)"
        return
    fi

    # 2. Homebrew install: the formula installs files into
    #    $(brew --prefix)/opt/managed-machine/libexec.
    if [[ -n "${HOMEBREW_PREFIX:-}" ]]; then
        prefix="$HOMEBREW_PREFIX"
    elif command -v brew >/dev/null 2>&1; then
        prefix="$(brew --prefix)"
    fi
    if [[ -n "${prefix:-}" ]] && [[ -d "${prefix}/opt/managed-machine/libexec/lib" ]]; then
        printf '%s\n' "${prefix}/opt/managed-machine/libexec"
        return
    fi
    # 3. Detect common brew prefixes if HOMEBREW_PREFIX unset
    for p in /opt/homebrew /usr/local; do
        if [[ -d "${p}/opt/managed-machine/libexec/lib" ]]; then
            printf '%s\n' "${p}/opt/managed-machine/libexec"
            return
        fi
    done
    echo "Error: could not locate managed-machine libexec or repo root" >&2
    exit 1
}

ROOT="$(resolve_root)"

usage() {
    cat <<'EOF'
managed-machine - machine setup and orchestration

Usage:
  managed-machine              run full bootstrap (auto-detect terminal mode)
  managed-machine --bootstrap [--interactive|--non-interactive]
                               run full bootstrap in the selected mode
  managed-machine --update     brew update/upgrade + re-run safe setup steps
  managed-machine status       show installed versions and pins (read-only)
  managed-machine setup <name> [args]
                               run one setup script; name may be bin or setup-bin
  managed-machine adopt        adopt vendor-installed desktop apps into Homebrew
  managed-machine adopt <name> adopt one app (cask token or alias)
  managed-machine fleet list   list machines in the private fleet registry
  managed-machine fleet remove <machine-id> [--yes] [--revoke-github]
  managed-machine add-agent <slug> [--full-name <persona>] [--with-harness]
                               provision a per-harness agent account (ENG-0339);
                               --with-harness also runs account setup
  managed-machine add-agent --all [--with-harness]
                               provision every active roster account in order
  managed-machine account setup <active-existing-roster-account> [--json]
                               prepare this account's environment and selected harness
  managed-machine account doctor <account> [--json]
                               check live per-account readiness (read-only)
  managed-machine ssh enroll --authentication|--signing|--fleet
                               explicit human-only SSH enrollment (system
                               authorization dialog; agent accounts refused)
  managed-machine ssh status   report this account's SSH enrollment (read-only)
  managed-machine skill path   print the bundled agent skill and its source commit
  managed-machine --version    print the release version
  managed-machine --help       show this message
EOF
    print_setup_names
}

setup_names() {
    local script name
    {
        for script in "$ROOT"/setup-*; do
            [[ -f "$script" && -x "$script" ]] || continue
            name="${script##*/}"
            printf '%s\n' "${name#setup-}"
        done
        if [[ -f "$ROOT/lib/catalog.sh" && -f "$ROOT/lib/config-repo.sh" ]]; then
            # shellcheck source=lib/install.sh
            source "$ROOT/lib/install.sh"
            REPO_ROOT="$ROOT"
            catalog_app_names 2>/dev/null || true
        fi
    } | LC_ALL=C sort -u
}

# Best-effort pull-only refresh of the persistent config checkout (never over
# a dirty tree): the listing and setup resolution should see the catalog as
# merged, not as of the last setup-gh run. Offline or unresolvable checkouts
# are simply used as-is.
refresh_config_checkout() {
    declare -F managed_machine_config_repo_dir >/dev/null \
        && declare -F refresh_managed_machine_config_repo >/dev/null \
        || return 0
    local dir
    dir="$(managed_machine_config_repo_dir 2>/dev/null || true)"
    if [[ -n "$dir" ]]; then
        refresh_managed_machine_config_repo "$dir" || true
    fi
}

print_setup_names() {
    local name mark suffix row auto
    echo
    echo "Available setup names (✓ = already installed; bare and setup- prefixed forms are accepted):"
    if [[ -f "$ROOT/lib/install.sh" ]]; then
        # shellcheck source=lib/install.sh
        source "$ROOT/lib/install.sh"
        REPO_ROOT="$ROOT"
        refresh_config_checkout
    fi
    if [[ -f "$ROOT/lib/apps.sh" ]]; then
        # shellcheck source=lib/apps.sh
        source "$ROOT/lib/apps.sh"
        declare -F setup_list_prime >/dev/null && setup_list_prime
    fi
    while IFS= read -r name; do
        [[ -n "$name" ]] || continue
        mark=' '
        if declare -F setup_name_installed >/dev/null \
            && setup_name_installed "$ROOT" "$name"; then
            mark='✓'
        fi
        suffix=''
        if declare -F catalog_row_for >/dev/null; then
            if row="$(catalog_row_for "$name" 2>/dev/null)"; then
                IFS='|' read -r _ _ _ _ _ _ auto _ _ <<<"$row"
                [[ "$auto" == "0" ]] && suffix=' (setup only)'
            fi
        elif declare -F catalog_has_app >/dev/null && catalog_has_app "$name" \
            && ! catalog_app_is_auto "$name"; then
            suffix=' (setup only)'
        fi
        printf '  %s %s%s\n' "$mark" "$name" "$suffix"
    done < <(setup_names)
}

normalize_setup_name() {
    local name="${1#setup-}"
    if [[ ! "$name" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
        return 1
    fi
    printf '%s\n' "$name"
}

run_script() {
    local name="$1"
    shift
    local script="$ROOT/$name"
    if [[ ! -x "$script" ]]; then
        echo "Error: $script not found or not executable" >&2
        exit 1
    fi
    echo "==> $name"
    "$script" "$@"
}

cmd_bootstrap() {
    "$ROOT/scripts/bootstrap" "$@"
}

cmd_update() {
    "$ROOT/scripts/update"
}

cmd_setup() {
    local requested="$1"
    shift
    local name script
    if ! name="$(normalize_setup_name "$requested")"; then
        echo "Error: invalid setup name: $requested" >&2
        print_setup_names >&2
        return 1
    fi
    case "$name" in
        agent-bot|agent-bot-gh)
            echo "Error: setup $name is retired; managed-machine no longer installs, wires, or repairs agent-bot. Existing installations and credentials are left intact." >&2
            return 1
            ;;
    esac
    script="$ROOT/setup-$name"
    if [[ -f "$script" && -x "$script" ]]; then
        run_script "setup-$name" "$@"
        return 0
    fi
    if [[ $# -gt 0 ]]; then
        echo "Error: setup arguments are supported only by concrete setup scripts" >&2
        return 1
    fi
    if [[ -f "$ROOT/lib/apps.sh" ]]; then
        # shellcheck source=lib/install.sh
        source "$ROOT/lib/install.sh"
        # shellcheck source=lib/bootstrap.sh
        source "$ROOT/lib/bootstrap.sh"
        # shellcheck source=lib/apps.sh
        source "$ROOT/lib/apps.sh"
        REPO_ROOT="$ROOT"
        CONFIG_REPO_ROOT="$(managed_machine_config_repo_dir)"
        # Resolve against the catalog as merged — a stale checkout must not
        # report a row that only just landed upstream as unknown.
        refresh_config_checkout
        if catalog_has_app "$name"; then
            echo "==> setup-$name"
            install_catalog_app "$name"
            return
        fi
    fi
    echo "Error: unknown setup name: $requested" >&2
    print_setup_names >&2
    return 1
}

cmd_status() {
    "$ROOT/scripts/status" "$@"
}

cmd_fleet() {
    "$ROOT/scripts/fleet" "$@"
}

cmd_adopt() {
    "$ROOT/scripts/adopt" "$@"
}

cmd_add_agent() {
    "$ROOT/scripts/add-agent" "$@"
}

cmd_account() {
    "$ROOT/scripts/account" "$@"
}

cmd_ssh() {
    "$ROOT/scripts/ssh" "$@"
}

# Source commit of this tree: git in a checkout, else the RELEASE_COMMIT the
# formula writes into libexec.
release_commit() {
    local sha=""
    if [[ -e "$ROOT/.git" ]]; then
        sha="$(git -C "$ROOT" rev-parse HEAD 2>/dev/null || true)"
    fi
    if [[ ! "$sha" =~ ^[0-9a-f]{40}$ && -f "$ROOT/RELEASE_COMMIT" ]]; then
        sha="$(tr -d '[:space:]' <"$ROOT/RELEASE_COMMIT")"
    fi
    [[ "$sha" =~ ^[0-9a-f]{40}$ ]] && printf '%s\n' "$sha" || printf 'unknown\n'
}

# ENG-0055: --version and skill path read only this tree. They are matched
# before any path that sources lib/ or refreshes the config checkout.
cmd_version() {
    [[ $# -eq 0 ]] || { echo "Error: --version does not accept arguments" >&2; exit 1; }
    [[ -f "$ROOT/VERSION" ]] || { echo "Error: no VERSION in $ROOT" >&2; exit 1; }
    tr -d '[:space:]' <"$ROOT/VERSION"
    printf '\n'
}

cmd_skill() {
    [[ "${1:-}" == "path" && $# -eq 1 ]] || { echo "Error: usage: managed-machine skill path" >&2; exit 1; }
    [[ -f "$ROOT/skills/managed-machine/SKILL.md" ]] \
        || { echo "Error: no skill bundle at $ROOT/skills/managed-machine" >&2; exit 1; }
    printf '%s\ncommit %s\n' "$ROOT/skills/managed-machine" "$(release_commit)"
}

main() {
    case "${1:-}" in
        --version)
            shift
            cmd_version "$@"
            ;;
        skill)
            shift
            cmd_skill "$@"
            ;;
        "")
            cmd_bootstrap
            ;;
        --bootstrap)
            shift
            cmd_bootstrap "$@"
            ;;
        --update)
            cmd_update
            ;;
        status)
            shift
            cmd_status "$@"
            ;;
        setup)
            if [[ $# -eq 2 && ( "$2" == "--help" || "$2" == "-h" ) ]]; then
                usage
            elif [[ $# -lt 2 ]]; then
                echo "Error: setup requires a script name" >&2
                print_setup_names >&2
                exit 1
            else
                shift
                cmd_setup "$@"
            fi
            ;;
        fleet)
            shift
            cmd_fleet "$@"
            ;;
        adopt)
            shift
            cmd_adopt "$@"
            ;;
        add-agent)
            shift
            cmd_add_agent "$@"
            ;;
        account)
            shift
            cmd_account "$@"
            ;;
        ssh)
            shift
            cmd_ssh "$@"
            ;;
        --help|-h)
            usage
            ;;
        *)
            echo "Error: unknown command: $1" >&2
            usage
            exit 1
            ;;
    esac
}

main "$@"
