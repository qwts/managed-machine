#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=lib/install.sh
source "$REPO_ROOT/lib/install.sh"

ensure_cargo_bin_in_zshrc "${HOME}/.zshrc"
export_cargo_bin_to_path

# Prefer cargo env if present (covers rustup's own PATH wiring).
cargo_env="$(cargo_env_file)"
if [[ -f "$cargo_env" ]]; then
    # shellcheck source=/dev/null
    source "$cargo_env"
fi

# Homebrew's current rustup formula keeps the real binaries in
# $(brew --prefix)/opt/rustup/bin; the wrappers in $(brew --prefix)/bin strip
# argv[0], which breaks the rustup multiplexer when a cargo proxy links to
# them. Use the opt path directly when it exists.
rustup_brew_bin_dir() {
    local prefix
    for prefix in "${HOMEBREW_PREFIX:-}" /opt/homebrew /usr/local; do
        [[ -n "$prefix" && -x "$prefix/opt/rustup/bin/rustup" ]] || continue
        printf '%s/opt/rustup/bin\n' "$prefix"
        return 0
    done
    return 1
}

if brew_rustup_dir="$(rustup_brew_bin_dir)"; then
    export PATH="$brew_rustup_dir:$PATH"
    echo "Using Homebrew rustup wrappers: $brew_rustup_dir"
fi

# Remove cargo-bin proxy symlinks that can never work: targets that no longer
# exist (e.g. the removed rustup-init), or Homebrew's argv[0]-stripping
# wrappers, which make legacy rustc/cargo links invoke the rustup manager
# instead of the compiler. `rustup default` recreates healthy proxies.
repair_cargo_bin_proxies() {
    local bin_dir link target tool
    bin_dir="$(cargo_bin_dir)"
    [[ -d "$bin_dir" ]] || return 0
    for link in "$bin_dir"/*; do
        [[ -L "$link" ]] || continue
        tool="$(basename "$link")"
        target="$(readlink "$link")"
        if [[ ! -e "$link" ]]; then
            echo "removing broken cargo proxy: $tool -> $target"
        elif [[ "$target" == *rustup-init* ]]; then
            echo "removing stale rustup-init proxy: $tool -> $target"
        elif [[ "$target" == */opt/homebrew/bin/rustup || "$target" == */usr/local/bin/rustup ]] \
            || [[ -n "${HOMEBREW_PREFIX:-}" && "$target" == "${HOMEBREW_PREFIX}/bin/rustup" ]]; then
            echo "removing argv[0]-stripping wrapper proxy: $tool -> $target"
        else
            continue
        fi
        rm -f "$link"
    done
}

ensure_default_toolchain() {
    # Profile governs components for new toolchains; component add converges
    # existing installs that were created under the minimal profile.
    rustup set profile default
    rustup default stable
    rustup component add rustfmt clippy
}

# The old failure mode printed "rustc: command not found" but exited zero.
# Setup only succeeds when the tools it claims to install actually run.
validate_toolchain() {
    local tool status=0
    for tool in rustc cargo rustfmt cargo-clippy; do
        if ! command -v "$tool" >/dev/null 2>&1; then
            echo "Error: $tool not found on PATH after setup" >&2
            status=1
        elif ! "$tool" --version >/dev/null 2>&1; then
            echo "Error: $tool --version failed (broken proxy or missing toolchain)" >&2
            status=1
        fi
    done
    return "$status"
}

report_toolchain() {
    echo "rustup: $(command -v rustup)"
    rustup show
    echo "rustc: $(command -v rustc) ($(rustc --version))"
    echo "cargo: $(command -v cargo) ($(cargo --version))"
}

repair_cargo_bin_proxies
hash -r

if command -v rustup >/dev/null 2>&1; then
    echo "rustup already installed: $(command -v rustup)"
    ensure_default_toolchain
    hash -r
    validate_toolchain
    report_toolchain
    exit 0
fi

echo "Installing Rust via rustup..."
curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y

export_cargo_bin_to_path
cargo_env="$(cargo_env_file)"
if [[ -f "$cargo_env" ]]; then
    # shellcheck source=/dev/null
    source "$cargo_env"
fi

if ! command -v rustup >/dev/null 2>&1; then
    echo "Install finished but rustup not found on PATH." >&2
    echo "Open a new shell or: export PATH=\"$(cargo_bin_dir):\$PATH\"" >&2
    exit 1
fi

ensure_default_toolchain
hash -r
validate_toolchain
echo "Rust installed."
report_toolchain
