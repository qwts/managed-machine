#!/usr/bin/env bash
# Ensure local-bin is cloned at the pinned ref and its tools are linked.
#
# managed-machine consumes local-bin as a package: it keeps the repo in the
# managed-machine libexec directory (or a sibling repo in development), checks
# out the ref recorded in local-bin.ref, then runs local-bin's own install
# script to symlink tools into ~/.local/bin and prune renames.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=lib/install.sh
source "$REPO_ROOT/lib/install.sh"

CONFIG_REPO_ROOT="$(managed_machine_config_repo_dir)"

# In a Homebrew install local-bin lives next to the setup scripts under
# libexec/local-bin. In a git clone it lives as a sibling repo. Override with
# LOCAL_BIN_DIR or the legacy HOME_BIN_DIR if needed.
if [[ -z "${LOCAL_BIN_DIR:-}${HOME_BIN_DIR:-}" ]]; then
    if [[ -d "$REPO_ROOT/managed-machine-config" ]]; then
        LOCAL_BIN_DIR="$REPO_ROOT/local-bin"
    else
        LOCAL_BIN_DIR="$REPO_ROOT/../local-bin"
    fi
fi

LOCAL_BIN_REPO="${LOCAL_BIN_REPO:-${HOME_BIN_REPO:-https://github.com/qwts/local-bin.git}}"
LOCAL_BIN_DIR="${LOCAL_BIN_DIR:-${HOME_BIN_DIR:-}}"

# Ensure the legacy ~/.bin default is never used.
if [[ -z "$LOCAL_BIN_DIR" ]]; then
    echo "Error: could not determine LOCAL_BIN_DIR" >&2
    exit 1
fi

REF_FILE="$CONFIG_REPO_ROOT/local-bin.ref"

if [[ ! -f "$REF_FILE" ]]; then
    echo "Error: missing pin file $REF_FILE" >&2
    exit 1
fi

# LOCAL_BIN_REF overrides the pin; otherwise read the first non-comment line.
if [[ -n "${LOCAL_BIN_REF:-}" ]]; then
    ref="$LOCAL_BIN_REF"
elif [[ -n "${HOME_BIN_REF:-}" ]]; then
    ref="$HOME_BIN_REF"
else
    ref="$(grep -vE '^[[:space:]]*#' "$REF_FILE" | grep -vE '^[[:space:]]*$' | head -1 | tr -d '[:space:]')"
    if [[ -z "$ref" ]]; then
        echo "Error: no ref found in $REF_FILE" >&2
        exit 1
    fi
fi

echo "local-bin pin: $ref"

ref_is_sha() {
    [[ "$1" =~ ^[0-9a-f]{7,40}$ ]]
}

# Machine setup must be reproducible: the pin has to name an immutable ref (a
# tag or commit SHA). A moving branch makes every bootstrap fetch whatever
# that branch points at today and is rejected unless explicitly overridden.
reject_branch_pin() {
    if [[ "${MANAGED_MACHINE_ALLOW_BRANCH_PIN:-}" == "1" ]]; then
        echo "warning: '$ref' is a moving branch — this machine's local-bin is not reproducible (MANAGED_MACHINE_ALLOW_BRANCH_PIN=1)" >&2
        return 0
    fi
    cat >&2 <<EOF
Error: local-bin pin '$ref' is a moving branch, not an immutable ref.
Pin a tag or commit SHA in $REF_FILE (e.g. v0.1.0), or override once with:

  MANAGED_MACHINE_ALLOW_BRANCH_PIN=1 managed-machine setup bin
EOF
    exit 1
}

# Record the pin and the exact commit it resolved to, so every bootstrap has
# a machine-readable record of what actually ran. Never committed.
record_local_bin_pin() {
    local resolved="$1"
    local state_dir manifest tmp
    state_dir="$(managed_machine_config_dir)"
    manifest="$state_dir/local-bin.manifest"
    mkdir -p "$state_dir"
    chmod 700 "$state_dir"
    tmp="$(mktemp "${manifest}.XXXXXX")"
    chmod 600 "$tmp"
    {
        echo 'schema_version=1'
        printf 'ref=%s\n' "$ref"
        printf 'commit=%s\n' "$resolved"
        printf 'recorded_at=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    } >"$tmp"
    mv "$tmp" "$manifest"
    echo "local-bin pin recorded: $manifest (commit ${resolved:-unknown})"
}

# Clone only if the repo is missing. If the formula already installed it as a
# bundled git repo, or if the directory exists but is not a git repo (e.g. a
# resource archive), we use it as-is and only run git operations when .git
# exists.
if [[ ! -d "$LOCAL_BIN_DIR" ]]; then
    echo "Cloning local-bin into $LOCAL_BIN_DIR..."
    mkdir -p "$(dirname "$LOCAL_BIN_DIR")"
    git clone "$LOCAL_BIN_REPO" "$LOCAL_BIN_DIR"
fi

if [[ ! -d "$LOCAL_BIN_DIR" ]]; then
    echo "Error: local-bin directory not found at $LOCAL_BIN_DIR" >&2
    exit 1
fi

cd "$LOCAL_BIN_DIR"
LOCAL_BIN_DIR="$(pwd -P)"

# Homebrew libexec/local-bin is prefix-owned. Git 2.35+ refuses that from a
# non-owner; trust the path for these commands only (same as the config seed).
local_bin_git() {
    config_repo_git "$LOCAL_BIN_DIR" "$@"
}

if [[ -e ".git" ]]; then
    head="$(local_bin_git rev-parse HEAD 2>/dev/null || true)"

    # Skip the network round-trip when the immutable pin is already checked
    # out: an existing local tag or SHA cannot move, so fetching adds nothing.
    satisfied=""
    if local_bin_git rev-parse --verify --quiet "refs/tags/$ref" >/dev/null \
        && [[ "$(local_bin_git rev-parse --verify "refs/tags/${ref}^{commit}")" == "$head" ]]; then
        satisfied=1
    elif ref_is_sha "$ref" \
        && resolved="$(local_bin_git rev-parse --verify --quiet "${ref}^{commit}")" \
        && [[ "$resolved" == "$head" ]]; then
        satisfied=1
    fi

    if [[ -n "$satisfied" ]]; then
        echo "local-bin already at pin $ref — skipping fetch"
    else
        echo "Fetching local-bin..."
        local_bin_git fetch --tags --quiet

        if local_bin_git rev-parse --verify --quiet "refs/tags/$ref" >/dev/null; then
            local_bin_git checkout --quiet "refs/tags/$ref"
        elif ref_is_sha "$ref" && local_bin_git rev-parse --verify --quiet "${ref}^{commit}" >/dev/null; then
            local_bin_git checkout --quiet "$ref"
        elif local_bin_git rev-parse --verify --quiet "refs/remotes/origin/$ref" >/dev/null \
            || local_bin_git rev-parse --verify --quiet "refs/heads/$ref" >/dev/null; then
            reject_branch_pin
            # Explicit override: converge the branch checkout to its head.
            local_bin_git checkout --quiet "$ref"
            if local_bin_git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' >/dev/null 2>&1; then
                local_bin_git pull --ff-only --quiet
            fi
        else
            echo "Error: local-bin pin '$ref' does not resolve to a tag, commit, or branch" >&2
            exit 1
        fi
    fi

    resolved_commit="$(local_bin_git rev-parse HEAD)"
    echo "Checked out: $(local_bin_git describe --tags --always 2>/dev/null || local_bin_git rev-parse --short HEAD) ($resolved_commit)"
    record_local_bin_pin "$resolved_commit"
else
    # Resource archives have no git metadata; record the pin without a commit.
    record_local_bin_pin ""
fi

# Run local-bin's own installer to link tools and prune renames.
if [[ ! -x "$LOCAL_BIN_DIR/install" ]]; then
    echo "Error: $LOCAL_BIN_DIR/install not found or not executable" >&2
    exit 1
fi

exec "$LOCAL_BIN_DIR/install"
