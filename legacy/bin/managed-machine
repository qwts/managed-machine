#!/usr/bin/env bash
# managed-machine legacy Bash entry point (invoked by the Go core on macOS).
set -euo pipefail

# Resolve the legacy tree root relative to this entry point.
resolve_root() {
    local script_dir
    script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

    if [[ -f "$script_dir/../lib/install.sh" ]]; then
        printf '%s\n' "$(cd "$script_dir/.." && pwd)"
        return
    fi

    echo "Error: could not locate managed-machine legacy tree root" >&2
    exit 1
}

ROOT="$(resolve_root)"

cli_has_json_flag() {
    local arg
    for arg in "$@"; do
        [[ "$arg" == "--json" ]] && return 0
    done
    return 1
}

cli_json_failure() {
    local command="$1" code="$2" message="$3" action="$4" status="${5:-failed}" evidence_json="${6:-}"
    python3 - "$command" "$code" "$message" "$action" "$status" "$evidence_json" <<'PY'
import json, os, sys
command, code, message, action, status, evidence_raw = sys.argv[1:]
try:
    evidence = json.loads(evidence_raw) if evidence_raw else {}
except Exception:
    evidence = {}
check_id = command.replace("-", ".") + ".preflight"
top_status = "pending_user_action" if status == "pending_user_action" else "not_ready"
check_status = "pending_user_action" if status == "pending_user_action" else "failed"
entry = {
    "id": check_id,
    "status": check_status,
    "code": code,
    "message": message,
    "action": action,
    "evidence": evidence,
}
report = {
    "schema_version": 1,
    "command": command,
    "ready": False,
    "status": top_status,
    "error": {
        "code": code,
        "message": message,
        "action": action,
        "evidence": evidence,
    },
    "checks": [entry],
}
try:
    print(json.dumps(report, indent=2))
    sys.stdout.flush()
except BrokenPipeError:
    devnull = os.open(os.devnull, os.O_WRONLY)
    os.dup2(devnull, sys.stdout.fileno())
    sys.exit(0)
PY
    [[ "$status" != pending_user_action ]] || return 75
    return 1
}

setup_names() {
    local script name
    {
        for script in "$ROOT"/setup-*; do
            [[ -f "$script" && -x "$script" ]] || continue
            name="${script##*/}"
            printf '%s\n' "${name#setup-}"
        done
        if [[ -f "$ROOT/lib/catalog.sh" && -f "$ROOT/lib/config-repo.sh" ]]; then
            # shellcheck source=lib/install.sh
            source "$ROOT/lib/install.sh"
            REPO_ROOT="$ROOT"
            catalog_app_names 2>/dev/null || true
        fi
    } | LC_ALL=C sort -u
}

# Best-effort pull-only refresh of the persistent config checkout (never over
# a dirty tree): the listing and setup resolution should see the catalog as
# merged, not as of the last setup-gh run. Offline or unresolvable checkouts
# are simply used as-is.
refresh_config_checkout() {
    declare -F managed_machine_config_repo_dir >/dev/null \
        && declare -F refresh_managed_machine_config_repo >/dev/null \
        || return 0
    local dir
    dir="$(managed_machine_config_repo_dir 2>/dev/null || true)"
    if [[ -n "$dir" ]]; then
        refresh_managed_machine_config_repo "$dir" || true
    fi
}

# Help lists setup names from the config checkout as it is on disk, with no
# install probes (brew and npm write their own caches and logs), so help
# changes nothing (qwts/managed-machine#173). The setup command passes
# "refresh": it pulls merged catalog rows first and marks installed names.
print_setup_names() {
    local refresh="${1:-}"
    local name mark suffix row auto
    echo
    if [[ "$refresh" == refresh ]]; then
        echo "Available setup names (✓ = already installed; bare and setup- prefixed forms are accepted):"
    else
        echo "Available setup names (bare and setup- prefixed forms are accepted; managed-machine setup marks installed ones):"
    fi
    if [[ -f "$ROOT/lib/install.sh" ]]; then
        # shellcheck source=lib/install.sh
        source "$ROOT/lib/install.sh"
        REPO_ROOT="$ROOT"
        if [[ "$refresh" == refresh ]]; then
            refresh_config_checkout
        fi
    fi
    if [[ -f "$ROOT/lib/apps.sh" ]]; then
        # shellcheck source=lib/apps.sh
        source "$ROOT/lib/apps.sh"
        if [[ "$refresh" == refresh ]]; then
            declare -F setup_list_prime >/dev/null && setup_list_prime
        fi
    fi
    while IFS= read -r name; do
        [[ -n "$name" ]] || continue
        mark=' '
        if [[ "$refresh" == refresh ]] && declare -F setup_name_installed >/dev/null \
            && setup_name_installed "$ROOT" "$name"; then
            mark='✓'
        fi
        suffix=''
        if declare -F catalog_row_for >/dev/null; then
            if row="$(catalog_row_for "$name" 2>/dev/null)"; then
                IFS='|' read -r _ _ _ _ _ _ auto _ _ <<<"$row"
                [[ "$auto" == "0" ]] && suffix=' (setup only)'
            fi
        elif declare -F catalog_has_app >/dev/null && catalog_has_app "$name" \
            && ! catalog_app_is_auto "$name"; then
            suffix=' (setup only)'
        fi
        printf '  %s %s%s\n' "$mark" "$name" "$suffix"
    done < <(setup_names)
}

print_setup_names_json() {
    trap 'exit 0' PIPE
    local name installed declined has_script in_catalog auto kind row rows_file provenance="{}"
    if [[ -f "$ROOT/lib/install.sh" ]]; then
        # shellcheck source=lib/install.sh
        source "$ROOT/lib/install.sh"
        REPO_ROOT="$ROOT"
        refresh_config_checkout >/dev/null 2>&1 || true
    fi
    if [[ -f "$ROOT/lib/apps.sh" ]]; then
        # shellcheck source=lib/apps.sh
        source "$ROOT/lib/apps.sh"
        declare -F setup_list_prime >/dev/null && setup_list_prime >/dev/null 2>&1 || true
    fi
    if declare -F config_repo_provenance_json >/dev/null; then
        provenance="$(config_repo_provenance_json "" 2>/dev/null || printf '{}')"
    fi
    rows_file="$(mktemp)"
    # shellcheck disable=SC2064
    trap "rm -f '$rows_file'" RETURN
    while IFS= read -r name; do
        [[ -n "$name" ]] || continue
        installed=0
        if declare -F setup_name_installed >/dev/null && setup_name_installed "$ROOT" "$name"; then
            installed=1
        fi
        declined=0
        if declare -F declined_app_is_recorded >/dev/null && declined_app_is_recorded "$name" 2>/dev/null; then
            declined=1
        fi
        has_script=0
        [[ -f "$ROOT/setup-$name" && -x "$ROOT/setup-$name" ]] && has_script=1
        in_catalog=0
        auto=1
        kind="script"
        if declare -F catalog_row_for >/dev/null && row="$(catalog_row_for "$name" 2>/dev/null)"; then
            IFS='|' read -r kind _ _ _ _ _ auto _ _ <<<"$row"
            in_catalog=1
        elif declare -F catalog_has_app >/dev/null && catalog_has_app "$name"; then
            in_catalog=1
            kind="$(catalog_app_kind "$name" 2>/dev/null || printf 'catalog')"
            if ! catalog_app_is_auto "$name" 2>/dev/null; then
                auto=0
            fi
        fi
        printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$name" "$installed" "$declined" "$auto" "$kind" "$has_script" "$in_catalog" >>"$rows_file"
    done < <(setup_names)
    python3 - "$rows_file" "$provenance" <<'PY'
import json, os, sys
rows_file = sys.argv[1]
try:
    config_checkout = json.loads(sys.argv[2]) if len(sys.argv) > 2 and sys.argv[2] else {}
except Exception:
    config_checkout = {}
names = []
with open(rows_file, encoding="utf-8", errors="replace") as handle:
    for raw in handle:
        line = raw.rstrip("\r\n")
        if not line:
            continue
        name, installed, declined, auto, kind, has_script, in_catalog = line.split("\t")
        names.append({
            "name": name,
            "prefixed_name": "setup-" + name,
            "installed": installed == "1",
            "declined": declined == "1",
            "auto": auto == "1",
            "kind": kind,
            "has_script": has_script == "1",
            "in_catalog": in_catalog == "1",
        })
report = {
    "schema_version": 1,
    "command": "setup-list",
    "ready": True,
    "status": "ready",
    "config_checkout": config_checkout,
    "names": names,
}
try:
    print(json.dumps(report, indent=2))
    sys.stdout.flush()
except BrokenPipeError:
    devnull = os.open(os.devnull, os.O_WRONLY)
    os.dup2(devnull, sys.stdout.fileno())
    sys.exit(0)
PY
}

normalize_setup_name() {
    local name="${1#setup-}"
    if [[ ! "$name" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
        return 1
    fi
    printf '%s\n' "$name"
}

run_script() {
    local name="$1"
    shift
    local script="$ROOT/$name"
    if [[ ! -x "$script" ]]; then
        echo "Error: $script not found or not executable" >&2
        exit 1
    fi
    echo "==> $name"
    "$script" "$@"
}

cmd_bootstrap() {
    "$ROOT/scripts/bootstrap" "$@"
}

cmd_update() {
    "$ROOT/scripts/update"
}

cmd_setup_list() {
    local json=0
    if cli_has_json_flag "$@"; then json=1; fi
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --list) ;;
            --json) json=1 ;;
            *)
                if [[ "$json" == 1 ]]; then
                    cli_json_failure "setup-list" "setup-invalid-arguments" \
                        "Error: unknown setup --list option: $1" \
                        "Run: managed-machine setup --list [--json]"
                    return 1
                fi
                echo "Error: unknown setup --list option: $1" >&2
                return 1
                ;;
        esac
        shift
    done
    trap 'exit 0' PIPE
    if [[ "$json" == 1 ]]; then
        print_setup_names_json
    else
        print_setup_names refresh
    fi
}

cmd_setup() {
    local requested="$1"
    shift
    local name script json=0 arg
    local -a extra_args=()
    for arg in "$@"; do
        if [[ "$arg" == "--json" ]]; then
            json=1
        else
            extra_args+=("$arg")
        fi
    done
    if ! name="$(normalize_setup_name "$requested")"; then
        if [[ "$json" == 1 ]]; then
            if [[ -f "$ROOT/lib/install.sh" ]]; then
                # shellcheck source=lib/install.sh
                source "$ROOT/lib/install.sh"
                REPO_ROOT="$ROOT"
                refresh_config_checkout >/dev/null 2>&1 || true
            fi
            cli_json_failure "setup" "setup-name-invalid" \
                "Error: invalid setup name: $requested" \
                "Run managed-machine setup --list --json to inspect available setup names." \
                failed "$(python3 -c 'import json,sys; print(json.dumps({"requested": sys.argv[1]}))' "$requested")"
            return 1
        fi
        echo "Error: invalid setup name: $requested" >&2
        print_setup_names refresh >&2
        return 1
    fi
    case "$name" in
        agent-bot|agent-bot-gh)
            if [[ "$json" == 1 ]]; then
                cli_json_failure "setup" "setup-name-retired" \
                    "Error: setup $name is retired; managed-machine no longer installs, wires, or repairs agent-bot. Existing installations and credentials are left intact." \
                    "Manage agent-bot through GeniusBar or the agent-bot CLI directly." \
                    failed "$(python3 -c 'import json,sys; print(json.dumps({"name": sys.argv[1]}))' "$name")"
                return 1
            fi
            echo "Error: setup $name is retired; managed-machine no longer installs, wires, or repairs agent-bot. Existing installations and credentials are left intact." >&2
            return 1
            ;;
    esac
    script="$ROOT/setup-$name"
    if [[ -f "$script" && -x "$script" ]]; then
        run_script "setup-$name" "$@"
        return 0
    fi
    if [[ ${#extra_args[@]} -gt 0 ]]; then
        if [[ "$json" == 1 ]]; then
            cli_json_failure "setup" "setup-arguments-unsupported" \
                "Error: setup arguments are supported only by concrete setup scripts" \
                "Run: managed-machine setup $name" \
                failed "$(python3 -c 'import json,sys; print(json.dumps({"name": sys.argv[1]}))' "$name")"
            return 1
        fi
        echo "Error: setup arguments are supported only by concrete setup scripts" >&2
        return 1
    fi
    if [[ -f "$ROOT/lib/apps.sh" ]]; then
        # shellcheck source=lib/install.sh
        source "$ROOT/lib/install.sh"
        # shellcheck source=lib/bootstrap.sh
        source "$ROOT/lib/bootstrap.sh"
        # shellcheck source=lib/apps.sh
        source "$ROOT/lib/apps.sh"
        REPO_ROOT="$ROOT"
        CONFIG_REPO_ROOT="$(managed_machine_config_repo_dir)"
        # Resolve against the catalog as merged — a stale checkout must not
        # report a row that only just landed upstream as unknown.
        if [[ "$json" == 1 ]]; then
            refresh_config_checkout >/dev/null 2>&1 || true
        else
            refresh_config_checkout
        fi
        if catalog_has_app "$name"; then
            if [[ "$json" == 1 ]]; then
                cli_json_failure "setup" "setup-arguments-unsupported" \
                    "Error: setup arguments are supported only by concrete setup scripts" \
                    "Run: managed-machine setup $name" \
                    failed "$(python3 -c 'import json,sys; print(json.dumps({"name": sys.argv[1]}))' "$name")"
                return 1
            fi
            echo "==> setup-$name"
            install_catalog_app "$name"
            return
        fi
    fi
    if [[ "$json" == 1 ]]; then
        if [[ -f "$ROOT/lib/install.sh" ]]; then
            # shellcheck source=lib/install.sh
            source "$ROOT/lib/install.sh"
            REPO_ROOT="$ROOT"
            refresh_config_checkout >/dev/null 2>&1 || true
        fi
        cli_json_failure "setup" "setup-name-unknown" \
            "Error: unknown setup name: $requested" \
            "Run managed-machine setup --list --json to inspect available setup names." \
            failed "$(python3 -c 'import json,sys; print(json.dumps({"requested": sys.argv[1]}))' "$requested")"
        return 1
    fi
    echo "Error: unknown setup name: $requested" >&2
    print_setup_names refresh >&2
    return 1
}

cmd_status() {
    "$ROOT/scripts/status" "$@"
}

cmd_catalog() {
    "$ROOT/scripts/catalog" "$@"
}

cmd_fleet() {
    "$ROOT/scripts/fleet" "$@"
}

cmd_adopt() {
    "$ROOT/scripts/adopt" "$@"
}

cmd_add_agent() {
    "$ROOT/scripts/add-agent" "$@"
}

cmd_account() {
    "$ROOT/scripts/account" "$@"
}

cmd_ssh() {
    "$ROOT/scripts/ssh" "$@"
}

is_kept_legacy_status_section() {
    local count=0 section=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --section)
                if [[ $# -lt 2 || "$2" == -* ]]; then
                    return 1
                fi
                count=$((count + 1))
                section="$2"
                shift 2
                ;;
            --section=*)
                count=$((count + 1))
                section="${1#--section=}"
                shift
                ;;
            --json)
                shift
                ;;
            *)
                return 1
                ;;
        esac
    done
    [[ "$count" -eq 1 ]] && [[ "$section" == "bootstrap" || "$section" == "update" ]]
}

main() {
    case "${1:-}" in
        --bootstrap)
            shift
            cmd_bootstrap "$@"
            ;;
        --update)
            if [[ $# -gt 1 ]]; then
                if cli_has_json_flag "$@"; then
                    cli_json_failure "update" "update-invalid-arguments" \
                        "Error: --update does not accept arguments" \
                        "Run: managed-machine --update"
                fi
                echo "Error: --update does not accept arguments" >&2
                exit 1
            fi
            cmd_update
            ;;
        status)
            shift
            if is_kept_legacy_status_section "$@"; then
                cmd_status "$@"
            else
                echo "Error: internal error: non-legacy route reached legacy entry: status${1:+ $*}" >&2
                exit 2
            fi
            ;;
        setup)
            if [[ $# -eq 2 && ( "$2" == "--help" || "$2" == "-h" ) ]]; then
                echo "Error: internal error: non-legacy route reached legacy entry: setup $2" >&2
                exit 2
            elif [[ $# -ge 2 && ( "$2" == "--list" || "$2" == "--json" ) ]]; then
                shift
                cmd_setup_list "$@"
            elif [[ $# -lt 2 ]]; then
                echo "Error: setup requires a script name" >&2
                print_setup_names refresh >&2
                exit 1
            else
                shift
                cmd_setup "$@"
            fi
            ;;
        catalog)
            shift
            cmd_catalog "$@"
            ;;
        fleet)
            shift
            cmd_fleet "$@"
            ;;
        adopt)
            shift
            cmd_adopt "$@"
            ;;
        add-agent)
            shift
            cmd_add_agent "$@"
            ;;
        account)
            shift
            cmd_account "$@"
            ;;
        ssh)
            shift
            cmd_ssh "$@"
            ;;
        *)
            echo "Error: internal error: non-legacy route reached legacy entry: ${1:-<empty>}" >&2
            exit 2
            ;;
    esac
}

main "$@"

